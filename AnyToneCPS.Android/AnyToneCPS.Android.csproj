<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <Version>0.1.3</Version>
        <ApplicationId>com.companyname.anytonecps</ApplicationId>
        <ApplicationVersion>7</ApplicationVersion>
        <ApplicationDisplayVersion>0.1.3</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-arm64</RuntimeIdentifier>
    </PropertyGroup>

    <!-- Not distributed via Google Play - this signs the APK itself (not an
         AAB) with a release key dedicated to this app, so a sideloaded
         install can be upgraded in place instead of needing an uninstall
         each release. Two distinct password files (same content) rather
         than one shared by both properties, since apksigner's APK signing
         path (unlike the AAB path the other two apps use) reads a file:
         password source as a single-consume stream - pointing both
         AndroidSigningKeyPass and AndroidSigningStorePass at the same file
         fails the second read with "end of file reached", confirmed live
         with a direct apksigner invocation 2026-08-28. -->
    <PropertyGroup Condition="$(TargetFramework.Contains('-android')) and '$(Configuration)' == 'Release'">
        <AndroidKeyStore>true</AndroidKeyStore>
        <AndroidSigningKeyStore>/home/tobbe/.android/anytonecps-release-keystore.jks</AndroidSigningKeyStore>
        <AndroidSigningKeyAlias>release</AndroidSigningKeyAlias>
        <AndroidSigningKeyPass>file:/home/tobbe/.android/AnyToneCpsSigningKeyPassword</AndroidSigningKeyPass>
        <AndroidSigningStorePass>file:/home/tobbe/.android/AnyToneCpsSigningPassword</AndroidSigningStorePass>
    </PropertyGroup>

    <ItemGroup>
        <AndroidResource Include="Icon.png">
            <Link>Resources\drawable\icon.png</Link>
        </AndroidResource>
    </ItemGroup>

    <ItemGroup Condition="'$(PublishAot)' == 'true'">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>AnyToneCPS.BuildMode</_Parameter1>
            <_Parameter2>NativeAOT</_Parameter2>
        </AssemblyAttribute>
        <!-- See ..\AnyToneCPS\TrimmerRoots.xml's own comment - preserves
             AnyToneCPS.Models from trimming, real crash found on Desktop
             2026-08-17 (same reflection pattern is latent on Android too,
             even though it hadn't crashed there yet). -->
        <TrimmerRootDescriptor Include="..\AnyToneCPS\TrimmerRoots.xml"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android"/>
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AnyToneCPS\AnyToneCPS.csproj"/>
    </ItemGroup>
</Project>
