<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-android</TargetFramework>
        <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <Version>0.1.3</Version>
        <ApplicationId>se.cloudsite.anytonecps</ApplicationId>
        <ApplicationVersion>8</ApplicationVersion>
        <ApplicationDisplayVersion>0.1.3</ApplicationDisplayVersion>
        <AndroidPackageFormat>aab</AndroidPackageFormat>
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">android-arm64</RuntimeIdentifier>
    </PropertyGroup>

    <!-- Real signing config lives in the gitignored signing.local.props,
         not here - see AnyToneCPS.Android/signing.local.props.example.
         Public repo, so no personal machine paths belong in tracked files;
         also means a fresh clone's Release build just falls back to debug
         signing instead of failing outright on a missing local path. -->
    <Import Project="signing.local.props" Condition="Exists('signing.local.props')" />

    <ItemGroup>
        <AndroidResource Include="Icon.png">
            <Link>Resources\drawable\icon.png</Link>
        </AndroidResource>
    </ItemGroup>

    <ItemGroup Condition="'$(PublishAot)' == 'true'">
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>AnyToneCPS.BuildMode</_Parameter1>
            <_Parameter2>NativeAOT</_Parameter2>
        </AssemblyAttribute>
        <!-- See ..\AnyToneCPS\TrimmerRoots.xml's own comment - preserves
             AnyToneCPS.Models from trimming, real crash found on Desktop
             2026-08-17 (same reflection pattern is latent on Android too,
             even though it hadn't crashed there yet). -->
        <TrimmerRootDescriptor Include="..\AnyToneCPS\TrimmerRoots.xml"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android"/>
        <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\AnyToneCPS\AnyToneCPS.csproj"/>
    </ItemGroup>
</Project>
