<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- Radio connects via a USB OTG cable + the STM32 CDC-ACM programming
	     interface (VID:PID 0483:5740) - required="false" so the app still
	     installs on devices without USB Host support, they just can't use
	     the Radio tab. Per-device access is a runtime UsbManager permission
	     request (AndroidUsbRadioConnection.cs), not a manifest permission. -->
	<uses-feature android:name="android.hardware.usb.host" android:required="false" />
	<application android:label="AnyToneCPS" android:icon="@drawable/icon" />
</manifest>
