<linker>
  <!--
    Preserves every type/member under AnyToneCPS.Models from trimming.

    Real crash found 2026-08-17: EncryptionKeyEntry.EncryptionIdText is a
    genuine public property (see EncryptionKeyEntry.cs), but Desktop's
    NativeAOT publish threw "The type 'EncryptionKeyEntry' does not contain
    a public property named 'EncryptionIdText'" on startup - CommunityToolkit
    .Mvvm's ObservableValidator.ValidateProperty(object, string), called from
    every model's OnXxxTextChanged partial method, is explicitly marked
    RequiresUnreferencedCode because it finds the named property via
    reflection at runtime, and the trimmer stripped that property's metadata
    since nothing else in the app reflects on it by name. Android's own
    NativeAOT publish did not hit this same crash - the two toolchains trim
    differently - but the same crash is latent for any other "*Text"
    validated property (there are dozens, same pattern throughout Models),
    on either platform, the moment execution happens to reach one the
    trimmer decided to strip. A per-property [DynamicDependency] fix (the
    pattern used for MainViewModel.DevForceModelToImage's own reflection)
    doesn't scale here and would silently miss any property added later -
    rooting the whole Models namespace is the general fix.
  -->
  <assembly fullname="AnyToneCPS">
    <type fullname="AnyToneCPS.Models.*" />

    <!--
      Preserves the compiler-generated ObservableValidator fast-path helper.

      Real multi-second freeze found live 2026-09-13, right at app startup
      (project auto-load, same moment the VOX warning's own checkbox stopped
      responding for several seconds - it's the same UI thread). Root cause:
      OptionalSettingsEntry.RevalidateAll() calls ValidateAllProperties(),
      which - per its own [RequiresUnreferencedCode] doc comment - normally
      dispatches through a generated CommunityToolkit.Mvvm.ComponentModel
      .__Internals.__ObservableValidatorExtensions type (emitted by the MVVM
      source generator because OptionalSettingsEntry has 12 [CustomValidation]
      properties) via a reflection-based Type.GetType(...) lookup by string
      name. Nothing else in this project references that generated type
      directly, so the trimmer removed it under NativeAOT, forcing
      ValidateAllProperties() onto its slow fallback path - building a fresh
      compiled LINQ expression at runtime for OptionalSettingsEntry's ~200
      properties, interpreted rather than JIT'd since NativeAOT has no JIT.
      That one-time cost lands squarely at startup, since RefreshValidation
      AndPreview() calls RevalidateAll() as part of both the initial seed and
      the remembered-project auto-load.
    -->
    <type fullname="CommunityToolkit.Mvvm.ComponentModel.__Internals.__ObservableValidatorExtensions" />
  </assembly>
</linker>
