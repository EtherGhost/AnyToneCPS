                              Margin="12"
                              RowSpacing="10"
                              IsVisible="{Binding IsQdc1200EncodeViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="QDC 1200 Encode Settings" />
                            <StackPanel Grid.Row="1" Spacing="8">
                                <CheckBox Content="Side Tone" IsChecked="{Binding Qdc1200Settings.SideTone}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <HeaderedContentControl Header="Max ACK Wait Time (s)">
                                        <ComboBox ItemsSource="{Binding Qdc1200MaxAckWaitTimeOptions}"
                                                  SelectedItem="{Binding Qdc1200Settings.MaxAckWaitTimeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Grid.Column="1" Header="Pretime (ms)">
                                        <ComboBox ItemsSource="{Binding Qdc1200PretimeOptions}"
                                                  SelectedItem="{Binding Qdc1200Settings.PretimeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                </Grid>
                                <HeaderedContentControl Header="Resend Code in Case No Response">
                                    <ComboBox ItemsSource="{Binding Qdc1200ResendCodeOptions}"
                                              SelectedItem="{Binding Qdc1200Settings.ResendCodeText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                            </StackPanel>
                            <Grid Grid.Row="2"
                                  RowDefinitions="Auto,*"
                                  RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Text="{Binding Qdc1200IdCount, StringFormat='{}{0} QDC 1200 IDs'}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Classes="ToolbarButton" Command="{Binding AddQdc1200IdCommand}" Content="+" />
                                    <Button Grid.Column="2" Classes="ToolbarButton" Command="{Binding RemoveQdc1200IdCommand}" Content="Del" />
                                </Grid>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Qdc1200Ids}"
                                         SelectedItem="{Binding SelectedQdc1200Id}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Qdc1200IdEntry">
                                            <Grid ColumnDefinitions="50,*" ColumnSpacing="8" Margin="4">
                                                <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>

                        <Grid RowDefinitions="Auto,*"
                              Margin="12"
                              RowSpacing="10"
                              IsVisible="{Binding IsQdcAddressBookViewSelected}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="{Binding QdcAddressCount, StringFormat='{}{0} QDC addresses'}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                                <Button Grid.Column="1" Classes="ToolbarButton" Command="{Binding AddQdcAddressCommand}" Content="+" />
                                <Button Grid.Column="2" Classes="ToolbarButton" Command="{Binding RemoveQdcAddressCommand}" Content="Del" />
                            </Grid>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding QdcAddresses}"
                                     SelectedItem="{Binding SelectedQdcAddress}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:QdcAddressEntry">
                                        <Grid ColumnDefinitions="50,*" ColumnSpacing="8" Margin="4">
                                            <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid RowDefinitions="Auto,*"
                              Margin="12"
                              RowSpacing="10"
                              IsVisible="{Binding IsFiveToneViewSelected}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="{Binding FiveToneIdCount, StringFormat='{}{0} 5Tone IDs'}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                                <Button Grid.Column="1" Classes="ToolbarButton" Command="{Binding AddFiveToneIdCommand}" Content="+" />
                                <Button Grid.Column="2" Classes="ToolbarButton" Command="{Binding RemoveFiveToneIdCommand}" Content="Del" />
                            </Grid>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding FiveToneIds}"
                                     SelectedItem="{Binding SelectedFiveToneId}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:FiveToneIdEntry">
                                        <Grid ColumnDefinitions="50,*"
                                              ColumnSpacing="8"
                                              Margin="4"
                                              DoubleTapped="FiveToneRow_OnDoubleTapped"
                                              ToolTip.Tip="Double-click a row already set by &amp;Special Call to reset it - matches the real vendor CPS's own gesture.">
                                            <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid RowDefinitions="Auto,Auto,*"
                              Margin="12"
                              RowSpacing="10"
                              IsVisible="{Binding IsTwoToneEncodeViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="2Tone Encode Settings" />
                            <StackPanel Grid.Row="1" Spacing="8">
                                <CheckBox Content="Side Tone" IsChecked="{Binding TwoToneEncodeSettings.SideTone}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <HeaderedContentControl Header="1st Tone Duration (s)">
                                        <ComboBox ItemsSource="{Binding TwoToneEncodeSettings.ToneDurationOptions}"
                                                  SelectedItem="{Binding TwoToneEncodeSettings.FirstToneDurationSecondsText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Grid.Column="1" Header="2nd Tone Duration (s)">
                                        <ComboBox ItemsSource="{Binding TwoToneEncodeSettings.ToneDurationOptions}"
                                                  SelectedItem="{Binding TwoToneEncodeSettings.SecondToneDurationSecondsText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                </Grid>
                                <HeaderedContentControl Header="Long Tone Duration (s)">
                                    <ComboBox ItemsSource="{Binding TwoToneEncodeSettings.ToneDurationOptions}"
                                              SelectedItem="{Binding TwoToneEncodeSettings.LongToneDurationSecondsText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <HeaderedContentControl Header="Gap Time (ms)">
                                        <ComboBox ItemsSource="{Binding TwoToneEncodeSettings.GapTimeMsOptions}"
                                                  SelectedItem="{Binding TwoToneEncodeSettings.GapTimeMsText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Grid.Column="1" Header="Auto Reset Time (s)">
                                        <ComboBox ItemsSource="{Binding TwoToneEncodeSettings.AutoResetTimeSecondsOptions}"
                                                  SelectedItem="{Binding TwoToneEncodeSettings.AutoResetTimeSecondsText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                </Grid>
                            </StackPanel>
                            <Grid Grid.Row="2"
                                  RowDefinitions="Auto,*"
                                  RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <TextBlock Text="{Binding TwoToneEncodeCount, StringFormat='{}{0} 2Tone Encode entries'}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Classes="ToolbarButton" Command="{Binding AddTwoToneEncodeEntryCommand}" Content="+" />
                                    <Button Grid.Column="2" Classes="ToolbarButton" Command="{Binding RemoveTwoToneEncodeEntryCommand}" Content="Del" />
                                </Grid>
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding TwoToneEncodeEntries}"
                                         SelectedItem="{Binding SelectedTwoToneEncodeEntry}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TwoToneEncodeEntry">
                                            <Grid ColumnDefinitions="50,*" ColumnSpacing="8" Margin="4">
                                                <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Grid>

                        <Grid RowDefinitions="Auto,*"
                              Margin="12"
                              RowSpacing="10"
                              IsVisible="{Binding IsTwoToneDecodeViewSelected}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="{Binding TwoToneDecodeCount, StringFormat='{}{0} 2Tone Decode entries'}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                                <Button Grid.Column="1" Classes="ToolbarButton" Command="{Binding AddTwoToneDecodeEntryCommand}" Content="+" />
                                <Button Grid.Column="2" Classes="ToolbarButton" Command="{Binding RemoveTwoToneDecodeEntryCommand}" Content="Del" />
                            </Grid>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding TwoToneDecodeEntries}"
                                     SelectedItem="{Binding SelectedTwoToneDecodeEntry}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:TwoToneDecodeEntry">
                                        <Grid ColumnDefinitions="50,*" ColumnSpacing="8" Margin="4">
                                            <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid Margin="12"
                              IsVisible="{Binding IsDtmfViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="DTMF Settings" />
                        </Grid>

                        <Grid Margin="12"
                              IsVisible="{Binding IsMasterIdViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="Master ID" />
                        </Grid>

                        <Grid Margin="12"
                              IsVisible="{Binding IsTalkAliasSettingsViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="Talk Alias Settings" />
                        </Grid>

                        <Grid Margin="12"
                              IsVisible="{Binding IsAlarmSettingsViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="Alarm Settings" />
                        </Grid>

                        <Grid Margin="12"
                              IsVisible="{Binding IsAprsSettingsViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="APRS Settings" />
                        </Grid>

                        <Grid RowDefinitions="Auto,*"
                              Margin="12"
                              RowSpacing="10"
                              IsVisible="{Binding IsAprsFiltersViewSelected}">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                <TextBlock Text="{Binding AprsReceiveFilterCount, StringFormat='{}{0} APRS receive filters'}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" />
                                <Button Grid.Column="1" Classes="ToolbarButton" Command="{Binding AddAprsReceiveFilterCommand}" Content="+" />
                                <Button Grid.Column="2" Classes="ToolbarButton" Command="{Binding RemoveAprsReceiveFilterCommand}" Content="Del" />
                            </Grid>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding AprsReceiveFilters}"
                                     SelectedItem="{Binding SelectedAprsReceiveFilter}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:AprsReceiveFilterEntry">
                                        <Grid ColumnDefinitions="50,*" ColumnSpacing="8" Margin="4">
                                            <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Callsign}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid Margin="12"
                              IsVisible="{Binding IsRadioViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="Radio" />
                        </Grid>

                        <Grid Margin="12"
                              IsVisible="{Binding IsImportsViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="Imports" />
                        </Grid>

                        <Grid Margin="12"
                              IsVisible="{Binding IsExportsViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="Exports" />
                        </Grid>

                        <Grid Margin="12"
                              IsVisible="{Binding IsSettingsViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="Settings" />
                        </Grid>

                        <Grid Margin="12"
                              IsVisible="{Binding IsDevOptionsViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="Dev Options" />
                        </Grid>

                        <Grid Margin="12"
                              IsVisible="{Binding IsAboutViewSelected}">
                            <TextBlock Classes="SectionTitle" Text="About" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Grid.Row="0"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Grid x:Name="ContentHost"
                  Grid.Column="2"
                  Grid.Row="0"
                  RowDefinitions="*"
                  MinWidth="320">
                <Grid>
                    <views:ChannelDetailView IsVisible="{Binding IsChannelsViewSelected}" />

                    <views:KeysDetailView IsVisible="{Binding IsAnyKeysViewSelected}" />

                    <views:RadioIdListDetailView IsVisible="{Binding IsRadioIdListViewSelected}" />

                    <views:TalkgroupsDetailView IsVisible="{Binding IsTalkgroupsViewSelected}" />

                    <views:ScanListDetailView IsVisible="{Binding IsScanListsViewSelected}" />

                    <views:RoamingChannelsDetailView IsVisible="{Binding IsRoamingChannelsViewSelected}" />

                    <views:RoamingZonesDetailView IsVisible="{Binding IsRoamingZonesViewSelected}" />

                    <views:ReceiveGroupListDetailView IsVisible="{Binding IsReceiveGroupListsViewSelected}" />

                    <views:AutoRepeaterOffsetsDetailView IsVisible="{Binding IsAutoRepeaterOffsetsViewSelected}" />

                    <views:AnalogAddressBookDetailView IsVisible="{Binding IsAnalogAddressBookViewSelected}" />

                    <views:GpsRoamingDetailView IsVisible="{Binding IsGpsRoamingViewSelected}" />

                    <views:TalkgroupWhitelistDetailView IsVisible="{Binding IsTalkgroupWhitelistViewSelected}" />

                    <views:DigitalContactWhitelistDetailView IsVisible="{Binding IsDigitalContactWhitelistViewSelected}" />

                    <views:DigitalContactsDetailView IsVisible="{Binding IsDigitalContactsViewSelected}" />

                    <views:PrefabricatedSmsDetailView IsVisible="{Binding IsPrefabricatedSmsViewSelected}" />

                    <views:AmAirBandDetailView IsVisible="{Binding IsAmAirBandViewSelected}" />

                    <views:AmZoneDetailView IsVisible="{Binding IsAmZoneViewSelected}" />

                    <views:FmBroadcastDetailView IsVisible="{Binding IsFmBroadcastViewSelected}" />

                    <views:AnalogQuickCallDetailView IsVisible="{Binding IsAnalogQuickCallViewSelected}" />

                    <views:StateInformationDetailView IsVisible="{Binding IsStateInformationViewSelected}" />

                    <views:HotKeyDetailView IsVisible="{Binding IsHotKeyViewSelected}" />

                    <views:Qdc1200DecodeDetailView IsVisible="{Binding IsQdc1200DecodeViewSelected}" />

                    <views:Qdc1200EncodeDetailView IsVisible="{Binding IsQdc1200EncodeViewSelected}" />

                    <views:QdcAddressBookDetailView IsVisible="{Binding IsQdcAddressBookViewSelected}" />

                    <views:FiveToneDetailView IsVisible="{Binding IsFiveToneViewSelected}" />

                    <views:TwoToneEncodeDetailView IsVisible="{Binding IsTwoToneEncodeViewSelected}" />

                    <views:TwoToneDecodeDetailView IsVisible="{Binding IsTwoToneDecodeViewSelected}" />

                    <views:DtmfDetailView IsVisible="{Binding IsDtmfViewSelected}" />

                    <views:MasterIdDetailView IsVisible="{Binding IsMasterIdViewSelected}" />

                    <views:TalkAliasSettingsDetailView IsVisible="{Binding IsTalkAliasSettingsViewSelected}" />

                    <views:AlarmSettingsDetailView IsVisible="{Binding IsAlarmSettingsViewSelected}" />

                    <views:AprsSettingsDetailView IsVisible="{Binding IsAprsSettingsViewSelected}" />

                    <views:AprsFiltersDetailView IsVisible="{Binding IsAprsFiltersViewSelected}" />

                    <views:OptionalSettingsView IsVisible="{Binding IsRadioViewSelected}" />

                    <views:ZoneDetailView IsVisible="{Binding IsZonesViewSelected}" />

                    <views:ImportsDetailView IsVisible="{Binding IsImportsViewSelected}" />

                    <views:ExportsDetailView IsVisible="{Binding IsExportsViewSelected}" />

                    <views:SettingsDetailView IsVisible="{Binding IsSettingsViewSelected}" />

                    <views:DevOptionsDetailView IsVisible="{Binding IsDevOptionsViewSelected}" />

                    <views:AboutDetailView IsVisible="{Binding IsAboutViewSelected}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Safety-critical startup popup, added 2026-07-30, user-requested -
             see OptionalSettingsEntry.IsVoxOn's doc comment for the hazard
             this warns about. Shown once per launch (unless "Don't show
             again" is checked), auto-dismisses after 8s
             (MainViewModel.LoadAppSettingsAsync), sits in this outer Grid's
             shared (0,0) cell so it overlays on top of everything else. -->
        <Border IsVisible="{Binding ShowVoxStartupWarning}"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,24,0,0"
                MaxWidth="480"
                Background="{DynamicResource AppInfoBadgeBackgroundBrush}"
                BorderBrush="{DynamicResource AppErrorBrush}"
                BorderThickness="2"
                CornerRadius="8"
                Padding="16,12">
            <StackPanel Spacing="10">
                <TextBlock Text="Safety warning: turn VOX off before connecting the radio"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AppInfoBadgeTextBrush}" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{DynamicResource AppInfoBadgeTextBrush}"
                           Text="If VOX is on, the radio can start transmitting on its own while connected to this computer for programming. That can damage the PC. Make sure VOX is off before connecting." />
                <Grid ColumnDefinitions="*,Auto">
                    <CheckBox Content="Don't show again"
                              IsChecked="{Binding SuppressVoxStartupWarning}"
                              Foreground="{DynamicResource AppInfoBadgeTextBrush}" />
                    <Button Grid.Column="1" Content="Close" Command="{Binding DismissVoxStartupWarningCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Blocking busy overlay, added 2026-08-07 - shared by project
             load/save and radio read/write (see MainViewModel.
             IsBusyOverlayVisible's doc comment). Sits in this outer Grid's
             shared (0,0) cell, same technique as the VOX warning above, but
             covers the full window and is not dismissible - these are all
             operations where editing fields mid-flight would be unsafe. -->
        <Border IsVisible="{Binding IsBusyOverlayVisible}"
                Background="#B0000000">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="260"
                    MaxWidth="480"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppPanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24,20">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" />
                    <TextBlock Text="{Binding BusyOverlayMessage}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
    </Grid>
</UserControl>
