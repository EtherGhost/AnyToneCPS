<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AnyToneCPS.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="AnyToneCPS.Views.SettingsDetailView"
             x:DataType="vm:MainViewModel">
    <!-- Split out of MainView.axaml 2026-08-10 - see ChannelDetailView's own
         doc comment. Sidebar's own compact Settings list stays in
         MainView.axaml, IsSettingsViewSelected list section. -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Border Classes="Panel">
            <Grid RowDefinitions="Auto,Auto,Auto"
                  RowSpacing="18">
                <TextBlock Classes="SectionTitle" Text="Settings" />

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="18">
                    <HeaderedContentControl Header="Theme">
                        <ComboBox ItemsSource="{Binding ThemeModes}"
                                  SelectedItem="{Binding SelectedThemeMode}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Grid.Column="1" Header="Export folder">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="10">
                            <TextBlock Text="{Binding ExportDirectory}"
                                       Foreground="{DynamicResource AppMutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Command="{Binding ChooseExportDirectoryCommand}"
                                    Content="Choose" />
                        </Grid>
                    </HeaderedContentControl>
                </Grid>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="18">
                    <HeaderedContentControl Header="Version">
                        <TextBlock Text="{Binding AppVersion}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Grid.Column="1" Header="NativeAOT">
                        <TextBlock Text="{Binding NativeAotDescription}" />
                    </HeaderedContentControl>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
