                                                        <TextBox Text="{Binding OptionalSettings.VfoScanEndFreqVhfText, UpdateSourceTrigger=PropertyChanged}"
                                                             Classes="PinDigits"
                                                             views:DigitOnlyInput.Enabled="True"
                                                             views:DigitOnlyInput.AllowDecimalPoint="True"
                                                             views:DigitOnlyInput.MaxValue="174" />
                                                    </DataValidationErrors>
                                                </HeaderedContentControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
