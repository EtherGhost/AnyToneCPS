                                                                     views:DigitOnlyInput.Enabled="True"
                                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                                     views:DigitOnlyInput.MaxValue="174" />
                                                        </DataValidationErrors>
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Max Freq Of Auto Repeater2(VHF) [MHz]" ToolTip.Tip="136.00000-174.00000, matching the real radio's VHF band limits.">
                                                        <DataValidationErrors>
                                                            <TextBox Text="{Binding OptionalSettings.AutoRepeater2MaxFreqVhfText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Classes="PinDigits"
                                                                     views:DigitOnlyInput.Enabled="True"
                                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                                     views:DigitOnlyInput.MaxValue="174" />
                                                        </DataValidationErrors>
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Min Freq Of Auto Repeater2(UHF) [MHz]" ToolTip.Tip="400.00000-480.00000, matching the real radio's UHF band limits.">
                                                        <DataValidationErrors>
                                                            <TextBox Text="{Binding OptionalSettings.AutoRepeater2MinFreqUhfText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Classes="PinDigits"
                                                                     views:DigitOnlyInput.Enabled="True"
                                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                                     views:DigitOnlyInput.MaxValue="480" />
                                                        </DataValidationErrors>
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Max Freq Of Auto Repeater2(UHF) [MHz]" ToolTip.Tip="400.00000-480.00000, matching the real radio's UHF band limits.">
                                                        <DataValidationErrors>
                                                            <TextBox Text="{Binding OptionalSettings.AutoRepeater2MaxFreqUhfText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Classes="PinDigits"
                                                                     views:DigitOnlyInput.Enabled="True"
                                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                                     views:DigitOnlyInput.MaxValue="480" />
                                                        </DataValidationErrors>
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Repeater Mode">
                                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.RepeaterModeText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Rep CC Limit">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.RepCcLimitOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.RepCcLimitText}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Rep Slot PathA">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.RepSlotAOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.RepSlotAText}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Rep Slot PathB">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.RepSlotBOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.RepSlotBText}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Repeater Whitelist">
                                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.RepeaterWhitelistText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                                    </HeaderedContentControl>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Record">
                                    <ScrollViewer>
                                        <StackPanel Spacing="12" Margin="16">
                                            <StackPanel Spacing="12" MaxWidth="360">
                                                <HeaderedContentControl Header="Record Function">
                                                    <ToggleSwitch IsChecked="{Binding OptionalSettings.RecordFunctionText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                                </HeaderedContentControl>
                                                <HeaderedContentControl Header="Record Delay (s)">
                                                    <ComboBox ItemsSource="{Binding OptionalSettings.RecordDelayOptions}"
                                                              SelectedItem="{Binding OptionalSettings.RecordDelayText}" />
                                                </HeaderedContentControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Volume/Audio">
                                    <ScrollViewer>
                                        <StackPanel Spacing="12" Margin="16">
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                                                <StackPanel Grid.Column="0" Spacing="12">
                                                    <HeaderedContentControl Header="Maximum Volume">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.MaxVolumeOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.MaxVolumeText}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Power On Volume Type">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.PowerOnVolumeTypeOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.PowerOnVolumeTypeText}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Power On Volume">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.PowerOnVolumeOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.PowerOnVolumeText}"
                                                                  IsEnabled="{Binding OptionalSettings.IsPowerOnVolumeEnabled}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Max Headphone Volume">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.MaxVolumeOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.MaxHeadphoneVolumeText}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="DMR Mic Gain">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.MicGainOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.DigiMicGainText}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Sub SpkInTx">
                                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.SubSpkInTxText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                                    </HeaderedContentControl>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="12">
                                                    <HeaderedContentControl Header="Enhanced Sound Quality">
                                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.EnhancedSoundQualityText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="Ana Mic Gain">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.MicGainOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.AnalogMicGainText}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="DRC Dynamic Range Control (Rx AGC)">
                                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.RxAgcText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="NX Mic Gain">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.MicGainOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.NxMicGainText}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="RX Noise Reduction">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.NoiseReductionOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.RxNoiseReductionText}" />
                                                    </HeaderedContentControl>
                                                    <HeaderedContentControl Header="TX Noise Reduction">
                                                        <ComboBox ItemsSource="{Binding OptionalSettings.NoiseReductionOptions}"
                                                                  SelectedItem="{Binding OptionalSettings.TxNoiseReductionText}" />
                                                    </HeaderedContentControl>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem Header="Satellite">
                                    <ScrollViewer>
                                        <StackPanel Spacing="12" Margin="16">
                                            <StackPanel Spacing="12" MaxWidth="360">
                                                <HeaderedContentControl Header="Sat Location">
                                                    <ComboBox ItemsSource="{Binding OptionalSettings.SatLocationOptions}"
                                                              SelectedItem="{Binding OptionalSettings.SatLocationText}" />
                                                </HeaderedContentControl>
                                                <HeaderedContentControl Header="Sat TX Power">
                                                    <ComboBox ItemsSource="{Binding OptionalSettings.TxPowerOptions}"
                                                              SelectedItem="{Binding OptionalSettings.SatTxPowerText}" />
                                                </HeaderedContentControl>
                                                <HeaderedContentControl Header="Sat Ana SQL">
                                                    <ComboBox ItemsSource="{Binding OptionalSettings.SatAnaSqlOptions}"
                                                              SelectedItem="{Binding OptionalSettings.SatAnaSqlText}" />
                                                </HeaderedContentControl>
                                                <HeaderedContentControl Header="Sat AOS Limit">
                                                    <ComboBox ItemsSource="{Binding OptionalSettings.SatAosLimitOptions}"
                                                              SelectedItem="{Binding OptionalSettings.SatAosLimitText}" />
                                                </HeaderedContentControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
</UserControl>
