<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AnyToneCPS.ViewModels"
             xmlns:models="using:AnyToneCPS.Models"
             xmlns:views="using:AnyToneCPS.Views"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="AnyToneCPS.Views.AmZoneDetailView"
             x:DataType="vm:MainViewModel">
    <!-- Split out of MainView.axaml 2026-08-10 - see ChannelDetailView's own
         doc comment. Sidebar's own compact AM Zone list stays in
         MainView.axaml, IsAmZoneViewSelected list section. -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Border Classes="Panel">
            <Grid RowDefinitions="Auto,*,*"
                  RowSpacing="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="70" />
                        <ColumnDefinition Width="2*" MinWidth="120" />
                        <ColumnDefinition Width="1.5*" MinWidth="160" />
                    </Grid.ColumnDefinitions>
                    <HeaderedContentControl Header="No">
                        <TextBox Text="{Binding SelectedAmZone.Number}"
                                 views:DigitOnlyInput.Enabled="True"
                                 views:DigitOnlyInput.MaxValue="16" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Grid.Column="1" Header="Zone Name">
                        <TextBox Text="{Binding SelectedAmZone.Name}"
                                 MaxLength="16"
                                 views:AsciiTextInput.Enabled="True"
                                 FontWeight="{Binding SelectedAmZone.NameFontWeight}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Grid.Column="2" Header="A Channel">
                        <ComboBox ItemsSource="{Binding SelectedAmZoneMemberOptions}"
                                  SelectedItem="{Binding SelectedAmZone.AChannel}"
                                  FontWeight="{Binding SelectedAmZone.AChannelFontWeight}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:AmAirEntry">
                                    <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </HeaderedContentControl>
                </Grid>

                <Grid Grid.Row="1"
                      ColumnDefinitions="*,Auto,*"
                      ColumnSpacing="12">
                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="8">
                        <TextBlock Text="{Binding AvailableAmZoneChannels.Count, StringFormat='Available Channels ({0})'}"
                                   FontWeight="SemiBold" />
                        <ListBox x:Name="AvailableAmZoneChannelsList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding AvailableAmZoneChannels}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="AvailableAmZoneChannelsList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:AmAirEntry">
                                    <TextBlock Margin="8,7" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="8"
                                MinWidth="110">
                        <Button Command="{Binding AddAmZoneMembersCommand}" Content="Add &gt;" />
                        <Button Command="{Binding RemoveAmZoneMembersCommand}" Content="&lt; Remove" />
                    </StackPanel>

                    <Grid Grid.Column="2"
                          RowDefinitions="Auto,*"
                          RowSpacing="8">
                        <TextBlock Text="{Binding SelectedAmZone.Members.Count, StringFormat='Added Channels ({0})'}"
                                   FontWeight="{Binding SelectedAmZone.MembersFontWeight}" />
                        <ListBox x:Name="AmZoneMembersList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding SelectedAmZone.Members}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="AmZoneMembersList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:AmAirEntry">
                                    <TextBlock Margin="8,7" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2"
                      ColumnDefinitions="*,Auto,*"
                      ColumnSpacing="12">
                    <Grid RowDefinitions="Auto,*"
                          RowSpacing="8">
                        <TextBlock Text="{Binding AvailableAmZoneScanChannels.Count, StringFormat='Available Zone Scan Channel ({0})'}"
                                   FontWeight="SemiBold"
                                   ToolTip.Tip="Restricted to AM CH 001-128 - the scan-channel bitmask can't reference anything higher (confirmed 2026-08-02)." />
                        <ListBox x:Name="AvailableAmZoneScanChannelsList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding AvailableAmZoneScanChannels}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="AvailableAmZoneScanChannelsList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:AmAirEntry">
                                    <TextBlock Margin="8,7" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="8"
                                MinWidth="110">
                        <Button Command="{Binding AddAmZoneScanChannelMembersCommand}" Content="Add &gt;" />
                        <Button Command="{Binding RemoveAmZoneScanChannelMembersCommand}" Content="&lt; Remove" />
                    </StackPanel>

                    <Grid Grid.Column="2"
                          RowDefinitions="Auto,*"
                          RowSpacing="8">
                        <TextBlock Text="{Binding SelectedAmZone.ScanChannelMembers.Count, StringFormat='Zone Scan Channel Member ({0})'}"
                                   FontWeight="{Binding SelectedAmZone.ScanChannelMembersFontWeight}" />
                        <ListBox x:Name="AmZoneScanChannelMembersList"
                                 Grid.Row="1"
                                 ItemsSource="{Binding SelectedAmZone.ScanChannelMembers}"
                                 SelectionMode="Multiple"
                                 SelectionChanged="AmZoneScanChannelMembersList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:AmAirEntry">
                                    <TextBlock Margin="8,7" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
