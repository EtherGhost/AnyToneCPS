<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AnyToneCPS.ViewModels"
             xmlns:views="using:AnyToneCPS.Views"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="AnyToneCPS.Views.AutoRepeaterOffsetsDetailView"
             x:DataType="vm:MainViewModel">
    <!-- Split out of MainView.axaml 2026-08-10 - see ChannelDetailView's own
         doc comment. Sidebar's own compact Auto Repeater Offsets list stays
         in MainView.axaml, IsAutoRepeaterOffsetsViewSelected list section. -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Border Classes="Panel">
            <StackPanel Spacing="12">
                <TextBlock Classes="SectionTitle" Text="Auto repeater offset details" />
                <HeaderedContentControl Header="Number">
                    <TextBox Text="{Binding SelectedAutoRepeaterOffset.Number}"
                             views:DigitOnlyInput.Enabled="True"
                             views:DigitOnlyInput.MaxValue="250"
                             Classes="PinDigits" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Offset Frequency (MHz)">
                    <TextBox Text="{Binding SelectedAutoRepeaterOffset.OffsetFrequencyMhzText}"
                             views:DigitOnlyInput.Enabled="True"
                             views:DigitOnlyInput.AllowDecimalPoint="True"
                             views:DigitOnlyInput.MaxValue="90"
                             FontWeight="{Binding SelectedAutoRepeaterOffset.OffsetFrequencyMhzFontWeight}"
                             Classes="PinDigits" />
                </HeaderedContentControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
