<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AnyToneCPS.ViewModels"
             xmlns:views="using:AnyToneCPS.Views"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="AnyToneCPS.Views.MasterIdDetailView"
             x:DataType="vm:MainViewModel">
    <!-- Split out of MainView.axaml 2026-08-10 - see ChannelDetailView's own
         doc comment. Sidebar's own compact Master ID list stays in
         MainView.axaml, IsMasterIdViewSelected list section. -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Border Classes="Panel">
            <StackPanel Margin="8" Spacing="10" MaxWidth="360">
                <TextBlock Classes="Label"
                           Text="There is only ever one Master ID on the radio - a designated primary DMR ID among the Radio ID list." />
                <CheckBox Content="Used" IsChecked="{Binding MasterId.Used}" />
                <HeaderedContentControl Header="DMR ID">
                    <TextBox Text="{Binding MasterId.DmrIdText}"
                             MaxLength="8"
                             views:DigitOnlyInput.Enabled="True" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Name">
                    <TextBox Text="{Binding MasterId.Name}"
                             MaxLength="16"
                             views:AsciiTextInput.Enabled="True" />
                </HeaderedContentControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
