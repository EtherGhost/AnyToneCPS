<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AnyToneCPS.ViewModels"
             xmlns:views="using:AnyToneCPS.Views"
             xmlns:converters="using:AnyToneCPS.Converters"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="AnyToneCPS.Views.QdcAddressBookDetailView"
             x:DataType="vm:MainViewModel">
    <!-- Split out of MainView.axaml 2026-08-10 - see ChannelDetailView's own
         doc comment. Sidebar's own compact QDC Address Book list stays in
         MainView.axaml, IsQdcAddressBookViewSelected list section. -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Border Classes="Panel">
            <StackPanel Spacing="12" MaxWidth="360">
                <TextBlock Classes="SectionTitle" Text="{Binding SelectedQdcAddress.Number, StringFormat='QDC Address {0} details'}" />
                <HeaderedContentControl Header="Call Type">
                    <ComboBox ItemsSource="{Binding QdcAddressCallTypeOptions}"
                              SelectedItem="{Binding SelectedQdcAddress.CallTypeText}"
                              HorizontalAlignment="Stretch" />
                </HeaderedContentControl>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <HeaderedContentControl Header="Private ID" IsEnabled="{Binding SelectedQdcAddress.IsPrivateCallIdEnabled}">
                        <TextBox Text="{Binding SelectedQdcAddress.PrivateCallId}"
                                 MaxLength="4"
                                 views:HexDigitInput.Enabled="True" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Grid.Column="1" Header="Group ID" IsEnabled="{Binding SelectedQdcAddress.IsGroupCallIdEnabled}">
                        <TextBox Text="{Binding SelectedQdcAddress.GroupCallId}"
                                 MaxLength="3"
                                 views:HexDigitInput.Enabled="True" />
                    </HeaderedContentControl>
                </Grid>
                <HeaderedContentControl Header="Type">
                    <ComboBox ItemsSource="{Binding SelectedQdcAddress.TypeOptions}"
                              SelectedItem="{Binding SelectedQdcAddress.TypeText}"
                              HorizontalAlignment="Stretch" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Ack" IsEnabled="{Binding SelectedQdcAddress.IsAckEnabled}">
                    <ToggleSwitch IsChecked="{Binding SelectedQdcAddress.AckText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Name">
                    <TextBox Text="{Binding SelectedQdcAddress.Name}"
                             MaxLength="16"
                             views:AsciiTextInput.Enabled="True" />
                </HeaderedContentControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
