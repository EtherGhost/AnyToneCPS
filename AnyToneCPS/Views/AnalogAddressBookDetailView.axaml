<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AnyToneCPS.ViewModels"
             xmlns:views="using:AnyToneCPS.Views"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="AnyToneCPS.Views.AnalogAddressBookDetailView"
             x:DataType="vm:MainViewModel">
    <!-- Split out of MainView.axaml 2026-08-10 - see ChannelDetailView's own
         doc comment. Sidebar's own compact Analog Address Book list stays
         in MainView.axaml, IsAnalogAddressBookViewSelected list section. -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Border Classes="Panel">
            <StackPanel Spacing="12">
                <TextBlock Classes="SectionTitle" Text="Analog address details" />
                <HeaderedContentControl Header="No">
                    <TextBox Text="{Binding SelectedAnalogAddress.Number}"
                             views:DigitOnlyInput.Enabled="True"
                             views:DigitOnlyInput.MaxValue="128"
                             Classes="PinDigits" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Address Number">
                    <TextBox Text="{Binding SelectedAnalogAddress.AddressNumber}"
                             views:DigitOnlyInput.Enabled="True"
                             MaxLength="10"
                             Classes="PinDigits" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Name">
                    <TextBox Text="{Binding SelectedAnalogAddress.Name}"
                             MaxLength="15"
                             views:AsciiTextInput.Enabled="True"
                             FontWeight="{Binding SelectedAnalogAddress.NameFontWeight}" />
                </HeaderedContentControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
