                                                     Classes="PinDigits"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                     views:DigitOnlyInput.MaxValue="174" />
                                        </DataValidationErrors>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Min Freq Of Auto Repeater1(UHF) [MHz]" ToolTip.Tip="400.00000-480.00000, matching the real radio's UHF band limits.">
                                        <DataValidationErrors>
                                            <TextBox Text="{Binding OptionalSettings.AutoRepeater1MinFreqUhfText, UpdateSourceTrigger=PropertyChanged}"
                                                     Classes="PinDigits"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                     views:DigitOnlyInput.MaxValue="480" />
                                        </DataValidationErrors>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Max Freq Of Auto Repeater1(UHF) [MHz]" ToolTip.Tip="400.00000-480.00000, matching the real radio's UHF band limits.">
                                        <DataValidationErrors>
                                            <TextBox Text="{Binding OptionalSettings.AutoRepeater1MaxFreqUhfText, UpdateSourceTrigger=PropertyChanged}"
                                                     Classes="PinDigits"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                     views:DigitOnlyInput.MaxValue="480" />
                                        </DataValidationErrors>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Min Freq Of Auto Repeater2(VHF) [MHz]" ToolTip.Tip="136.00000-174.00000, matching the real radio's VHF band limits.">
                                        <DataValidationErrors>
                                            <TextBox Text="{Binding OptionalSettings.AutoRepeater2MinFreqVhfText, UpdateSourceTrigger=PropertyChanged}"
                                                     Classes="PinDigits"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                     views:DigitOnlyInput.MaxValue="174" />
                                        </DataValidationErrors>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Max Freq Of Auto Repeater2(VHF) [MHz]" ToolTip.Tip="136.00000-174.00000, matching the real radio's VHF band limits.">
                                        <DataValidationErrors>
                                            <TextBox Text="{Binding OptionalSettings.AutoRepeater2MaxFreqVhfText, UpdateSourceTrigger=PropertyChanged}"
                                                     Classes="PinDigits"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                     views:DigitOnlyInput.MaxValue="174" />
                                        </DataValidationErrors>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Min Freq Of Auto Repeater2(UHF) [MHz]" ToolTip.Tip="400.00000-480.00000, matching the real radio's UHF band limits.">
                                        <DataValidationErrors>
                                            <TextBox Text="{Binding OptionalSettings.AutoRepeater2MinFreqUhfText, UpdateSourceTrigger=PropertyChanged}"
                                                     Classes="PinDigits"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                     views:DigitOnlyInput.MaxValue="480" />
                                        </DataValidationErrors>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Max Freq Of Auto Repeater2(UHF) [MHz]" ToolTip.Tip="400.00000-480.00000, matching the real radio's UHF band limits.">
                                        <DataValidationErrors>
                                            <TextBox Text="{Binding OptionalSettings.AutoRepeater2MaxFreqUhfText, UpdateSourceTrigger=PropertyChanged}"
                                                     Classes="PinDigits"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                     views:DigitOnlyInput.MaxValue="480" />
