                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Min Freq Of Auto Repeater1(VHF) [MHz]" ToolTip.Tip="136.00000-174.00000, matching the real radio's VHF band limits.">
                                        <DataValidationErrors>
                                            <TextBox Text="{Binding OptionalSettings.AutoRepeater1MinFreqVhfText, UpdateSourceTrigger=PropertyChanged}"
                                                     Classes="PinDigits"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     views:DigitOnlyInput.AllowDecimalPoint="True"
                                                     views:DigitOnlyInput.MaxValue="174" />
                                        </DataValidationErrors>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Max Freq Of Auto Repeater1(VHF) [MHz]" ToolTip.Tip="136.00000-174.00000, matching the real radio's VHF band limits.">
