                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Roaming Zone">
                                        <ComboBox ItemsSource="{Binding OptionalSettingsRoamingZoneOptions}" SelectedItem="{Binding OptionalSettingsRoamingZoneName}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Repeater Mode">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.RepeaterModeText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Rep CC Limit">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.RepCcLimitOptions}" SelectedItem="{Binding OptionalSettings.RepCcLimitText}" />
                                    </HeaderedContentControl>
