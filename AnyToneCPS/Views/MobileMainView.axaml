                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Auto Roaming Start Condition">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.AutoRoamingStartConditionOptions}" SelectedItem="{Binding OptionalSettings.AutoRoamingStartConditionText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Auto Roaming at Fixed Time[m]">
