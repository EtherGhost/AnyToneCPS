                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsRecordSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Record" />
                                    <HeaderedContentControl Header="Record Function">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.RecordFunctionText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Record Delay (s)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.RecordDelayOptions}" SelectedItem="{Binding OptionalSettings.RecordDelayText}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsVolumeAudioSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Volume / Audio" />
                                    <HeaderedContentControl Header="Maximum Volume">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.MaxVolumeOptions}" SelectedItem="{Binding OptionalSettings.MaxVolumeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Power On Volume Type">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.PowerOnVolumeTypeOptions}" SelectedItem="{Binding OptionalSettings.PowerOnVolumeTypeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Power On Volume">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.PowerOnVolumeOptions}" SelectedItem="{Binding OptionalSettings.PowerOnVolumeText}" IsEnabled="{Binding OptionalSettings.IsPowerOnVolumeEnabled}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Max Headphone Volume">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.MaxVolumeOptions}" SelectedItem="{Binding OptionalSettings.MaxHeadphoneVolumeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="DMR Mic Gain">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.MicGainOptions}" SelectedItem="{Binding OptionalSettings.DigiMicGainText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Enhanced Sound Quality">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.EnhancedSoundQualityText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Ana Mic Gain">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.MicGainOptions}" SelectedItem="{Binding OptionalSettings.AnalogMicGainText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="DRC Dynamic Range Control (Rx AGC)">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.RxAgcText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="NX Mic Gain">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.MicGainOptions}" SelectedItem="{Binding OptionalSettings.NxMicGainText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Sub SpkInTx">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.SubSpkInTxText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="RX Noise Reduction">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.NoiseReductionOptions}" SelectedItem="{Binding OptionalSettings.RxNoiseReductionText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TX Noise Reduction">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.NoiseReductionOptions}" SelectedItem="{Binding OptionalSettings.TxNoiseReductionText}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsSatelliteSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Satellite" />
                                    <HeaderedContentControl Header="Sat Location">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.SatLocationOptions}" SelectedItem="{Binding OptionalSettings.SatLocationText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Sat TX Power">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.TxPowerOptions}" SelectedItem="{Binding OptionalSettings.SatTxPowerText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Sat Ana SQL">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.SatAnaSqlOptions}" SelectedItem="{Binding OptionalSettings.SatAnaSqlText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Sat AOS Limit">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.SatAosLimitOptions}" SelectedItem="{Binding OptionalSettings.SatAosLimitText}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Only shown on the "Radio" sub-section itself (the nav
                             tree's top-level "Radio" leaf, SubTabIndex 0) - previously
                             unconditional within the whole IsRadioViewSelected panel, so
                             these buttons showed up at the bottom of every section
                             (Power-on, Display, Satellite, ...). Every other section
                             here is gated the same way; this one just got missed when
                             the flat page was split up. Fixed 2026-07-29. -->
                        <StackPanel IsVisible="{Binding IsOptionalSettingsRadioSubTabSelected}" Spacing="12">
                            <Border Classes="Panel">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="SectionTitle" Text="Read codeplug from radio" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               FontSize="12"
                                               Text="Read-only: this never writes anything back to the radio. Connect the D890UV via its USB programming cable, pick the serial port, and tap Read From Radio. This replaces the currently loaded channels/zones/codeplug lists with what's actually on the radio." />

                                    <TextBlock Classes="Label"
                                               TextWrapping="Wrap"
                                               Text="Not available on this platform (no serial port support)."
                                               IsVisible="{Binding !IsRadioAvailableOnThisPlatform}" />

                                    <StackPanel Spacing="8" IsVisible="{Binding IsRadioAvailableOnThisPlatform}">
                                        <ComboBox ItemsSource="{Binding AvailablePorts}"
                                                  SelectedItem="{Binding SelectedPort}" />
                                        <Button Command="{Binding RefreshRadioPortsCommand}" Content="Refresh ports" />
                                        <Button Command="{Binding ReadFromRadioCommand}" Content="Read From Radio" />
                                    </StackPanel>

                                    <!-- No modal dialog concept on Mobile (see
                                         AvaloniaStoragePickerService's own doc
                                         comment on ShowIncludeOptionsDialogAsync) -
                                         this popup's checkboxes are the real
                                         input here; the shared ViewModel's dialog
                                         call passes through unchanged on this
                                         platform and just uses whatever they're
                                         already set to. Moved from always-visible
                                         inline checkboxes to a popup 2026-08-16 -
                                         same technique as the status Flyouts in
                                         MainView.axaml. -->
                                    <Button Content="Include options ▾" IsVisible="{Binding IsRadioAvailableOnThisPlatform}">
                                        <Button.Flyout>
                                            <Flyout>
                                                <Border Classes="Panel" Padding="12" MaxWidth="420">
                                                    <StackPanel Spacing="12">
                                                        <TextBlock Classes="SectionTitle" Text="Read include options" />
                                                        <StackPanel Spacing="4">
                                                            <CheckBox IsChecked="{Binding IncludeDigitalContactList}" Content="Include Digital Contact List" />
                                                            <TextBlock Classes="Label"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="12"
                                                                       Text="Off by default, matching the vendor CPS's own default: this list can be very large and slow to read. Only check this if you need the contact database." />
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <CheckBox IsChecked="{Binding IncludeEncryptionKeysList}" Content="Include Encryption Keys" />
                                                            <TextBlock Classes="Label"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="12"
                                                                       Text="Off by default - the vendor CPS never reads this back either (write-only there), and our own read is slow (one 16-byte block per serial round-trip). Only check this if you actually need to see key material." />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <StackPanel Spacing="6" IsVisible="{Binding IsReadingFromRadio}">
                                        <TextBlock Text="Reading codeplug..." FontWeight="Bold" />
                                        <ProgressBar Minimum="0"
                                                     Maximum="{Binding RadioReadProgressTotal}"
                                                     Value="{Binding RadioReadProgressCurrent}" />
                                        <TextBlock Text="{Binding RadioReadProgressPercentText}" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <SelectableTextBlock Text="{Binding RadioReadStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Button Content="Copy full message"
                                            HorizontalAlignment="Left"
                                            Padding="8,3"
                                            FontSize="11"
                                            Command="{Binding CopyRadioReadWarningsCommand}" />
                                    <SelectableTextBlock Text="{Binding RadioIdentitySummary}"
                                               IsVisible="{Binding HasRadioIdentitySummary}"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               TextWrapping="Wrap" />

                                    <TextBlock Classes="Label"
                                               Text="Warnings"
                                               IsVisible="{Binding HasRadioReadWarnings}" />
                                    <ItemsControl ItemsSource="{Binding RadioReadWarnings}"
                                                  IsVisible="{Binding HasRadioReadWarnings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <SelectableTextBlock Text="{Binding}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Classes="Panel" IsVisible="{Binding HasDeviceLocalInfo}">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Device Information" />
                                    <TextBlock Classes="Label"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               Text="Read directly from the radio - never saved to the project file, and only available right after a Read From Radio." />
                                    <HeaderedContentControl Header="Model">
                                        <TextBlock Text="{Binding DeviceModel}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Bands">
                                        <TextBlock Text="{Binding DeviceBands}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Firmware Version">
                                        <TextBlock Text="{Binding DeviceVersion}" />
                                    </HeaderedContentControl>

                                    <TextBlock Classes="SectionTitle" Text="Local Information" Margin="0,8,0,0" />
                                    <HeaderedContentControl Header="Radio Type">
                                        <TextBlock Text="{Binding DeviceLocalInfo.RadioType}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Area Code">
                                        <TextBlock Text="{Binding DeviceLocalInfo.AreaCode}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Manufacture Code">
                                        <TextBlock Text="{Binding DeviceLocalInfo.ManufactureCode}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Serial Number">
                                        <TextBlock Text="{Binding DeviceLocalInfo.SerialNumber}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Production Date">
                                        <TextBlock Text="{Binding DeviceLocalInfo.ProductionDate}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Maintenance Date">
                                        <TextBlock Text="{Binding DeviceLocalInfo.MaintenanceDate}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Maintenance Description">
                                        <TextBlock Text="{Binding DeviceLocalInfo.MaintenanceDescription}" TextWrapping="Wrap" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Dealer Code">
                                        <TextBlock Text="{Binding DeviceLocalInfo.DealerCode}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Stock Date">
                                        <TextBlock Text="{Binding DeviceLocalInfo.StockDate}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Sell Date">
                                        <TextBlock Text="{Binding DeviceLocalInfo.SellDate}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Seller">
                                        <TextBlock Text="{Binding DeviceLocalInfo.Seller}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>

                            <Border Classes="Panel" IsVisible="{Binding IsRadioAvailableOnThisPlatform}">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="SectionTitle" Text="Write changes to radio" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               FontSize="12"
                                               Text="Reads and rewrites the radio's whole known codeplug with every pending change - not just one field. Takes several minutes. Disabled until at least one Read From Radio has happened this session." />
                                    <!-- Permanently visible instead of a per-click
                                         blocking dialog (Mobile has no Window to
                                         show one in) - see
                                         AvaloniaStoragePickerService.ConfirmWriteToRadioAsync's
                                         own doc comment. Same safety information
                                         Desktop's modal shows, just always on
                                         screen here rather than gated. -->
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppErrorBrush}"
                                               FontSize="12"
                                               Text="Writing a single field safely requires reading and rewriting the radio's whole known codeplug - narrow single-record writes were found to silently erase unrelated data sharing the same flash region. Leaving an include option unchecked below does NOT discard those pending edits, it just skips writing them out this time." />

                                    <Button Content="Include options ▾">
                                        <Button.Flyout>
                                            <Flyout>
                                                <Border Classes="Panel" Padding="12" MaxWidth="420">
                                                    <StackPanel Spacing="12">
                                                        <TextBlock Classes="SectionTitle" Text="Write include options" />
                                                        <StackPanel Spacing="4">
                                                            <CheckBox IsChecked="{Binding WriteIncludeDigitalContactList}"
                                                                      IsEnabled="{Binding CanIncludeDigitalContactsInWrite}"
                                                                      Content="Include Digital Contact List"
                                                                      ToolTip.Tip="Read the Digital Contact List from the radio at least once this session before writing it - this prevents accidentally replacing the whole real list on the radio with an incomplete one." />
                                                            <TextBlock Classes="Label"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="12"
                                                                       Text="Only available after a genuine Read From Radio this session - the write always replaces the whole contact list, so a partial/never-read list can't be trusted as complete." />
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <CheckBox IsChecked="{Binding WriteIncludeEncryptionKeys}" Content="Include Encryption Keys" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>

                                    <Button Command="{Binding WriteChangesToRadioCommand}" Content="Write Changes to Radio" />

                                    <SelectableTextBlock Text="{Binding RadioWriteStatusText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Button Content="Copy full message"
                                            HorizontalAlignment="Left"
                                            Padding="8,3"
                                            FontSize="11"
                                            Command="{Binding CopyRadioWriteWarningsCommand}" />
                                    <ItemsControl ItemsSource="{Binding RadioWriteWarnings}" IsVisible="{Binding RadioWriteWarnings.Count}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <SelectableTextBlock Text="{Binding}" Foreground="Firebrick" TextWrapping="Wrap" FontSize="12" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Hidden for now (IsVisible="False") - a diagnostic/dev tool,
                                 not something an end user needs. Set back to
                                 "{Binding IsRadioAvailableOnThisPlatform}" to restore it. -->
                            <Border Classes="Panel" IsVisible="False">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="SectionTitle" Text="Verify saved project matches radio" />
                                    <TextBlock TextWrapping="Wrap"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               FontSize="12"
                                               Text="Loads the saved project file, does an independent fresh Read From Radio, and diffs every Channel/Zone/Scan List/Encryption Key field between the two - catches drift between what's saved and what's actually on the radio. Requires the project to already be saved. Neither read disturbs the currently loaded data." />
                                    <Button Command="{Binding VerifyReadSaveRoundtripCommand}" Content="Verify Saved Project Matches Radio" />
                                    <TextBlock Text="{Binding VerifyRoundtripStatusText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding VerifyRoundtripMismatches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsImportsViewSelected}" Spacing="12">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="SectionTitle" Text="Imports" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding NewProjectCommand}" Content="New" />
                                    <Button Command="{Binding LoadProjectCommand}" Content="Load" />
                                    <Button Command="{Binding SaveProjectCommand}" Content="Save" />
                                    <!-- TODO: disabled during the Channel canonical-model migration -
                                         CpsCsvImporter builds against the old string-based ChannelEntry
                                         shape; reconnect once it's updated for the new typed model. -->
                                    <Button Command="{Binding ImportChannelsCommand}" Content="Import Ch" IsEnabled="False" />
                                    <Button Command="{Binding ImportZonesCommand}" Content="Import Zn" IsEnabled="False" />
                                </WrapPanel>
                                <TextBlock Text="{Binding LastChannelImportLocation}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LastZoneImportLocation}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsExportsViewSelected}" Spacing="12">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="SectionTitle" Text="Exports" />
                                <!-- TODO: disabled during the Channel canonical-model migration -
                                     CpsCsvExporter.BuildChannelCsv/BuildZoneCsv now throw
                                     NotSupportedException; reconnect once they're updated for the
                                     new typed ChannelEntry. -->
                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding RefreshExportCommand}" Content="Refresh" IsEnabled="False" />
                                    <Button Command="{Binding SaveExportCommand}" Content="Export" IsEnabled="False" />
                                </WrapPanel>
                                <TextBlock Text="{Binding DataStoreDescription}" Foreground="{DynamicResource AppSubtleTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ExportDirectory}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsSettingsViewSelected}" Spacing="12">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="SectionTitle" Text="Settings" />
                                <HeaderedContentControl Header="Theme">
                                    <ComboBox ItemsSource="{Binding ThemeModes}"
                                              SelectedItem="{Binding SelectedThemeMode}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Export folder">
                                    <TextBlock Text="{Binding ExportDirectory}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
                                </HeaderedContentControl>
                                <Button Command="{Binding ChooseExportDirectoryCommand}" Content="Choose export folder" />
                                <HeaderedContentControl Header="Version">
                                    <TextBlock Text="{Binding AppVersion}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="NativeAOT">
                                    <TextBlock Text="{Binding NativeAotDescription}" />
                                </HeaderedContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Dev-only diagnostics, split out of Settings 2026-08-07
                         - see MainView.axaml's own Dev Options section for
                         the same rationale (build/runtime info, not
                         something a radio operator needs day-to-day). -->
                    <StackPanel IsVisible="{Binding IsDevOptionsViewSelected}" Spacing="12">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <TextBlock Classes="SectionTitle" Text="Dev Options" />
                                <HeaderedContentControl Header="Version">
                                    <TextBlock Text="{Binding AppVersion}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="NativeAOT">
                                    <TextBlock Text="{Binding NativeAotDescription}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Project File">
                                    <TextBlock Text="{Binding CurrentProjectLocation}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Settings File">
                                    <TextBlock Text="{Binding SettingsFileLocation}" Foreground="{DynamicResource AppMutedTextBrush}" TextWrapping="Wrap" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Appdata">
                                    <TextBlock Text="{Binding AppDataLocation}" Foreground="{DynamicResource AppSubtleTextBrush}" TextWrapping="Wrap" />
                                </HeaderedContentControl>

                                <!-- TEMPORARY - added 2026-08-16 for one live
                                     hardware test, remove along with
                                     DevForceModelToImageCommand after that
                                     test. See MainView.axaml's own Dev
                                     Options section for the same button. -->
                                <Button Content="Force Model → Image (mark everything dirty)"
                                        Command="{Binding DevForceModelToImageCommand}"
                                        ToolTip.Tip="Marks every loaded entity dirty using its own current values, so Write to Radio re-encodes everything instead of only what changed. Use right after a Read From Radio." />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAboutViewSelected}" Spacing="12">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <Image x:Name="AboutLogoImage"
                                       Width="80" Height="80"
                                       HorizontalAlignment="Center" />
                                <TextBlock Text="AnyToneCPS"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Open-source codeplug editor for the AnyTone D890UV DMR radio."
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                                <Border BorderBrush="{DynamicResource AppHeaderBorderBrush}"
                                        BorderThickness="0,1,0,0"
                                        Margin="0,4,0,0" />
                                <TextBlock Text="License" FontWeight="SemiBold" />
                                <TextBlock Text="AnyToneCPS is licensed under the MIT License."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Copyright (c) 2026 Etherghost"
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Source" FontWeight="SemiBold" />
                                <SelectableTextBlock Text="https://github.com/EtherGhost/AnyToneCPS"
                                                     Foreground="{DynamicResource AppMutedTextBrush}"
                                                     TextWrapping="Wrap" />
                                <TextBlock Text="Disclaimer" FontWeight="SemiBold" />
                                <TextBlock Text="AnyToneCPS is not affiliated with, endorsed by, or sponsored by AnyTone Tech Co., Ltd. or the AnyTone brand. AnyTone is a trademark of its respective owner. This project was built by reverse-engineering the radio's own USB protocol against real hardware."
                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel></Grid>

                <Border x:Name="InputPaneSpacer"
                        Grid.Row="2"
                        Height="0" />
            </Grid>
        </ScrollViewer>
        <Border x:Name="EditorNavigationBar"
                Grid.Row="2"
                Background="{DynamicResource AppHeaderBackgroundBrush}"
                BorderBrush="{DynamicResource AppHeaderBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12"
                IsVisible="False">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Content="Back" Click="EditorBack_OnClick" />
                <Button Grid.Column="1" Content="Prev" Click="EditorPrevious_OnClick" />
                <Button Grid.Column="2" Content="Next" Click="EditorNext_OnClick" />
            </Grid>
        </Border>
    </Grid>

    <!-- Safety-critical startup popup, added 2026-07-30, user-requested -
         see OptionalSettingsEntry.IsVoxOn's doc comment for the hazard this
         warns about. Shown once per launch (unless "Don't show again" is
         checked), auto-dismisses after 8s (MainViewModel.LoadAppSettingsAsync),
         sits in this outer Grid's shared cell so it overlays RootGrid. -->
    <Border IsVisible="{Binding ShowVoxStartupWarning}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Margin="12,12,12,0"
            Background="{DynamicResource AppInfoBadgeBackgroundBrush}"
            BorderBrush="{DynamicResource AppErrorBrush}"
            BorderThickness="2"
            CornerRadius="8"
            Padding="14,10">
        <StackPanel Spacing="10">
            <TextBlock Text="Safety warning: turn VOX off before connecting the radio"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource AppInfoBadgeTextBrush}" />
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource AppInfoBadgeTextBrush}"
                       Text="If VOX is on, the radio can start transmitting on its own while connected to this device for programming. That can damage the device. Make sure VOX is off before connecting." />
            <CheckBox Content="Don't show again"
                      IsChecked="{Binding SuppressVoxStartupWarning}"
                      Foreground="{DynamicResource AppInfoBadgeTextBrush}" />
            <Button HorizontalAlignment="Right" Content="Close" Command="{Binding DismissVoxStartupWarningCommand}" />
        </StackPanel>
    </Border>

    <!-- Blocking busy overlay, added 2026-08-07 - shared by project
         load/save and radio read/write (see MainViewModel.
         IsBusyOverlayVisible's doc comment). Same technique as the VOX
         warning above, but covers the full screen and is not dismissible -
         these are all operations where editing fields mid-flight would be
         unsafe. -->
    <Border IsVisible="{Binding IsBusyOverlayVisible}"
            Background="#B0000000">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="220"
                MaxWidth="340"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24,20">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="180" />
                <TextBlock Text="{Binding BusyOverlayMessage}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           FontWeight="SemiBold" />
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</UserControl>
