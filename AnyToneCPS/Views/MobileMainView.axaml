<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AnyToneCPS.ViewModels"
             xmlns:models="using:AnyToneCPS.Models"
             xmlns:ti="clr-namespace:Avalonia.Input.TextInput;assembly=Avalonia.Base"
             xmlns:views="using:AnyToneCPS.Views"
             xmlns:converters="using:AnyToneCPS.Converters"
             mc:Ignorable="d"
             d:DesignWidth="390"
             d:DesignHeight="820"
             x:Class="AnyToneCPS.Views.MobileMainView"
             x:DataType="vm:MainViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="TextBlock.SectionTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppStrongTextBrush}" />
        </Style>
        <Style Selector="TextBlock.Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
            <!-- Small positive bottom margin separates the label from its
                 own control - HeaderedContentControl's template already
                 stacks Label/Content with no gap of its own. (Used to be a
                 negative bottom margin, left over from the pre-
                 HeaderedContentControl days when this label sat directly
                 above its control as a StackPanel sibling with its own
                 Spacing - that negative margin pulled the control up
                 underneath the label once every field moved to
                 HeaderedContentControl, confirmed 2026-08-15 via a real
                 on-device screenshot.) -->
            <Setter Property="Margin" Value="3,4,0,4" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="{DynamicResource AppPrimaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppHeaderTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppPrimaryButtonHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryButtonHoverBorderBrush}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="{DynamicResource AppDisabledBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppSubtleTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppDisabledBorderBrush}" />
        </Style>
        <Style Selector="Button.ClusterButton">
            <Setter Property="Width" Value="56" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppInputForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppInputBorderBrush}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.Panel">
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <!-- Hints the platform's on-screen keyboard to show a numeric
             layout (Android) - the actual character-blocking is done in
             code-behind via a Tunnel-phase TextInput handler, since this
             hint alone doesn't stop a physical/Bluetooth keyboard or paste. -->
        <Style Selector="TextBox.PinDigits">
            <Setter Property="ti:TextInputOptions.ContentType" Value="Number" />
        </Style>
        <Style Selector="Border.TypeBadge">
            <Setter Property="Background" Value="{DynamicResource AppTypeBadgeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppTypeBadgeBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinWidth" Value="34" />
        </Style>
        <Style Selector="Border.TypeBadge TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTypeBadgeTextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.InfoBadge">
            <Setter Property="Background" Value="{DynamicResource AppInfoBadgeBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppInfoBadgeBorderBrush}" />
        </Style>
        <Style Selector="Border.InfoBadge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppInfoBadgeTextBrush}" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppPanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AppSelectionBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppSelectionTextBrush}" />
        </Style>
        <Style Selector="WrapPanel > Button">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <!-- Touch-sized rows for the nav flyout's TreeView (default TreeViewItem
             density is desktop/mouse-oriented) - matches this file's own 44px
             MinHeight convention for Button/TextBox/ComboBox above. -->
        <Style Selector="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>
        <Style Selector="TreeViewItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TreeView Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="TreeView Button:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppSelectionBackgroundBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid TopLevel.AutoSafeAreaPadding="True">
    <Grid x:Name="RootGrid"
          Background="{DynamicResource AppRootBackgroundBrush}" RowDefinitions="Auto,*,Auto">
        <Border Background="{DynamicResource AppHeaderBackgroundBrush}"
                BorderBrush="{DynamicResource AppHeaderBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                <Button x:Name="NavigationButton" Content="☰" MinWidth="44">
                    <Button.Flyout>
                        <Flyout>
                            <Border Classes="Panel" Padding="8" MinWidth="250">
                                <StackPanel Spacing="8">
                                    <!-- Grouped nav, replacing the old flat 27-item ListBox
                                         (2026-07-28) - a real TreeView (same control Desktop uses,
                                         styled here with touch-sized rows - see the TreeViewItem style
                                         above), not the Expander-based version tried first and
                                         rejected. Bound to MainViewModel.MobileNavigationSections,
                                         which flattens NavigationTree's single "D890UV" wrapper away so
                                         its 5 categories (Common/DMR/Analog/APRS/Advanced) become
                                         top-level tree nodes directly. Leaf selection is handled by a
                                         Button inside the item template rather than TreeView's own
                                         SelectedItem, since only leaves (IsLeaf) should navigate -
                                         category headers just expand/collapse via TreeView's built-in
                                         arrow. Channel/Zone count badges the old list had were not
                                         carried over, matching the same call already made for
                                         Desktop's own TreeView migration - still visible on each
                                         entity's own page. -->
                                    <TreeView ItemsSource="{Binding MobileNavigationSections}" MaxHeight="480">
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:NavigationTreeNode">
                                                <Panel IsVisible="{Binding IsVisible}">
                                                    <Button Content="{Binding Title}"
                                                            IsVisible="{Binding IsLeaf}"
                                                            IsEnabled="{Binding IsEnabled}"
                                                            ToolTip.Tip="{Binding DisabledReason}"
                                                            Click="NavigationTreeLeaf_OnClick"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="4,10" />
                                                    <TextBlock Text="{Binding Title}"
                                                               IsVisible="{Binding HasChildren}"
                                                               FontWeight="SemiBold"
                                                               Padding="4,10"
                                                               Background="Transparent"
                                                               HorizontalAlignment="Stretch"
                                                               VerticalAlignment="Center"
                                                               Tapped="NavigationTreeHeader_OnTapped" />
                                                </Panel>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="AnyTone CPS"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppHeaderTextBrush}" />
                    <TextBlock Text="{Binding DirtyIndicator}"
                               Foreground="{DynamicResource AppMutedTextBrush}"
                               FontSize="12" />
                </StackPanel>
                <Button Grid.Column="2"
                        Command="{Binding LoadProjectCommand}"
                        Content="Load" />
                <Button Grid.Column="3"
                        Command="{Binding SaveProjectCommand}"
                        Content="Save" />
                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource AppStatusBrush}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,8,0,0" />
                <!-- Validation moved from a fixed bottom panel (2026-07-28) to a
                     tap-to-open Flyout, like the nav button above - the old panel
                     lived inside the page's outer ScrollViewer, below whatever tab
                     content was showing, forcing a scroll-within-a-scroll (its own
                     ListBox plus the outer page) just to see it. Placed under
                     Load/Save (not the title) per direct request. -->
                <Button Grid.Row="1"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Right"
                        MinHeight="0"
                        MinWidth="0"
                        Padding="8,3"
                        Margin="0,8,0,0"
                        FontSize="12"
                        Background="{DynamicResource AppInfoBadgeBackgroundBrush}"
                        Foreground="{DynamicResource AppInfoBadgeTextBrush}"
                        BorderBrush="{DynamicResource AppInfoBadgeBorderBrush}"
                        Content="{Binding ValidationSummary, StringFormat='Validation: {0}'}">
                    <Button.Flyout>
                        <Flyout>
                            <Border Classes="Panel" Padding="8" MaxWidth="320">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Validation" />
                                    <ListBox MaxHeight="360" ItemsSource="{Binding ValidationMessages}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Margin="8,5" Foreground="{DynamicResource AppErrorBrush}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer x:Name="MainScrollViewer"
                      Grid.Row="1"
                      ScrollViewer.BringIntoViewOnFocusChange="True">
            <Grid x:Name="ScrollableContent"
                  Margin="12"
                  RowDefinitions="*,Auto,Auto">
                <Grid>
                    <StackPanel IsVisible="{Binding IsChannelsViewSelected}" Spacing="12">
                        <Border Classes="Panel">
                            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                                <!-- ChannelSelectionCountText/ChannelSelectionCancelButton are
                                     hidden until a long-press on a channel row enters selection
                                     mode (MobileMainView.axaml.cs's EnterChannelSelectionMode) -
                                     the touch equivalent of Desktop's Ctrl/Shift-click. This row
                                     already has just enough width for 3 buttons on a phone screen
                                     (nothing here wraps or clips, so a 4th one runs off the right
                                     edge - confirmed live, twice) - Cancel REPLACES "+" (Grid.Column
                                     is a plain StackPanel row with no wrap, not "*,Auto" with a
                                     bounded remainder) rather than adding a 4th, so the button
                                     count in this row never exceeds 3. -->
                                <Grid x:Name="ChannelListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="ChannelListTitle"
                                               Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding ChannelCount, StringFormat='Channels ({0})'}" />
                                    <TextBlock x:Name="ChannelSelectionCountText"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource AppMutedTextBrush}"
                                               Text="{Binding SelectedChannels.Count, StringFormat='{}{0} selected'}"
                                               IsVisible="False" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="ChannelAddButton" Margin="8,0,0,0" Classes="ClusterButton" Command="{Binding AddChannelCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Classes="ClusterButton" Command="{Binding DuplicateChannelCommand}" Content="Copy" />
                                        <Button Margin="8,0,0,0" Classes="ClusterButton" Command="{Binding RemoveChannelCommand}" Content="Del" />
                                        <Button x:Name="ChannelSelectionCancelButton"
                                                Margin="8,0,0,0"
                                                Classes="ClusterButton"
                                                Content="Done"
                                                Click="ChannelSelectionCancel_OnClick"
                                                IsVisible="False" />
                                    </StackPanel>
                                </Grid>
                                <!-- Long-press pointer handlers are wired up in code-behind with
                                     Tunnel routing (MobileMainView's constructor), not as XAML
                                     attributes here - a plain XAML PointerPressed="..." attaches
                                     on Bubble, and ListBoxItem's own built-in press handling (it
                                     marks the event Handled to run its selection/click logic) would
                                     already have consumed it by the time it bubbled back up to this
                                     ListBox, so the long-press timer would never start. -->
                                <ListBox x:Name="ChannelList"
                                         Grid.Row="1"
                                         MaxHeight="900"
                                         ItemsSource="{Binding Channels}"
                                         SelectedItem="{Binding SelectedChannel}"
                                         Tapped="ChannelList_OnTapped"
                                         SelectionChanged="ChannelList_OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChannelEntry">
                                            <Grid Margin="8,7"
                                                  ColumnDefinitions="*,Auto,Auto"
                                                  RowDefinitions="Auto,Auto"
                                                  ColumnSpacing="8">
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1"
                                                        Classes="TypeBadge InfoBadge"
                                                        IsVisible="{Binding HasInfoBadge}"
                                                        ToolTip.Tip="{Binding InfoBadgeToolTip}">
                                                    <TextBlock Text="{Binding InfoBadge}" />
                                                </Border>
                                                <Border Grid.Column="2" Classes="TypeBadge">
                                                    <TextBlock Text="{Binding TypeBadge}" />
                                                </Border>
                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="3"
                                                           Text="{Binding FrequencyLabel}"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid x:Name="ChannelEditorHeader"
                                      Grid.Row="2"
                                      ColumnDefinitions="*"
                                      ColumnSpacing="8"
                                      IsVisible="False">
                                    <TextBlock Text="{Binding SelectedChannel.DisplayLabel}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TabControl x:Name="ChannelEditorTabs"
                                            Grid.Row="3"
                                            IsVisible="False">
                                    <TabItem Header="Common">
                                        <StackPanel Spacing="10" Margin="4">
                                            <HeaderedContentControl Header="No">
                                                <TextBox Text="{Binding SelectedChannel.Number}"
                                                         views:DigitOnlyInput.Enabled="True"
                                                         views:DigitOnlyInput.MaxValue="4000"
                                                         FontWeight="{Binding SelectedChannel.NumberFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Name">
                                                <TextBox Text="{Binding SelectedChannel.Name}"
                                                         MaxLength="16"
                                                         views:AsciiTextInput.Enabled="True"
                                                         FontWeight="{Binding SelectedChannel.NameFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="RX (MHz)">
                                                <TextBox Text="{Binding SelectedChannel.RxFrequencyMHzText}"
                                                         MaxLength="9"
                                                         views:DigitOnlyInput.Enabled="True"
                                                         views:DigitOnlyInput.AllowDecimalPoint="True"
                                                         views:DigitOnlyInput.MaxValue="480"
                                                         FontWeight="{Binding SelectedChannel.ReceiveFrequencyFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="TX (MHz)">
                                                <TextBox Text="{Binding SelectedChannel.TransmitFrequencyMHzText}"
                                                         MaxLength="9"
                                                         views:DigitOnlyInput.Enabled="True"
                                                         views:DigitOnlyInput.AllowDecimalPoint="True"
                                                         views:DigitOnlyInput.MaxValue="480"
                                                         FontWeight="{Binding SelectedChannel.TransmitFrequencyFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Correct Frequency Hz" ToolTip.Tip="Steps of 10 Hz (0-1250 Hz).">
                                                <TextBox Text="{Binding SelectedChannel.CorrectFrequencyHzText}"
                                                         views:DigitOnlyInput.Enabled="True"
                                                         views:DigitOnlyInput.MaxValue="1250"
                                                         FontWeight="{Binding SelectedChannel.CorrectFrequencyHzFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Type">
                                                <ComboBox ItemsSource="{Binding ChannelTypes}"
                                                          SelectedItem="{Binding SelectedChannel.ChannelTypeSelection}"
                                                          FontWeight="{Binding SelectedChannel.ChannelTypeFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Power">
                                                <ComboBox ItemsSource="{Binding TransmitPowers}"
                                                          SelectedItem="{Binding SelectedChannel.TransmitPowerSelection}"
                                                          FontWeight="{Binding SelectedChannel.TransmitPowerFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Bandwidth" IsEnabled="{Binding SelectedChannel.CanUseBandwidth}">
                                                <ComboBox ItemsSource="{Binding Bandwidths}"
                                                          SelectedItem="{Binding SelectedChannel.BandwidthSelection}"
                                                          FontWeight="{Binding SelectedChannel.BandwidthFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="{Binding BusyLockTxPermitHeaderText}">
                                                <ComboBox ItemsSource="{Binding BusyLockTxPermitValues}"
                                                          SelectedItem="{Binding SelectedChannel.BusyLockTxPermitSelection}"
                                                          FontWeight="{Binding SelectedChannel.BusyLockTxPermitFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Scan List">
                                                <ComboBox ItemsSource="{Binding ScanListOptions}"
                                                          SelectedItem="{Binding SelectedChannelScanListName}" />
                                            </HeaderedContentControl>
                                            <CheckBox Content="Talk Around"
                                                      IsChecked="{Binding SelectedChannel.TalkAround}"
                                                      FontWeight="{Binding SelectedChannel.TalkAroundFontWeight}" />
                                            <CheckBox Content="PTT Prohibit"
                                                      IsChecked="{Binding SelectedChannel.PttProhibit}"
                                                      FontWeight="{Binding SelectedChannel.PttProhibitFontWeight}" />
                                            <CheckBox Content="Auto Scan"
                                                      IsChecked="{Binding SelectedChannel.AutoScan}"
                                                      FontWeight="{Binding SelectedChannel.AutoScanFontWeight}" />
                                            <CheckBox Content="Work Alone"
                                                      IsChecked="{Binding SelectedChannel.WorkAlone}"
                                                      FontWeight="{Binding SelectedChannel.WorkAloneFontWeight}" />
                                            <CheckBox Content="Data ACK Disable"
                                                      IsChecked="{Binding SelectedChannel.DataAckDisable}"
                                                      FontWeight="{Binding SelectedChannel.DataAckDisableFontWeight}" />
                                            <CheckBox Content="Exclude Channel From Roaming"
                                                      IsChecked="{Binding SelectedChannel.ExcludeChannelRoaming}"
                                                      FontWeight="{Binding SelectedChannel.ExcludeChannelRoamingFontWeight}" />
                                            <CheckBox Content="Idle TX"
                                                      IsChecked="{Binding SelectedChannel.IdleTx}"
                                                      FontWeight="{Binding SelectedChannel.IdleTxFontWeight}" />
                                            <HeaderedContentControl Header="Custom CTCSS (Hz)" IsVisible="{Binding SelectedChannel.HasAnalogCapability}">
                                                <TextBox Text="{Binding SelectedChannel.CustomCtcssText}"
                                                         views:DigitOnlyInput.Enabled="True"
                                                         views:DigitOnlyInput.AllowDecimalPoint="True"
                                                         views:DigitOnlyInput.MaxValue="260"
                                                         FontWeight="{Binding SelectedChannel.CustomCtcssFontWeight}" />
                                            </HeaderedContentControl>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Analog" IsVisible="{Binding SelectedChannel.HasAnalogCapability}">
                                        <StackPanel Spacing="10" Margin="4">
                                            <StackPanel IsEnabled="{Binding SelectedChannel.CanUseReverse}">
                                                <CheckBox Content="Reverse"
                                                          IsChecked="{Binding SelectedChannel.Reverse}"
                                                          FontWeight="{Binding SelectedChannel.ReverseFontWeight}" />
                                            </StackPanel>
                                            <CheckBox Content="Compand"
                                                      IsEnabled="False"
                                                      ToolTip.Tip="Confirmed non-functional on this radio - the real vendor CPS itself reverts this checkbox to unchecked as soon as you leave the channel's edit mode, so there's nothing to write. See RESUME_HERE.md, 2026-08-01." />
                                            <HeaderedContentControl Header="CTCSS Decode">
                                                <ComboBox ItemsSource="{Binding CtcssDcsModes}"
                                                          SelectedItem="{Binding SelectedChannel.CtcssDecodeSelection}"
                                                          FontWeight="{Binding SelectedChannel.CtcssDecodeFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Decode Tone" IsVisible="{Binding SelectedChannel.IsDecodeToneVisible}">
                                                <ComboBox ItemsSource="{Binding SelectedChannel.DecodeToneOptions}"
                                                          SelectedItem="{Binding SelectedChannel.DecodeToneSelection}"
                                                          ToolTip.Tip="CTCSS tone or DCS code, depending on CTCSS Decode's mode. 'Custom CTCSS' is shown for reference but not selectable - its raw value on the wire isn't confirmed."
                                                          FontWeight="{Binding SelectedChannel.DecodeToneFontWeight}">
                                                    <ComboBox.Styles>
                                                        <Style Selector="ComboBoxItem">
                                                            <Setter Property="IsEnabled">
                                                                <Setter.Value>
                                                                    <Binding Converter="{x:Static converters:DisabledWhenEqualsConverter.Instance}" ConverterParameter="Custom CTCSS" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ComboBox.Styles>
                                                </ComboBox>
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="CTCSS Encode">
                                                <ComboBox ItemsSource="{Binding CtcssDcsModes}"
                                                          SelectedItem="{Binding SelectedChannel.CtcssEncodeSelection}"
                                                          FontWeight="{Binding SelectedChannel.CtcssEncodeFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Encode Tone" IsVisible="{Binding SelectedChannel.IsEncodeToneVisible}">
                                                <ComboBox ItemsSource="{Binding SelectedChannel.EncodeToneOptions}"
                                                          SelectedItem="{Binding SelectedChannel.EncodeToneSelection}"
                                                          ToolTip.Tip="CTCSS tone or DCS code, depending on CTCSS Encode's mode. 'Custom CTCSS' is shown for reference but not selectable - its raw value on the wire isn't confirmed."
                                                          FontWeight="{Binding SelectedChannel.EncodeToneFontWeight}">
                                                    <ComboBox.Styles>
                                                        <Style Selector="ComboBoxItem">
                                                            <Setter Property="IsEnabled">
                                                                <Setter.Value>
                                                                    <Binding Converter="{x:Static converters:DisabledWhenEqualsConverter.Instance}" ConverterParameter="Custom CTCSS" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ComboBox.Styles>
                                                </ComboBox>
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Squelch Mode">
                                                <ComboBox ItemsSource="{Binding AnalogSquelchModes}"
                                                          SelectedItem="{Binding SelectedChannel.SquelchModeSelection}"
                                                          FontWeight="{Binding SelectedChannel.SquelchModeFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Optional Signal" IsVisible="{Binding SelectedChannel.IsAnalog}">
                                                <ComboBox ItemsSource="{Binding OptionalSignals}"
                                                          SelectedItem="{Binding SelectedChannel.OptionalSignalSelection}"
                                                          FontWeight="{Binding SelectedChannel.OptionalSignalFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="DTMF ID" IsEnabled="{Binding SelectedChannel.IsOptionalSignalDtmf}" IsVisible="{Binding SelectedChannel.IsAnalog}" ToolTip.Tip="Only usable when Optional Signal is set to DTMF.">
                                                <ComboBox ItemsSource="{Binding DtmfIds}"
                                                          SelectedItem="{Binding SelectedChannel.DtmfIdSelection}"
                                                          FontWeight="{Binding SelectedChannel.DtmfIdIndexFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="2Tone ID" IsEnabled="{Binding SelectedChannel.IsOptionalSignalTwoTone}" IsVisible="{Binding SelectedChannel.IsAnalog}" ToolTip.Tip="Only usable when Optional Signal is set to 2Tone.">
                                                <ComboBox ItemsSource="{Binding Tone2Ids}"
                                                          SelectedItem="{Binding SelectedChannel.Tone2IdSelection}"
                                                          FontWeight="{Binding SelectedChannel.Tone2IdIndexFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="5Tone ID" IsEnabled="{Binding SelectedChannel.IsOptionalSignalFiveTone}" IsVisible="{Binding SelectedChannel.IsAnalog}" ToolTip.Tip="Only usable when Optional Signal is set to 5Tone.">
                                                <ComboBox ItemsSource="{Binding Tone5Ids}"
                                                          SelectedItem="{Binding SelectedChannel.Tone5IdSelection}"
                                                          FontWeight="{Binding SelectedChannel.Tone5IdIndexFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="2Tone Decode" IsEnabled="{Binding SelectedChannel.IsOptionalSignalTwoTone}" IsVisible="{Binding SelectedChannel.IsAnalog}" ToolTip.Tip="Only usable when Optional Signal is set to 2Tone.">
                                                <ComboBox ItemsSource="{Binding Tone2DecodeOptions}"
                                                          SelectedItem="{Binding SelectedChannel.Tone2DecodeSelection}"
                                                          FontWeight="{Binding SelectedChannel.Tone2DecodeFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="5Tone Bot" IsEnabled="{Binding SelectedChannel.IsOptionalSignalFiveTone}" IsVisible="{Binding SelectedChannel.IsAnalog}" ToolTip.Tip="Only usable when Optional Signal is set to 5Tone.">
                                                <ComboBox ItemsSource="{Binding R5ToneOptions}"
                                                          SelectedItem="{Binding SelectedChannel.R5ToneBotSelection}"
                                                          FontWeight="{Binding SelectedChannel.R5ToneBotFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="5Tone Eot" IsEnabled="{Binding SelectedChannel.IsOptionalSignalFiveTone}" IsVisible="{Binding SelectedChannel.IsAnalog}" ToolTip.Tip="Only usable when Optional Signal is set to 5Tone.">
                                                <ComboBox ItemsSource="{Binding R5ToneOptions}"
                                                          SelectedItem="{Binding SelectedChannel.R5ToneEotSelection}"
                                                          FontWeight="{Binding SelectedChannel.R5ToneEotFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="QDC1200 ID" IsEnabled="{Binding SelectedChannel.IsOptionalSignalQdc1200}" IsVisible="{Binding SelectedChannel.IsAnalog}" ToolTip.Tip="Only usable when Optional Signal is set to QDC1200.">
                                                <ComboBox ItemsSource="{Binding QdcIds}"
                                                          SelectedItem="{Binding SelectedChannel.QdcIdSelection}"
                                                          FontWeight="{Binding SelectedChannel.QdcIdIndexFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="PTT ID">
                                                <ComboBox ItemsSource="{Binding PttIds}"
                                                          SelectedItem="{Binding SelectedChannel.PttIdSelection}"
                                                          FontWeight="{Binding SelectedChannel.PttIdFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Scramble Set">
                                                <ComboBox ItemsSource="{Binding ScrambleValues}"
                                                          SelectedItem="{Binding SelectedChannel.ScrambleModeSelection}"
                                                          FontWeight="{Binding SelectedChannel.ScrambleFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Custom Scrambler" IsEnabled="{Binding SelectedChannel.IsCustomScramble}">
                                                <ComboBox ItemsSource="{Binding CustomScramblerValues}"
                                                          SelectedItem="{Binding SelectedChannel.CustomScramblerSelection}"
                                                          FontWeight="{Binding SelectedChannel.ScrambleFrequencyFontWeight}" />
                                            </HeaderedContentControl>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem Header="Digital" IsVisible="{Binding SelectedChannel.IsDigital}">
                                        <StackPanel Spacing="10" Margin="4">
                                            <HeaderedContentControl Header="DMR Mode"
                                                                     ToolTip.Tip="Only applies in simplex mode - doesn't affect whether the channel is repeater or simplex.">
                                                <ComboBox ItemsSource="{Binding DmrModes}"
                                                          SelectedItem="{Binding SelectedChannel.DmrModeSelection}"
                                                          FontWeight="{Binding SelectedChannel.DmrModeFontWeight}" />
                                            </HeaderedContentControl>
                                            <CheckBox Content="Slot Suit"
                                                      IsChecked="{Binding SelectedChannel.SlotSuit}"
                                                      FontWeight="{Binding SelectedChannel.SlotSuitFontWeight}" />
                                            <CheckBox Content="Call Confirmation"
                                                      IsChecked="{Binding SelectedChannel.CallConfirmation}"
                                                      FontWeight="{Binding SelectedChannel.CallConfirmationFontWeight}" />
                                            <CheckBox Content="DMR CRC Ignore"
                                                      IsChecked="{Binding SelectedChannel.DmrCrcIgnore}"
                                                      FontWeight="{Binding SelectedChannel.DmrCrcIgnoreFontWeight}" />
                                            <CheckBox Content="Send Talker Alias"
                                                      IsChecked="{Binding SelectedChannel.SendTalkerAlias}"
                                                      FontWeight="{Binding SelectedChannel.SendTalkerAliasFontWeight}" />
                                            <CheckBox Content="SMS Forbid"
                                                      IsChecked="{Binding SelectedChannel.SmsForbid}"
                                                      FontWeight="{Binding SelectedChannel.SmsForbidFontWeight}" />
                                            <CheckBox Content="APRS RX"
                                                      IsChecked="{Binding SelectedChannel.AprsRx}"
                                                      FontWeight="{Binding SelectedChannel.AprsRxFontWeight}" />
                                            <CheckBox Content="Ranging"
                                                      IsChecked="{Binding SelectedChannel.Ranging}"
                                                      FontWeight="{Binding SelectedChannel.RangingFontWeight}" />
                                            <CheckBox Content="SMS Confirmation"
                                                      IsChecked="{Binding SelectedChannel.SmsConfirmation}"
                                                      FontWeight="{Binding SelectedChannel.SmsConfirmationFontWeight}" />
                                            <HeaderedContentControl Header="Contact">
                                                <ComboBox ItemsSource="{Binding ContactOptions}"
                                                          SelectedItem="{Binding SelectedChannelContactName}"
                                                          FontWeight="{Binding SelectedChannel.ContactFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Radio ID">
                                                <ComboBox ItemsSource="{Binding RadioIdOptions}"
                                                          SelectedItem="{Binding SelectedChannelRadioIdName}"
                                                          FontWeight="{Binding SelectedChannel.RadioIdFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="RX Color Code">
                                                <ComboBox ItemsSource="{Binding ColorCodeOptions}"
                                                          SelectedItem="{Binding SelectedChannel.ColorCodeText}"
                                                          FontWeight="{Binding SelectedChannel.ColorCodeFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="TX Color Code">
                                                <ComboBox ItemsSource="{Binding ColorCodeOptions}"
                                                          SelectedItem="{Binding SelectedChannel.TxColorCodeText}"
                                                          FontWeight="{Binding SelectedChannel.TxColorCodeFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Slot">
                                                <ComboBox ItemsSource="{Binding RepeaterSlots}"
                                                          SelectedItem="{Binding SelectedChannel.RepeaterSlotText}"
                                                          FontWeight="{Binding SelectedChannel.RepeaterSlotFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Receive Group">
                                                <ComboBox ItemsSource="{Binding ReceiveGroupListOptions}"
                                                          SelectedItem="{Binding SelectedChannelReceiveGroupListName}"
                                                          FontWeight="{Binding SelectedChannel.ReceiveGroupListFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Digital Key"
                                                                     IsVisible="{Binding !OptionalSettings.IsAesArc4EncryptionTypeSelected}"
                                                                     ToolTip.Tip="Only usable when Optional Settings' Encryption Type is set to Basic (not AES/ARC4).">
                                                <ComboBox ItemsSource="{Binding DigitalEncryptionKeyOptions}"
                                                          SelectedItem="{Binding SelectedChannel.DigitalEncryptionText}"
                                                          FontWeight="{Binding SelectedChannel.DigitalEncryptionFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="AES Key"
                                                                     ToolTip.Tip="Only usable when Optional Settings' Encryption Type is set to AES/ARC4 and Extended Encryption is AES.">
                                                <HeaderedContentControl.IsVisible>
                                                    <MultiBinding Converter="{x:Static converters:EncryptionKeyVisibilityConverter.Instance}" ConverterParameter="False">
                                                        <Binding Path="OptionalSettings.IsAesArc4EncryptionTypeSelected" />
                                                        <Binding Path="SelectedChannel.ExtendEncryption" />
                                                    </MultiBinding>
                                                </HeaderedContentControl.IsVisible>
                                                <ComboBox ItemsSource="{Binding AesEncryptionKeyOptions}"
                                                          SelectedItem="{Binding SelectedChannel.AesDigitalEncryptionText}"
                                                          FontWeight="{Binding SelectedChannel.AesDigitalEncryptionFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="ARC4 Key"
                                                                     ToolTip.Tip="Only usable when Optional Settings' Encryption Type is set to AES/ARC4 and Extended Encryption is ARC4.">
                                                <HeaderedContentControl.IsVisible>
                                                    <MultiBinding Converter="{x:Static converters:EncryptionKeyVisibilityConverter.Instance}" ConverterParameter="True">
                                                        <Binding Path="OptionalSettings.IsAesArc4EncryptionTypeSelected" />
                                                        <Binding Path="SelectedChannel.ExtendEncryption" />
                                                    </MultiBinding>
                                                </HeaderedContentControl.IsVisible>
                                                <ComboBox ItemsSource="{Binding Arc4EncryptionKeyOptions}"
                                                          SelectedItem="{Binding SelectedChannel.Arc4EncryptionText}"
                                                          FontWeight="{Binding SelectedChannel.Arc4EncryptionFontWeight}" />
                                            </HeaderedContentControl>
                                            <HeaderedContentControl Header="Extended Encryption"
                                                                     IsEnabled="{Binding OptionalSettings.IsAesArc4EncryptionTypeSelected}"
                                                                     ToolTip.Tip="Only usable when Optional Settings' Encryption Type is set to AES/ARC4.">
                                                <ComboBox ItemsSource="{Binding ExtendEncryptionOptions}"
                                                          SelectedItem="{Binding SelectedChannel.ExtendEncryptionSelection}"
                                                          FontWeight="{Binding SelectedChannel.ExtendEncryptionFontWeight}" />
                                            </HeaderedContentControl>
                                            <StackPanel>
                                                <StackPanel.IsVisible>
                                                    <MultiBinding Converter="{x:Static converters:EncryptionKeyVisibilityConverter.Instance}" ConverterParameter="False">
                                                        <Binding Path="OptionalSettings.IsAesArc4EncryptionTypeSelected" />
                                                        <Binding Path="SelectedChannel.ExtendEncryption" />
                                                    </MultiBinding>
                                                </StackPanel.IsVisible>
                                                <CheckBox Content="AES Multiple Key"
                                                          IsChecked="{Binding SelectedChannel.AesMultipleKey}"
                                                          IsEnabled="{Binding OptionalSettings.IsAesArc4EncryptionTypeSelected}"
                                                          FontWeight="{Binding SelectedChannel.AesMultipleKeyFontWeight}" />
                                                <CheckBox Content="AES Random Key"
                                                          IsChecked="{Binding SelectedChannel.AesRandomKey}"
                                                          IsEnabled="{Binding OptionalSettings.IsAesArc4EncryptionTypeSelected}"
                                                          FontWeight="{Binding SelectedChannel.AesRandomKeyFontWeight}" />
                                            </StackPanel>
                                            <HeaderedContentControl Header="TX Interrupt"
                                                                     ToolTip.Tip="'High priority' is shown for reference but not selectable - its raw value on the wire isn't confirmed yet, see RESUME_HERE.md.">
                                                <ComboBox ItemsSource="{Binding TxInterruptOptions}"
                                                          SelectedItem="{Binding SelectedChannel.TxInterruptSelection}"
                                                          FontWeight="{Binding SelectedChannel.TxInterruptFontWeight}">
                                                    <ComboBox.Styles>
                                                        <Style Selector="ComboBoxItem">
                                                            <Setter Property="IsEnabled">
                                                                <Setter.Value>
                                                                    <Binding Converter="{x:Static converters:DisabledWhenEqualsConverter.Instance}" ConverterParameter="High priority" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ComboBox.Styles>
                                                </ComboBox>
                                            </HeaderedContentControl>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsZonesViewSelected}" Spacing="12">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="ZoneListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding ZoneCount, StringFormat='Zoner ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddZoneCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveZoneCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="ZoneList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding Zones}"
                                         SelectedItem="{Binding SelectedZone}"
                                         Tapped="ZoneList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ZoneEntry">
                                            <Grid Margin="8,7"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Classes="TypeBadge">
                                                    <TextBlock Text="{Binding Members.Count}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="ZoneEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                <Grid ColumnDefinitions="*"
                                      ColumnSpacing="8">
                                    <TextBlock Text="{Binding SelectedZone.DisplayLabel}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <HeaderedContentControl Header="No">
                                    <TextBox Text="{Binding SelectedZone.Number}"
                                             FontWeight="{Binding SelectedZone.NumberFontWeight}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Zone Name">
                                    <TextBox Text="{Binding SelectedZone.Name}"
                                             MaxLength="16"
                                             views:AsciiTextInput.Enabled="True"
                                             FontWeight="{Binding SelectedZone.NameFontWeight}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="A Channel">
                                    <ComboBox ItemsSource="{Binding SelectedZoneMemberOptions}"
                                              SelectedItem="{Binding SelectedZoneAChannel}"
                                              FontWeight="{Binding SelectedZone.AChannelFontWeight}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ChannelEntry">
                                                <TextBlock Text="{Binding DisplayLabel}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="B Channel">
                                    <ComboBox ItemsSource="{Binding SelectedZoneMemberOptions}"
                                              SelectedItem="{Binding SelectedZoneBChannel}"
                                              FontWeight="{Binding SelectedZone.BChannelFontWeight}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ChannelEntry">
                                                <TextBlock Text="{Binding DisplayLabel}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </HeaderedContentControl>
                                <CheckBox IsChecked="{Binding SelectedZone.IsHidden}" Content="Hidden"
                                          FontWeight="{Binding SelectedZone.IsHiddenFontWeight}" />
                                <TextBlock Text="{Binding AvailableZoneChannels.Count, StringFormat='Available Channels ({0})'}"
                                           FontWeight="SemiBold" />
                                <ListBox x:Name="AvailableZoneChannelsList"
                                         MaxHeight="260"
                                         ItemsSource="{Binding AvailableZoneChannels}"
                                         SelectionMode="Multiple"
                                         SelectionChanged="AvailableZoneChannelsList_OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChannelEntry">
                                            <Grid Margin="8,7" RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding FrequencyLabel}"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Command="{Binding AddZoneMembersCommand}" Content="Add" />
                                    <Button Grid.Column="1" Command="{Binding RemoveZoneMembersCommand}" Content="Remove" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedZone.Members.Count, StringFormat='Added Channels ({0})'}"
                                           FontWeight="{Binding SelectedZone.MembersFontWeight}" />
                                <ListBox x:Name="ZoneMembersList"
                                         MaxHeight="260"
                                         ItemsSource="{Binding SelectedZone.Members}"
                                         SelectionMode="Multiple"
                                         SelectionChanged="ZoneMembersList_OnSelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChannelEntry">
                                            <Grid Margin="8,7" RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding FrequencyLabel}"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Command="{Binding MoveZoneMemberUpCommand}" Content="Up" />
                                    <Button Grid.Column="1" Command="{Binding MoveZoneMemberDownCommand}" Content="Down" />
                                </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsDigitalKeysViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="DigitalKeyListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding VisibleEncryptionKeys.Count, StringFormat='Digital Keys ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Classes="ClusterButton" Command="{Binding AddDigitalEncryptionKeyCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Classes="ClusterButton" Command="{Binding RemoveEncryptionKeyCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="DigitalKeyList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding VisibleEncryptionKeys}"
                                         SelectedItem="{Binding SelectedEncryptionKey}"
                                         Tapped="DigitalKeyList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:EncryptionKeyEntry">
                                            <Grid ColumnDefinitions="50,*" ColumnSpacing="8" Margin="4">
                                                <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding EncryptionIdText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="DigitalKeyEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedEncryptionKey.Number, StringFormat='Digital Key #{0}'}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedEncryptionKey.Number}" IsReadOnly="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Key">
                                        <TextBox Text="{Binding SelectedEncryptionKey.EncryptionKeyText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="ID">
                                        <TextBox Text="{Binding SelectedEncryptionKey.EncryptionIdText}"
                                                 MaxLength="4"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 ToolTip.Tip="Exactly 4 decimal digits" />
                                    </HeaderedContentControl>
                                    <Button Command="{Binding RegenerateDigitalEncryptionKeyCommand}"
                                            Content="Randomize"
                                            ToolTip.Tip="Replace this key's ID with a new random 4-digit value." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsArc4KeysViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="Arc4KeyListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding VisibleArc4EncryptionKeys.Count, StringFormat='ARC4 Keys ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Classes="ClusterButton" Command="{Binding AddArc4EncryptionKeyCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Classes="ClusterButton" Command="{Binding RemoveArc4EncryptionKeyCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="Arc4KeyList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding VisibleArc4EncryptionKeys}"
                                         SelectedItem="{Binding SelectedArc4EncryptionKey}"
                                         Tapped="Arc4KeyList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:EncryptionKeyEntry">
                                            <Grid ColumnDefinitions="50,*" ColumnSpacing="8" Margin="4">
                                                <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding EncryptionKeyText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="Arc4KeyEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedArc4EncryptionKey.Number, StringFormat='ARC4 Key #{0}'}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedArc4EncryptionKey.Number}" IsReadOnly="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="ID">
                                        <TextBox Text="{Binding SelectedArc4EncryptionKey.EncryptionIdText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Key">
                                        <TextBox Text="{Binding SelectedArc4EncryptionKey.EncryptionKeyText}"
                                                 MaxLength="10"
                                                 views:HexDigitInput.Enabled="True"
                                                 ToolTip.Tip="Up to 5 hex bytes (1-10 hex characters), or 'Off' - a shorter key is left-zero-padded to 5 bytes on write (confirmed 2026-07-20)." />
                                    </HeaderedContentControl>
                                    <Button Command="{Binding RegenerateArc4EncryptionKeyCommand}"
                                            Content="Randomize"
                                            ToolTip.Tip="Replace this key's value with a new random key." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAesKeysViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="AesKeyListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding VisibleAesEncryptionKeys.Count, StringFormat='AES Keys ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Classes="ClusterButton" Command="{Binding AddAesEncryptionKeyCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Classes="ClusterButton" Command="{Binding RemoveAesEncryptionKeyCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="AesKeyList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding VisibleAesEncryptionKeys}"
                                         SelectedItem="{Binding SelectedAesEncryptionKey}"
                                         Tapped="AesKeyList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:EncryptionKeyEntry">
                                            <Grid ColumnDefinitions="50,*" ColumnSpacing="8" Margin="4">
                                                <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding EncryptionIdText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="AesKeyEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedAesEncryptionKey.Number, StringFormat='AES Key #{0}'}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedAesEncryptionKey.Number}" IsReadOnly="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Key">
                                        <TextBox Text="{Binding SelectedAesEncryptionKey.EncryptionKeyText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="ID">
                                        <TextBox Text="{Binding SelectedAesEncryptionKey.EncryptionIdText}"
                                                 MaxLength="64"
                                                 views:HexDigitInput.Enabled="True"
                                                 ToolTip.Tip="Exactly 64 hex characters, or 'Off'" />
                                    </HeaderedContentControl>
                                    <Button Command="{Binding RegenerateAesEncryptionKeyCommand}"
                                            Content="Randomize"
                                            ToolTip.Tip="Replace this key's value with a new random key." />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsRadioIdListViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="RadioIdListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding RadioIdCount, StringFormat='Radio IDs ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddRadioIdCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveRadioIdCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="RadioIdList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding RadioIds}"
                                         SelectedItem="{Binding SelectedRadioId}"
                                         Tapped="RadioIdList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:RadioIdEntry">
                                            <Grid Margin="8,7"
                                                  ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="8">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="RadioIdEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedRadioId.Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedRadioId.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="250"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Radio ID">
                                        <TextBox Text="{Binding SelectedRadioId.DmrIdText}"
                                                 MaxLength="8"
                                                 views:DigitOnlyInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedRadioId.Name}"
                                                 MaxLength="17"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsTalkgroupsViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="TalkgroupListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding TalkgroupCount, StringFormat='Talkgroups ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddTalkgroupCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveTalkgroupCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="TalkgroupList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding Talkgroups}"
                                         SelectedItem="{Binding SelectedTalkgroup}"
                                         Tapped="TalkgroupList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TalkgroupEntry">
                                            <Grid Margin="8,7"
                                                  ColumnDefinitions="*,Auto"
                                                  RowDefinitions="Auto,Auto"
                                                  ColumnSpacing="8">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding CallType}"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="TalkgroupEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedTalkgroup.Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedTalkgroup.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="10000"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TG/DMR ID" IsEnabled="{Binding SelectedTalkgroup.IsAllCallFieldsEditable}">
                                        <TextBox Text="{Binding SelectedTalkgroup.DmrIdText}"
                                                 MaxLength="8"
                                                 views:DigitOnlyInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedTalkgroup.Name}"
                                                 MaxLength="16"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Type">
                                        <ComboBox ItemsSource="{Binding SelectedTalkgroup.CallTypeOptions}"
                                                  SelectedItem="{Binding SelectedTalkgroup.CallType}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Alert" IsEnabled="{Binding SelectedTalkgroup.IsAllCallFieldsEditable}">
                                        <ComboBox ItemsSource="{Binding SelectedTalkgroup.CallAlertOptions}"
                                                  SelectedItem="{Binding SelectedTalkgroup.CallAlert}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsScanListsViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="ScanListListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding ScanListCount, StringFormat='Scan Lists ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddScanListCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveScanListCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="ScanListList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding ScanLists}"
                                         SelectedItem="{Binding SelectedScanList}"
                                         Tapped="ScanListList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ScanListEntry">
                                            <Grid Margin="8,7" RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding DisplayLabel}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Members.Count, StringFormat='{}{0} channels'}"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="ScanListEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedScanList.DisplayLabel}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedScanList.Number}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedScanList.Name}"
                                                 views:AsciiTextInput.Enabled="True"
                                                 FontWeight="{Binding SelectedScanList.NameFontWeight}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Priority Channel Select"
                                                             ToolTip.Tip="Confirmed 2026-07-19 via vendor CPS help text and a live differential test.">
                                        <ComboBox ItemsSource="{Binding SelectedScanList.PriorityChannelSelectOptions}"
                                                  SelectedItem="{Binding SelectedScanList.PriorityChannelSelectText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Revert Channel"
                                                             ToolTip.Tip="Labels confirmed 2026-07-19 via vendor CPS help text (topic 67) - not yet independently live-write-tested for every value.">
                                        <ComboBox ItemsSource="{Binding SelectedScanList.RevertChannelOptions}"
                                                  SelectedItem="{Binding SelectedScanList.RevertChannelText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Priority Channel 1">
                                        <ComboBox ItemsSource="{Binding SelectedScanList.PriorityChannelOptions}"
                                                  SelectedItem="{Binding SelectedScanList.PriorityChannel1Text}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Priority Channel 2">
                                        <ComboBox ItemsSource="{Binding SelectedScanList.PriorityChannelOptions}"
                                                  SelectedItem="{Binding SelectedScanList.PriorityChannel2Text}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Lookback Time A [s]">
                                        <ComboBox ItemsSource="{Binding SelectedScanList.LookBackTimeOptions}"
                                                  SelectedItem="{Binding SelectedScanList.LookbackTimeAText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Lookback Time B [s]">
                                        <ComboBox ItemsSource="{Binding SelectedScanList.LookBackTimeOptions}"
                                                  SelectedItem="{Binding SelectedScanList.LookbackTimeBText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Dropout Delay Time [s]">
                                        <ComboBox ItemsSource="{Binding SelectedScanList.DropoutDelayDwellTimeOptions}"
                                                  SelectedItem="{Binding SelectedScanList.DropoutDelayTimeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Dwell Time [s]">
                                        <ComboBox ItemsSource="{Binding SelectedScanList.DropoutDelayDwellTimeOptions}"
                                                  SelectedItem="{Binding SelectedScanList.DwellTimeText}" />
                                    </HeaderedContentControl>

                                    <!-- Scan list member picker - added 2026-07-29, moved inside
                                         the editor panel 2026-08-07 alongside the rest of this
                                         entity's move to list-then-detail navigation. Operates on
                                         whatever list is currently selected (SelectedScanList),
                                         same dual-list pattern as the Zone member picker. -->
                                    <TextBlock Text="{Binding AvailableScanListChannels.Count, StringFormat='Available channels ({0})'}"
                                               FontWeight="SemiBold" />
                                    <ListBox x:Name="AvailableScanListChannelsList"
                                             MaxHeight="260"
                                             ItemsSource="{Binding AvailableScanListChannels}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="AvailableScanListChannelsList_OnSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ChannelEntry">
                                                <TextBlock Margin="8,7" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Command="{Binding AddScanListMembersCommand}" Content="Add" />
                                        <Button Grid.Column="1" Command="{Binding RemoveScanListMembersCommand}" Content="Remove" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedScanList.Members.Count, StringFormat='Scan channel members ({0})'}"
                                               FontWeight="{Binding SelectedScanList.MembersFontWeight}" />
                                    <ListBox x:Name="ScanListMembersList"
                                             MaxHeight="260"
                                             ItemsSource="{Binding SelectedScanList.Members}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="ScanListMembersList_OnSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:ChannelEntry">
                                                <TextBlock Margin="8,7" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsRoamingChannelsViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="RoamingChannelListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding RoamingChannelCount, StringFormat='Roaming Channels ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddRoamingChannelCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveRoamingChannelCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="RoamingChannelList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding RoamingChannels}"
                                         SelectedItem="{Binding SelectedRoamingChannel}"
                                         Tapped="RoamingChannelList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:RoamingChannelEntry">
                                            <Grid Margin="8,7"
                                                  ColumnDefinitions="*,Auto"
                                                  RowDefinitions="Auto,Auto"
                                                  ColumnSpacing="8">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                                <TextBlock Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Text="{Binding RxFrequencyMhz, StringFormat='RX {0:F5} MHz'}"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="RoamingChannelEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedRoamingChannel.Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedRoamingChannel.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="250"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Fast select" ToolTip.Tip="Copies Name/RX/TX from one of your repeater-style channels (RX differs from TX) - doesn't touch Color Code/Slot.">
                                        <ComboBox ItemsSource="{Binding RoamingChannelFastSelectOptions}"
                                                  SelectedItem="{Binding RoamingChannelFastSelect}"
                                                  PlaceholderText="Pick a channel...">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChannelEntry">
                                                    <TextBlock Text="{Binding DisplayLabel}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedRoamingChannel.Name}"
                                                 MaxLength="16"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="RX MHz">
                                        <TextBox Text="{Binding SelectedRoamingChannel.RxFrequencyMhzText}"
                                                 MaxLength="9"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 views:DigitOnlyInput.MaxValue="480" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TX MHz">
                                        <TextBox Text="{Binding SelectedRoamingChannel.TxFrequencyMhzText}"
                                                 MaxLength="9"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 views:DigitOnlyInput.MaxValue="480" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Color Code">
                                        <ComboBox ItemsSource="{Binding SelectedRoamingChannel.ColorCodeOptions}"
                                                  SelectedItem="{Binding SelectedRoamingChannel.ColorCodeSelection}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Slot">
                                        <ComboBox ItemsSource="{Binding SelectedRoamingChannel.SlotOptions}"
                                                  SelectedItem="{Binding SelectedRoamingChannel.SlotSelection}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsRoamingZonesViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="RoamingZoneListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding RoamingZoneCount, StringFormat='Roaming Zones ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddRoamingZoneCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveRoamingZoneCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="RoamingZoneList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding RoamingZones}"
                                         SelectedItem="{Binding SelectedRoamingZone}"
                                         Tapped="RoamingZoneList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:RoamingZoneEntry">
                                            <Grid Margin="8,7" RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Members.Count, StringFormat='{}{0} channels'}"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="RoamingZoneEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedRoamingZone.Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedRoamingZone.Number}" IsReadOnly="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedRoamingZone.Name}"
                                                 MaxLength="16"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <TextBlock Text="{Binding AvailableRoamingZoneChannels.Count, StringFormat='Available Roaming Channels ({0})'}"
                                               FontWeight="SemiBold" />
                                    <ListBox x:Name="AvailableRoamingZoneChannelsList"
                                             MaxHeight="260"
                                             ItemsSource="{Binding AvailableRoamingZoneChannels}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="AvailableRoamingZoneChannelsList_OnSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:RoamingChannelEntry">
                                                <Grid Margin="8,7" ColumnDefinitions="50,*">
                                                    <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Command="{Binding AddRoamingZoneMembersCommand}" Content="Add" />
                                        <Button Grid.Column="1" Command="{Binding RemoveRoamingZoneMembersCommand}" Content="Remove" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedRoamingZone.Members.Count, StringFormat='Roaming Zone Channel Member ({0})'}"
                                               FontWeight="SemiBold" />
                                    <ListBox x:Name="RoamingZoneMembersList"
                                             MaxHeight="260"
                                             ItemsSource="{Binding SelectedRoamingZone.Members}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="RoamingZoneMembersList_OnSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:RoamingChannelEntry">
                                                <Grid Margin="8,7" ColumnDefinitions="50,*">
                                                    <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Command="{Binding MoveRoamingZoneMemberUpCommand}" Content="Up" />
                                        <Button Grid.Column="1" Command="{Binding MoveRoamingZoneMemberDownCommand}" Content="Down" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsReceiveGroupListsViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="ReceiveGroupListListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding ReceiveGroupListCount, StringFormat='Receive Group Lists ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddReceiveGroupListCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveReceiveGroupListCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="ReceiveGroupListList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding ReceiveGroupLists}"
                                         SelectedItem="{Binding SelectedReceiveGroupList}"
                                         Tapped="ReceiveGroupListList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ReceiveGroupListEntry">
                                            <Grid Margin="8,7" RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding TalkgroupIndexes.Count, StringFormat='{}{0} talkgroups'}"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="ReceiveGroupListEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedReceiveGroupList.Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedReceiveGroupList.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="250"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedReceiveGroupList.Name}"
                                                 MaxLength="16"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>

                                    <!-- Two-list member picker, same dual-list pattern as
                                         the mobile Scan List channel-member picker. -->
                                    <TextBlock Text="{Binding AvailableReceiveGroupListTalkgroups.Count, StringFormat='Available Receive Group Call Contact ({0})'}"
                                               FontWeight="SemiBold" />
                                    <ListBox x:Name="AvailableReceiveGroupListTalkgroupsList"
                                             MaxHeight="260"
                                             ItemsSource="{Binding AvailableReceiveGroupListTalkgroups}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="AvailableReceiveGroupListTalkgroupsList_OnSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:TalkgroupEntry">
                                                <TextBlock Margin="8,7" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Command="{Binding AddReceiveGroupListMembersCommand}" Content="Add" />
                                        <Button Grid.Column="1" Command="{Binding RemoveReceiveGroupListMembersCommand}" Content="Remove" />
                                    </Grid>
                                    <TextBlock Text="{Binding ReceiveGroupListMemberTalkgroups.Count, StringFormat='Receive Group Call List Member ({0})'}"
                                               FontWeight="SemiBold" />
                                    <ListBox x:Name="ReceiveGroupListMemberTalkgroupsList"
                                             MaxHeight="260"
                                             ItemsSource="{Binding ReceiveGroupListMemberTalkgroups}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="ReceiveGroupListMemberTalkgroupsList_OnSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:TalkgroupEntry">
                                                <TextBlock Margin="8,7" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAutoRepeaterOffsetsViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="AutoRepeaterOffsetListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding AutoRepeaterOffsetCount, StringFormat='Auto Repeater Offsets ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddAutoRepeaterOffsetCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveAutoRepeaterOffsetCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="AutoRepeaterOffsetList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding AutoRepeaterOffsets}"
                                         SelectedItem="{Binding SelectedAutoRepeaterOffset}"
                                         Tapped="AutoRepeaterOffsetList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AutoRepeaterOffsetEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding OffsetFrequencyMhzText}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="AutoRepeaterOffsetEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedAutoRepeaterOffset.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="250"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Offset Frequency (MHz)">
                                        <TextBox Text="{Binding SelectedAutoRepeaterOffset.OffsetFrequencyMhzText}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 views:DigitOnlyInput.MaxValue="90"
                                                 FontWeight="{Binding SelectedAutoRepeaterOffset.OffsetFrequencyMhzFontWeight}"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAnalogAddressBookViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="AnalogAddressListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding AnalogAddressCount, StringFormat='Analog Address Book ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddAnalogAddressCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveAnalogAddressCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="AnalogAddressList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding AnalogAddresses}"
                                         SelectedItem="{Binding SelectedAnalogAddress}"
                                         Tapped="AnalogAddressList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AnalogAddressEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="AnalogAddressEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedAnalogAddress.Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedAnalogAddress.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="128"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Address Number">
                                        <TextBox Text="{Binding SelectedAnalogAddress.AddressNumber}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 MaxLength="10"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedAnalogAddress.Name}"
                                                 MaxLength="15"
                                                 views:AsciiTextInput.Enabled="True"
                                                 FontWeight="{Binding SelectedAnalogAddress.NameFontWeight}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsGpsRoamingViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="GpsRoamingListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding GpsRoamingCount, StringFormat='GPS Roaming ({0} of 32 fixed slots)'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding ResetGpsRoamingCommand}" Content="Reset" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="GpsRoamingList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding GpsRoamingEntries}"
                                         SelectedItem="{Binding SelectedGpsRoaming}"
                                         Tapped="GpsRoamingList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:GpsRoamingEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding ZoneDisplayName}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="GpsRoamingEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedGpsRoaming.Number}" IsReadOnly="True" />
                                    </HeaderedContentControl>
                                    <CheckBox Content="Enabled" IsChecked="{Binding SelectedGpsRoaming.Enabled}" />
                                    <HeaderedContentControl Header="Zone">
                                        <ComboBox ItemsSource="{Binding GpsRoamingZoneOptions}"
                                                  SelectedItem="{Binding SelectedGpsRoamingZoneName}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Latitude Degree">
                                        <ComboBox ItemsSource="{Binding SelectedGpsRoaming.LatDegreeOptions}"
                                                  SelectedItem="{Binding SelectedGpsRoaming.LatDegree}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Latitude Minute">
                                        <TextBox Text="{Binding SelectedGpsRoaming.LatMinuteText}"
                                                 MaxLength="5"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 ToolTip.Tip="MM.mm, minutes 00-59" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="North/South">
                                        <ComboBox ItemsSource="{Binding SelectedGpsRoaming.NorthSouthOptions}"
                                                  SelectedItem="{Binding SelectedGpsRoaming.NorthSouthText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Longitude Degree">
                                        <ComboBox ItemsSource="{Binding SelectedGpsRoaming.LongDegreeOptions}"
                                                  SelectedItem="{Binding SelectedGpsRoaming.LongDegree}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Longitude Minute">
                                        <TextBox Text="{Binding SelectedGpsRoaming.LongMinuteText}"
                                                 MaxLength="5"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 ToolTip.Tip="MM.mm, minutes 00-59" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="East/West">
                                        <ComboBox ItemsSource="{Binding SelectedGpsRoaming.EastWestOptions}"
                                                  SelectedItem="{Binding SelectedGpsRoaming.EastWestText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Radius">
                                        <TextBox Text="{Binding SelectedGpsRoaming.RadiusText}"
                                                 MaxLength="5"
                                                 views:DigitOnlyInput.Enabled="True" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsTalkgroupWhitelistViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="TalkgroupWhitelistListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding TalkgroupWhitelistCount, StringFormat='Talkgroup Whitelist ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Classes="InfoIconButton" Margin="8,0,0,0">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <Border Classes="Panel" Padding="8" MaxWidth="360">
                                                        <TextBlock Text="The whole list is rewritten together on every Write to Radio, up to 1000 entries. Number reflects packed position on the radio, not a chosen slot - it isn't editable." TextWrapping="Wrap" />
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Margin="8,0,0,0" Command="{Binding AddTalkgroupWhitelistEntryCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveTalkgroupWhitelistEntryCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="TalkgroupWhitelistList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding TalkgroupWhitelist}"
                                         SelectedItem="{Binding SelectedTalkgroupWhitelistEntry}"
                                         Tapped="TalkgroupWhitelistList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TalkgroupWhitelistEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding DmrId}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="TalkgroupWhitelistEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedTalkgroupWhitelistEntry.Number}" IsReadOnly="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="DMR ID">
                                        <TextBox Text="{Binding SelectedTalkgroupWhitelistEntry.DmrIdText}"
                                                 MaxLength="8"
                                                 views:DigitOnlyInput.Enabled="True" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsDigitalContactWhitelistViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="DigitalContactWhitelistListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding DigitalContactWhitelistCount, StringFormat='Digital Contact Whitelist ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Classes="InfoIconButton" Margin="8,0,0,0">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <Border Classes="Panel" Padding="8" MaxWidth="360">
                                                        <TextBlock Text="The whole list is rewritten together on every Write to Radio, up to 1000 entries. Number reflects packed position on the radio, not a chosen slot - it isn't editable." TextWrapping="Wrap" />
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button Margin="8,0,0,0" Command="{Binding AddDigitalContactWhitelistEntryCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveDigitalContactWhitelistEntryCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="DigitalContactWhitelistList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding DigitalContactWhitelist}"
                                         SelectedItem="{Binding SelectedDigitalContactWhitelistEntry}"
                                         Tapped="DigitalContactWhitelistList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:DigitalContactWhitelistEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding DmrId}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="DigitalContactWhitelistEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedDigitalContactWhitelistEntry.Number}" IsReadOnly="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="DMR ID">
                                        <TextBox Text="{Binding SelectedDigitalContactWhitelistEntry.DmrIdText}"
                                                 MaxLength="8"
                                                 views:DigitOnlyInput.Enabled="True" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsDigitalContactsViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <StackPanel x:Name="DigitalContactListHeader" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Classes="InfoIconButton">
                                            <Button.Flyout>
                                                <Flyout>
                                                    <Border Classes="Panel" Padding="8" MaxWidth="360">
                                                        <TextBlock Text="The whole list is rewritten together on every Write to Radio. Multi-block writes are supported (live-confirmed crossing into a second block) up to 500 blocks - covers the vendor's own claimed 500,000-entry capacity." TextWrapping="Wrap" />
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <TextBlock Text="Only populated if 'Include Digital Contact List' was checked on the Radio tab before reading - this list can be very large, so it is opt-in and not read by default. Tap a row to edit it." TextWrapping="Wrap" />
                                    </StackPanel>
                                    <HeaderedContentControl Header="Filter (name, callsign, city, country, or radio ID)">
                                        <TextBox Text="{Binding DigitalContactFilterText}" />
                                    </HeaderedContentControl>
                                    <CheckBox Content="Friends only" IsChecked="{Binding DigitalContactFriendsOnly}" />
                                    <TextBlock Text="{Binding DigitalContacts.Count, StringFormat='{}{0} total'}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Command="{Binding AddDigitalContactCommand}" Content="+ Add" />
                                        <Button Grid.Column="1" Command="{Binding RemoveDigitalContactCommand}" Content="Del" />
                                    </Grid>
                                </StackPanel>
                                <ListBox x:Name="DigitalContactList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding FilteredDigitalContacts}"
                                         SelectedItem="{Binding SelectedDigitalContact}"
                                         Tapped="DigitalContactList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:DigitalContactEntry">
                                            <StackPanel Margin="8,7" Spacing="6">
                                                <HeaderedContentControl Header="Radio ID">
                                                    <TextBlock Text="{Binding RadioId}" />
                                                </HeaderedContentControl>
                                                <HeaderedContentControl Header="Name">
                                                    <TextBlock Text="{Binding Name}" />
                                                </HeaderedContentControl>
                                                <HeaderedContentControl Header="Callsign">
                                                    <TextBlock Text="{Binding Callsign}" />
                                                </HeaderedContentControl>
                                                <HeaderedContentControl Header="City / State / Country">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding City}" />
                                                        <TextBlock Text="{Binding State}" />
                                                        <TextBlock Text="{Binding Country}" />
                                                    </StackPanel>
                                                </HeaderedContentControl>
                                                <HeaderedContentControl Header="Call Type / Alert / Remarks">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CallTypeText}" />
                                                        <TextBlock Text="{Binding CallAlert}" />
                                                        <TextBlock Text="{Binding Remarks}" />
                                                    </StackPanel>
                                                </HeaderedContentControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="DigitalContactEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedDigitalContact.Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedDigitalContact.Name}"
                                                 MaxLength="16"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Type">
                                        <ComboBox ItemsSource="{Binding SelectedDigitalContact.CallTypeOptions}"
                                                  SelectedItem="{Binding SelectedDigitalContact.CallTypeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TG/DMR ID" IsEnabled="{Binding SelectedDigitalContact.IsAllCallFieldsEditable}">
                                        <TextBox Text="{Binding SelectedDigitalContact.RadioIdText}"
                                                 MaxLength="8"
                                                 views:DigitOnlyInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Alert" IsEnabled="{Binding SelectedDigitalContact.IsAllCallFieldsEditable}">
                                        <ComboBox ItemsSource="{Binding SelectedDigitalContact.CallAlertOptions}"
                                                  SelectedItem="{Binding SelectedDigitalContact.CallAlert}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <CheckBox Content="Friend" IsChecked="{Binding SelectedDigitalContact.IsFriend}" />
                                    <HeaderedContentControl Header="City">
                                        <TextBox Text="{Binding SelectedDigitalContact.City}"
                                                 MaxLength="15"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Callsign">
                                        <TextBox Text="{Binding SelectedDigitalContact.Callsign}"
                                                 MaxLength="8"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="State/Prov">
                                        <TextBox Text="{Binding SelectedDigitalContact.State}"
                                                 MaxLength="15"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Country">
                                        <TextBox Text="{Binding SelectedDigitalContact.Country}"
                                                 MaxLength="15"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Remarks">
                                        <TextBox Text="{Binding SelectedDigitalContact.Remarks}"
                                                 MaxLength="15"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsPrefabricatedSmsViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="PrefabricatedSmsListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding PrefabricatedSmsCount, StringFormat='Prefabricated SMS ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddPrefabricatedSmsCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemovePrefabricatedSmsCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="PrefabricatedSmsList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding PrefabricatedSmsMessages}"
                                         SelectedItem="{Binding SelectedPrefabricatedSms}"
                                         Tapped="PrefabricatedSmsList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:PrefabricatedSmsEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Text}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="PrefabricatedSmsEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedPrefabricatedSms.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="100" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Text">
                                        <TextBox Text="{Binding SelectedPrefabricatedSms.Text}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 MaxLength="100"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAmAirBandViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="AmAirListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding AmAirCount, StringFormat='AM Air Band ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddAmAirCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveAmAirCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="AmAirList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding AmAirChannels}"
                                         SelectedItem="{Binding SelectedAmAir}"
                                         Tapped="AmAirList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AmAirEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="AmAirEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedAmAir.Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedAmAir.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="256" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Frequency (MHz)">
                                        <TextBox Text="{Binding SelectedAmAir.FrequencyMhzText}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 views:DigitOnlyInput.MaxValue="145" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedAmAir.Name}"
                                                 MaxLength="16"
                                                 views:AsciiTextInput.Enabled="True"
                                                 FontWeight="{Binding SelectedAmAir.NameFontWeight}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAmZoneViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="AmZoneListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding AmZoneCount, StringFormat='AM Zones ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddAmZoneCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveAmZoneCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="AmZoneList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding AmZones}"
                                         SelectedItem="{Binding SelectedAmZone}"
                                         Tapped="AmZoneList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AmZoneEntry">
                                            <Grid Margin="8,7" RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding Members.Count, StringFormat='{}{0} channels'}"
                                                           Foreground="{DynamicResource AppMutedTextBrush}"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="AmZoneEditorPanel"
                                            IsVisible="False"
                                            Spacing="8">
                                    <TextBlock Text="{Binding SelectedAmZone.Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedAmZone.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="16" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Zone Name">
                                        <TextBox Text="{Binding SelectedAmZone.Name}"
                                                 MaxLength="16"
                                                 views:AsciiTextInput.Enabled="True"
                                                 FontWeight="{Binding SelectedAmZone.NameFontWeight}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="A Channel">
                                        <ComboBox ItemsSource="{Binding SelectedAmZoneMemberOptions}"
                                                  SelectedItem="{Binding SelectedAmZone.AChannel}"
                                                  FontWeight="{Binding SelectedAmZone.AChannelFontWeight}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:AmAirEntry">
                                                    <TextBlock Text="{Binding DisplayLabel}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </HeaderedContentControl>
                                    <TextBlock Text="{Binding AvailableAmZoneChannels.Count, StringFormat='Available channels ({0})'}"
                                               FontWeight="SemiBold" />
                                    <ListBox x:Name="AvailableAmZoneChannelsList"
                                             MaxHeight="260"
                                             ItemsSource="{Binding AvailableAmZoneChannels}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="AvailableAmZoneChannelsList_OnSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AmAirEntry">
                                                <TextBlock Margin="8,7" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Command="{Binding AddAmZoneMembersCommand}" Content="Add" />
                                        <Button Grid.Column="1" Command="{Binding RemoveAmZoneMembersCommand}" Content="Remove" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedAmZone.Members.Count, StringFormat='Added channels ({0})'}"
                                               FontWeight="{Binding SelectedAmZone.MembersFontWeight}" />
                                    <ListBox x:Name="AmZoneMembersList"
                                             MaxHeight="260"
                                             ItemsSource="{Binding SelectedAmZone.Members}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="AmZoneMembersList_OnSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AmAirEntry">
                                                <TextBlock Margin="8,7" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding AvailableAmZoneScanChannels.Count, StringFormat='Available Zone Scan Channel ({0})'}"
                                               FontWeight="SemiBold"
                                               ToolTip.Tip="Restricted to AM CH 001-128 - the scan-channel bitmask can't reference anything higher (confirmed 2026-08-02)." />
                                    <ListBox x:Name="AvailableAmZoneScanChannelsList"
                                             MaxHeight="260"
                                             ItemsSource="{Binding AvailableAmZoneScanChannels}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="AvailableAmZoneScanChannelsList_OnSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AmAirEntry">
                                                <TextBlock Margin="8,7" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Command="{Binding AddAmZoneScanChannelMembersCommand}" Content="Add" />
                                        <Button Grid.Column="1" Command="{Binding RemoveAmZoneScanChannelMembersCommand}" Content="Remove" />
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedAmZone.ScanChannelMembers.Count, StringFormat='Zone Scan Channel Member ({0})'}"
                                               FontWeight="{Binding SelectedAmZone.ScanChannelMembersFontWeight}" />
                                    <ListBox x:Name="AmZoneScanChannelMembersList"
                                             MaxHeight="260"
                                             ItemsSource="{Binding SelectedAmZone.ScanChannelMembers}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="AmZoneScanChannelMembersList_OnSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AmAirEntry">
                                                <TextBlock Margin="8,7" Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsFmBroadcastViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="FmChannelListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding FmChannelCount, StringFormat='FM Broadcast ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddFmChannelCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveFmChannelCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="FmChannelList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding FmChannels}"
                                         SelectedItem="{Binding SelectedFmChannel}"
                                         Tapped="FmChannelList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:FmChannelEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="FmChannelEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <TextBlock Text="{Binding SelectedFmChannel.Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedFmChannel.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="100"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Frequency (MHz)">
                                        <TextBox Text="{Binding SelectedFmChannel.FrequencyMhzText}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 views:DigitOnlyInput.MaxValue="108"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedFmChannel.Name}"
                                                 MaxLength="16"
                                                 views:AsciiTextInput.Enabled="True"
                                                 FontWeight="{Binding SelectedFmChannel.NameFontWeight}" />
                                    </HeaderedContentControl>
                                    <CheckBox Content="Scan" IsChecked="{Binding SelectedFmChannel.ScanAdd}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAnalogQuickCallViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="AnalogQuickCallListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding AnalogQuickCallCount, StringFormat='Analog Quick Call ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddAnalogQuickCallCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveAnalogQuickCallCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="AnalogQuickCallList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding AnalogQuickCalls}"
                                         SelectedItem="{Binding SelectedAnalogQuickCall}"
                                         Tapped="AnalogQuickCallList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AnalogQuickCallEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding OperationTypeText}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="AnalogQuickCallEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedAnalogQuickCall.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="4"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Operation Type">
                                        <ComboBox ItemsSource="{Binding SelectedAnalogQuickCall.OperationTypeOptions}"
                                                  SelectedItem="{Binding SelectedAnalogQuickCall.OperationTypeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>

                                    <!-- Needs the selected row's Operation Type to pick which
                                         of the 2Tone/5Tone/QDC1200 ID lists to offer, same
                                         "resolve against the ambient MainViewModel" reasoning
                                         as AM Zone's A Channel picker. -->
                                    <HeaderedContentControl Header="Call ID"
                                                             IsEnabled="{Binding SelectedAnalogQuickCall.IsCallIdEnabled}">
                                        <ComboBox ItemsSource="{Binding AnalogQuickCallCallIdOptions}"
                                                  SelectedItem="{Binding AnalogQuickCallCallIdSelection}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsStateInformationViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="StateInformationListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding StateInformationCount, StringFormat='State Information ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddStateInformationCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveStateInformationCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="StateInformationList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding StateInformationEntries}"
                                         SelectedItem="{Binding SelectedStateInformation}"
                                         Tapped="StateInformationList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:StateInformationEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Content}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="StateInformationEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedStateInformation.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="32"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="State Content">
                                        <TextBox Text="{Binding SelectedStateInformation.Content}"
                                                 MaxLength="32"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- No Add/Del - Hot Keys is a fixed 18-row list, one per
                         physical/programmable key, not addable/removable
                         (see HotKeyEntry's class doc comment). -->
                    <StackPanel IsVisible="{Binding IsHotKeyViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <TextBlock x:Name="HotKeyListHeader" Classes="SectionTitle" Text="Hot Keys (18)" />
                                <ListBox x:Name="HotKeyList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding HotKeys}"
                                         SelectedItem="{Binding SelectedHotKey}"
                                         Tapped="HotKeyList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:HotKeyEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding ModeText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="HotKeyEditorPanel"
                                            IsVisible="False"
                                            Spacing="8">
                                    <TextBlock Classes="Label" Text="{Binding SelectedHotKey.Key}" FontWeight="SemiBold" />
                                    <HeaderedContentControl Header="Mode">
                                        <ComboBox ItemsSource="{Binding SelectedHotKey.ModeOptions}"
                                                  SelectedItem="{Binding SelectedHotKey.ModeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Menu" IsEnabled="{Binding SelectedHotKey.IsMenuEnabled}">
                                        <ComboBox ItemsSource="{Binding SelectedHotKey.MenuOptions}"
                                                  SelectedItem="{Binding SelectedHotKey.MenuText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Type" IsEnabled="{Binding SelectedHotKey.IsCallTypeEnabled}">
                                        <ComboBox ItemsSource="{Binding SelectedHotKey.CallTypeOptions}"
                                                  SelectedItem="{Binding SelectedHotKey.CallTypeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Digi Call Type" IsEnabled="{Binding SelectedHotKey.IsDigiCallTypeEnabled}">
                                        <ComboBox ItemsSource="{Binding SelectedHotKey.DigiCallTypeOptions}"
                                                  SelectedItem="{Binding SelectedHotKey.DigiCallTypeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>

                                    <!-- Needs sibling collections (Analog Quick Call/Talkgroups/
                                         Prefabricated SMS) the row itself can't see, same
                                         "resolve against the ambient MainViewModel" reasoning
                                         as AM Zone's A Channel picker. -->
                                    <HeaderedContentControl Header="Call Object" IsEnabled="{Binding SelectedHotKey.IsCallObjectEnabled}">
                                        <ComboBox ItemsSource="{Binding HotKeyCallObjectOptions}"
                                                  SelectedItem="{Binding HotKeyCallObjectSelection}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Content" IsEnabled="{Binding SelectedHotKey.IsContentEnabled}">
                                        <ComboBox ItemsSource="{Binding HotKeyContentOptions}"
                                                  SelectedItem="{Binding HotKeyContentSelection}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsQdc1200DecodeViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Margin="4" Spacing="8">
                                <HeaderedContentControl Header="Auto Reset Time (s)">
                                    <ComboBox ItemsSource="{Binding Qdc1200AutoResetTimeOptions}"
                                              SelectedItem="{Binding Qdc1200Settings.AutoResetTimeText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Self ID - Private Call">
                                    <TextBox Text="{Binding Qdc1200Settings.SelfIdPrivateCall}"
                                             MaxLength="4"
                                             views:HexDigitInput.Enabled="True" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Self ID - Group Call">
                                    <TextBox Text="{Binding Qdc1200Settings.SelfIdGroupCall}"
                                             MaxLength="3"
                                             views:HexDigitInput.Enabled="True" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Remote Listening Duration (s)">
                                    <ComboBox ItemsSource="{Binding Qdc1200RemoteListeningDurationOptions}"
                                              SelectedItem="{Binding Qdc1200Settings.RemoteListeningDurationText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <CheckBox Content="Remotely Kill Allow" IsChecked="{Binding Qdc1200Settings.RemotelyKillAllow}" />
                                <CheckBox Content="Remotely Monitor Allow" IsChecked="{Binding Qdc1200Settings.RemotelyMonitorAllow}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsQdc1200EncodeViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="8">
                                    <CheckBox Content="Side Tone" IsChecked="{Binding Qdc1200Settings.SideTone}" />
                                    <HeaderedContentControl Header="Max ACK Wait Time (s)">
                                        <ComboBox ItemsSource="{Binding Qdc1200MaxAckWaitTimeOptions}"
                                                  SelectedItem="{Binding Qdc1200Settings.MaxAckWaitTimeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Pretime (ms)">
                                        <ComboBox ItemsSource="{Binding Qdc1200PretimeOptions}"
                                                  SelectedItem="{Binding Qdc1200Settings.PretimeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Resend Code in Case No Response">
                                        <ComboBox ItemsSource="{Binding Qdc1200ResendCodeOptions}"
                                                  SelectedItem="{Binding Qdc1200Settings.ResendCodeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                </StackPanel>
                                <Grid x:Name="Qdc1200IdListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding Qdc1200IdCount, StringFormat='QDC 1200 Encode ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddQdc1200IdCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveQdc1200IdCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="Qdc1200IdList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding Qdc1200Ids}"
                                         SelectedItem="{Binding SelectedQdc1200Id}"
                                         Tapped="Qdc1200IdList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Qdc1200IdEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="Qdc1200IdEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedQdc1200Id.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="100"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Type">
                                        <ComboBox ItemsSource="{Binding SelectedQdc1200Id.CallTypeOptions}"
                                                  SelectedItem="{Binding SelectedQdc1200Id.CallTypeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Private Call ID" IsEnabled="{Binding SelectedQdc1200Id.IsPrivateCallIdEnabled}">
                                        <TextBox Text="{Binding SelectedQdc1200Id.PrivateCallId}"
                                                 MaxLength="4"
                                                 views:HexDigitInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Group Call ID" IsEnabled="{Binding SelectedQdc1200Id.IsGroupCallIdEnabled}">
                                        <TextBox Text="{Binding SelectedQdc1200Id.GroupCallId}"
                                                 MaxLength="3"
                                                 views:HexDigitInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Type" IsEnabled="{Binding SelectedQdc1200Id.IsTypeEnabled}">
                                        <ComboBox ItemsSource="{Binding SelectedQdc1200Id.TypeOptions}"
                                                  SelectedItem="{Binding SelectedQdc1200Id.TypeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Need to Answer" IsEnabled="{Binding SelectedQdc1200Id.IsNeedToAnswerEnabled}">
                                        <ToggleSwitch IsChecked="{Binding SelectedQdc1200Id.NeedToAnswerText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedQdc1200Id.Name}"
                                                 MaxLength="12"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsQdcAddressBookViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="QdcAddressListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding QdcAddressCount, StringFormat='QDC Address Book ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddQdcAddressCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveQdcAddressCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="QdcAddressList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding QdcAddresses}"
                                         SelectedItem="{Binding SelectedQdcAddress}"
                                         Tapped="QdcAddressList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:QdcAddressEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="QdcAddressEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedQdcAddress.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="128"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Type">
                                        <ComboBox ItemsSource="{Binding SelectedQdcAddress.CallTypeOptions}"
                                                  SelectedItem="{Binding SelectedQdcAddress.CallTypeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Private ID" IsEnabled="{Binding SelectedQdcAddress.IsPrivateCallIdEnabled}">
                                        <TextBox Text="{Binding SelectedQdcAddress.PrivateCallId}"
                                                 MaxLength="4"
                                                 views:HexDigitInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Group ID" IsEnabled="{Binding SelectedQdcAddress.IsGroupCallIdEnabled}">
                                        <TextBox Text="{Binding SelectedQdcAddress.GroupCallId}"
                                                 MaxLength="3"
                                                 views:HexDigitInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Type">
                                        <ComboBox ItemsSource="{Binding SelectedQdcAddress.TypeOptions}"
                                                  SelectedItem="{Binding SelectedQdcAddress.TypeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Ack" IsEnabled="{Binding SelectedQdcAddress.IsAckEnabled}">
                                        <ToggleSwitch IsChecked="{Binding SelectedQdcAddress.AckText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedQdcAddress.Name}"
                                                 MaxLength="16"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsFiveToneViewSelected}">
                        <Border Classes="Panel">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" Margin="4">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Decode" />
                                    <HeaderedContentControl Header="Self ID">
                                        <TextBox Text="{Binding FiveToneSettings.SelfId}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 MaxLength="7" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Decode Standard">
                                        <ComboBox ItemsSource="{Binding FiveToneDecodeStandardOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.DecodeStandardText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Decoding Response">
                                        <ComboBox ItemsSource="{Binding FiveToneDecodingResponseOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.DecodingResponseText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Decode Time (ms)">
                                        <ComboBox ItemsSource="{Binding FiveToneDecodeTimeMsOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.DecodeTimeMsText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="5TONE Dec Units"
                                                             ToolTip.Tip="Unlabeled in the vendor CPS - meaning of each unit unconfirmed.">
                                        <WrapPanel>
                                            <CheckBox Content="1" IsChecked="{Binding FiveToneSettings.DecUnit1}" Margin="0,0,8,0" />
                                            <CheckBox Content="2" IsChecked="{Binding FiveToneSettings.DecUnit2}" Margin="0,0,8,0" />
                                            <CheckBox Content="3" IsChecked="{Binding FiveToneSettings.DecUnit3}" Margin="0,0,8,0" />
                                            <CheckBox Content="4" IsChecked="{Binding FiveToneSettings.DecUnit4}" Margin="0,0,8,0" />
                                            <CheckBox Content="5" IsChecked="{Binding FiveToneSettings.DecUnit5}" Margin="0,0,8,0" />
                                            <CheckBox Content="6" IsChecked="{Binding FiveToneSettings.DecUnit6}" Margin="0,0,8,0" />
                                            <CheckBox Content="7" IsChecked="{Binding FiveToneSettings.DecUnit7}" Margin="0,0,8,0" />
                                        </WrapPanel>
                                    </HeaderedContentControl>
                                    <CheckBox Content="Disp AnyID" IsChecked="{Binding FiveToneSettings.DispAnyId}" />

                                    <TextBlock Classes="SectionTitle" Text="Information ID / Information Code Function1" />
                                    <HeaderedContentControl Header="Infomation ID NO.">
                                        <ComboBox ItemsSource="{Binding FiveToneInfoIdNoOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.InfoIdNoText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Function Option" IsEnabled="{Binding IsInfoIdRowSelected}">
                                        <ComboBox ItemsSource="{Binding FiveToneFunctionOptionOptions}"
                                                  SelectedItem="{Binding SelectedInfoIdRow.FunctionOptionText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Decoding Response" IsEnabled="{Binding SelectedInfoIdRow.IsFunctionDecodingResponseEnabled}">
                                        <ComboBox ItemsSource="{Binding SelectedInfoIdRow.FunctionDecodingResponseOptions}"
                                                  SelectedItem="{Binding SelectedInfoIdRow.FunctionDecodingResponseText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Infomation ID" IsEnabled="{Binding IsInfoIdRowSelected}">
                                        <TextBox Text="{Binding SelectedInfoIdRow.InformationId}"
                                                 MaxLength="12"
                                                 views:HexDigitInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Function Name" IsEnabled="{Binding SelectedInfoIdRow.IsFunctionNameEnabled}">
                                        <TextBox Text="{Binding SelectedInfoIdRow.FunctionName}"
                                                 MaxLength="7"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>

                                    <TextBlock Classes="SectionTitle" Text="Encode" />
                                    <HeaderedContentControl Header="Pretime (ms)">
                                        <ComboBox ItemsSource="{Binding FiveTonePretimeOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.PretimeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Auto Reset Time (s)">
                                        <ComboBox ItemsSource="{Binding FiveToneAutoResetTimeOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.AutoResetTimeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Time-Lapse After Encode (ms)">
                                        <ComboBox ItemsSource="{Binding FiveToneTimeLapseAfterEncodeOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.TimeLapseAfterEncodeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="PTT ID Pause Time (s)">
                                        <ComboBox ItemsSource="{Binding FiveTonePttIdPauseTimeOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.PttIdPauseTimeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="First Tone Length (ms)">
                                        <ComboBox ItemsSource="{Binding FiveToneFirstToneLengthOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.FirstToneLengthText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Stop Code">
                                        <ComboBox ItemsSource="{Binding FiveToneStopCodeOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.StopCodeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Stop Time Length (ms)">
                                        <ComboBox ItemsSource="{Binding FiveToneStopTimeLengthOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.StopTimeLengthText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="First Tone Length After Stop (ms)">
                                        <ComboBox ItemsSource="{Binding FiveToneFirstToneLengthAfterStopOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.FirstToneLengthAfterStopText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <CheckBox Content="Side Tone" IsChecked="{Binding FiveToneSettings.SideTone}" />

                                    <TextBlock Classes="SectionTitle" Text="PTT ID Starting (BOT)" />
                                    <HeaderedContentControl Header="Encode ID" IsEnabled="{Binding FiveToneSettings.IsBotEncodeIdEnabled}">
                                        <TextBox Text="{Binding FiveToneSettings.BotEncodeId}"
                                                 MaxLength="24"
                                                 views:HexDigitInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Encode/Decode Standard">
                                        <ComboBox ItemsSource="{Binding FiveToneDecodeStandardOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.BotStandardText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Time Of Encode Tone (ms)">
                                        <ComboBox ItemsSource="{Binding FiveToneTimeOfEncodeToneOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.BotTimeOfEncodeToneText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Special Call - Choose Calling Type">
                                        <ComboBox ItemsSource="{Binding FiveToneSettings.BotSpecialCall.CallingTypeOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.BotSpecialCall.CallingTypeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <StackPanel IsVisible="{Binding FiveToneSettings.BotSpecialCall.IsSendMessage}">
                                        <HeaderedContentControl Header="The Other Side ID">
                                            <TextBox Text="{Binding FiveToneSettings.BotSpecialCall.OtherSideId}"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     MaxLength="{Binding FiveToneOtherSideIdMaxLength}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Message">
                                            <TextBox Text="{Binding FiveToneSettings.BotSpecialCall.Message}"
                                                     MaxLength="15"
                                                     views:AsciiTextInput.Enabled="True" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding FiveToneSettings.BotSpecialCall.IsAni}">
                                        <HeaderedContentControl Header="The Other Side ID">
                                            <TextBox Text="{Binding FiveToneSettings.BotSpecialCall.OtherSideId}"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     MaxLength="{Binding FiveToneOtherSideIdMaxLength}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Interval Character">
                                            <ComboBox ItemsSource="{Binding FiveToneSettings.BotSpecialCall.IntervalCharacterOptions}"
                                                      SelectedItem="{Binding FiveToneSettings.BotSpecialCall.IntervalCharacterText}"
                                                      HorizontalAlignment="Stretch" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <CheckBox Content="Special Call Configured" IsChecked="{Binding FiveToneSettings.BotSpecialCall.IsConfigured}" />
                                    <Button Content="Reset Special Call"
                                            Command="{Binding ResetFiveToneBotSpecialCallCommand}"
                                            IsEnabled="{Binding FiveToneSettings.BotSpecialCall.IsConfigured}" />

                                    <TextBlock Classes="SectionTitle" Text="PTT ID Ending (EOT)" />
                                    <HeaderedContentControl Header="Encode ID" IsEnabled="{Binding FiveToneSettings.IsEotEncodeIdEnabled}">
                                        <TextBox Text="{Binding FiveToneSettings.EotEncodeId}"
                                                 MaxLength="24"
                                                 views:HexDigitInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Encode/Decode Standard">
                                        <ComboBox ItemsSource="{Binding FiveToneDecodeStandardOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.EotStandardText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Time Of Encode Tone (ms)">
                                        <ComboBox ItemsSource="{Binding FiveToneTimeOfEncodeToneOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.EotTimeOfEncodeToneText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Special Call - Choose Calling Type">
                                        <ComboBox ItemsSource="{Binding FiveToneSettings.EotSpecialCall.CallingTypeOptions}"
                                                  SelectedItem="{Binding FiveToneSettings.EotSpecialCall.CallingTypeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <StackPanel IsVisible="{Binding FiveToneSettings.EotSpecialCall.IsSendMessage}">
                                        <HeaderedContentControl Header="The Other Side ID">
                                            <TextBox Text="{Binding FiveToneSettings.EotSpecialCall.OtherSideId}"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     MaxLength="{Binding FiveToneOtherSideIdMaxLength}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Message">
                                            <TextBox Text="{Binding FiveToneSettings.EotSpecialCall.Message}"
                                                     MaxLength="15"
                                                     views:AsciiTextInput.Enabled="True" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding FiveToneSettings.EotSpecialCall.IsAni}">
                                        <HeaderedContentControl Header="The Other Side ID">
                                            <TextBox Text="{Binding FiveToneSettings.EotSpecialCall.OtherSideId}"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     MaxLength="{Binding FiveToneOtherSideIdMaxLength}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Interval Character">
                                            <ComboBox ItemsSource="{Binding FiveToneSettings.EotSpecialCall.IntervalCharacterOptions}"
                                                      SelectedItem="{Binding FiveToneSettings.EotSpecialCall.IntervalCharacterText}"
                                                      HorizontalAlignment="Stretch" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <CheckBox Content="Special Call Configured" IsChecked="{Binding FiveToneSettings.EotSpecialCall.IsConfigured}" />
                                    <Button Content="Reset Special Call"
                                            Command="{Binding ResetFiveToneEotSpecialCallCommand}"
                                            IsEnabled="{Binding FiveToneSettings.EotSpecialCall.IsConfigured}" />
                                </StackPanel>

                                <WrapPanel Grid.Row="1" x:Name="FiveToneIdListHeader">
                                    <TextBlock Classes="SectionTitle"
                                               Text="{Binding FiveToneIdCount, StringFormat='5Tone IDs ({0})'}" />
                                    <Button Margin="8,0,0,0" Command="{Binding AddFiveToneIdCommand}" Content="+" />
                                    <Button Margin="8,0,0,0" Command="{Binding RemoveFiveToneIdCommand}" Content="Del" />
                                </WrapPanel>
                                <ListBox Grid.Row="2"
                                         x:Name="FiveToneIdList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding FiveToneIds}"
                                         SelectedItem="{Binding SelectedFiveToneId}"
                                         Tapped="FiveToneIdList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:FiveToneIdEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="3"
                                            x:Name="FiveToneIdEditorPanel"
                                            IsVisible="False"
                                            Spacing="8">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedFiveToneId.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="100"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Encode ID">
                                        <TextBox Text="{Binding SelectedFiveToneId.EncodeId}"
                                                 MaxLength="40"
                                                 views:HexDigitInput.Enabled="{Binding SelectedFiveToneId.IsEncodeIdHexOnly}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Special Call - Choose Calling Type">
                                        <ComboBox ItemsSource="{Binding SelectedFiveToneId.SpecialCall.CallingTypeOptions}"
                                                  SelectedItem="{Binding SelectedFiveToneId.SpecialCall.CallingTypeText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <StackPanel IsVisible="{Binding SelectedFiveToneId.SpecialCall.IsSendMessage}">
                                        <HeaderedContentControl Header="The Other Side ID" ToolTip.Tip="Max 7, but no longer than the current Self ID - only enforced exactly in the row-level popup, not this inline mobile field.">
                                            <TextBox Text="{Binding SelectedFiveToneId.SpecialCall.OtherSideId}"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     MaxLength="7" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Message">
                                            <TextBox Text="{Binding SelectedFiveToneId.SpecialCall.Message}"
                                                     MaxLength="15"
                                                     views:AsciiTextInput.Enabled="True" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <StackPanel IsVisible="{Binding SelectedFiveToneId.SpecialCall.IsAni}">
                                        <HeaderedContentControl Header="The Other Side ID" ToolTip.Tip="Max 7, but no longer than the current Self ID - only enforced exactly in the row-level popup, not this inline mobile field.">
                                            <TextBox Text="{Binding SelectedFiveToneId.SpecialCall.OtherSideId}"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     MaxLength="7" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Interval Character">
                                            <ComboBox ItemsSource="{Binding SelectedFiveToneId.SpecialCall.IntervalCharacterOptions}"
                                                      SelectedItem="{Binding SelectedFiveToneId.SpecialCall.IntervalCharacterText}"
                                                      HorizontalAlignment="Stretch" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <CheckBox Content="Special Call Configured" IsChecked="{Binding SelectedFiveToneId.SpecialCall.IsConfigured}" />
                                    <Button Content="Reset Special Call"
                                            Click="FiveToneResetButton_OnClick"
                                            IsEnabled="{Binding SelectedFiveToneId.SpecialCall.IsConfigured}" />
                                    <StackPanel IsEnabled="{Binding SelectedFiveToneId.SpecialCall.IsConfigured}">
                                        <HeaderedContentControl Header="Encode/Decode Standard">
                                            <ComboBox ItemsSource="{Binding SelectedFiveToneId.StandardOptions}"
                                                      SelectedItem="{Binding SelectedFiveToneId.StandardText}"
                                                      HorizontalAlignment="Stretch" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Time Of Encode Tone (ms)">
                                            <ComboBox ItemsSource="{Binding SelectedFiveToneId.TimeOfEncodeToneOptions}"
                                                      SelectedItem="{Binding SelectedFiveToneId.TimeOfEncodeToneText}"
                                                      HorizontalAlignment="Stretch" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Name">
                                            <TextBox Text="{Binding SelectedFiveToneId.Name}"
                                                     MaxLength="7"
                                                     views:AsciiTextInput.Enabled="True" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsTwoToneEncodeViewSelected}">
                        <Border Classes="Panel">
                            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="4">
                                <StackPanel Spacing="8">
                                    <CheckBox Content="Side Tone" IsChecked="{Binding TwoToneEncodeSettings.SideTone}" />
                                    <HeaderedContentControl Header="1st Tone Duration (s)">
                                        <ComboBox ItemsSource="{Binding TwoToneEncodeSettings.ToneDurationOptions}"
                                                  SelectedItem="{Binding TwoToneEncodeSettings.FirstToneDurationSecondsText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="2nd Tone Duration (s)">
                                        <ComboBox ItemsSource="{Binding TwoToneEncodeSettings.ToneDurationOptions}"
                                                  SelectedItem="{Binding TwoToneEncodeSettings.SecondToneDurationSecondsText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Long Tone Duration (s)">
                                        <ComboBox ItemsSource="{Binding TwoToneEncodeSettings.ToneDurationOptions}"
                                                  SelectedItem="{Binding TwoToneEncodeSettings.LongToneDurationSecondsText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Gap Time (ms)">
                                        <ComboBox ItemsSource="{Binding TwoToneEncodeSettings.GapTimeMsOptions}"
                                                  SelectedItem="{Binding TwoToneEncodeSettings.GapTimeMsText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Auto Reset Time (s)">
                                        <ComboBox ItemsSource="{Binding TwoToneEncodeSettings.AutoResetTimeSecondsOptions}"
                                                  SelectedItem="{Binding TwoToneEncodeSettings.AutoResetTimeSecondsText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                </StackPanel>
                                <WrapPanel Grid.Row="1" x:Name="TwoToneEncodeEntryListHeader">
                                    <TextBlock Classes="SectionTitle"
                                               Text="{Binding TwoToneEncodeCount, StringFormat='2Tone Encode ({0})'}" />
                                    <Button Margin="8,0,0,0" Command="{Binding AddTwoToneEncodeEntryCommand}" Content="+" />
                                    <Button Margin="8,0,0,0" Command="{Binding RemoveTwoToneEncodeEntryCommand}" Content="Del" />
                                </WrapPanel>
                                <ListBox Grid.Row="2"
                                         x:Name="TwoToneEncodeEntryList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding TwoToneEncodeEntries}"
                                         SelectedItem="{Binding SelectedTwoToneEncodeEntry}"
                                         Tapped="TwoToneEncodeEntryList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TwoToneEncodeEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        <Border Classes="Panel"
                                x:Name="TwoToneEncodeEntryEditorPanel"
                                IsVisible="False"
                                Margin="0,10,0,0">
                            <StackPanel Spacing="10" Margin="4">
                                <HeaderedContentControl Header="No">
                                    <TextBox Text="{Binding SelectedTwoToneEncodeEntry.Number}"
                                             views:DigitOnlyInput.Enabled="True"
                                             views:DigitOnlyInput.MaxValue="24"
                                             Classes="PinDigits" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="1st Tone Frequency (Hz)">
                                    <TextBox Text="{Binding SelectedTwoToneEncodeEntry.FirstToneFrequencyHzText}"
                                             views:DigitOnlyInput.Enabled="True"
                                             views:DigitOnlyInput.AllowDecimalPoint="True"
                                             views:DigitOnlyInput.MaxValue="3106" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="2nd Tone Frequency (Hz)">
                                    <TextBox Text="{Binding SelectedTwoToneEncodeEntry.SecondToneFrequencyHzText}"
                                             views:DigitOnlyInput.Enabled="True"
                                             views:DigitOnlyInput.AllowDecimalPoint="True"
                                             views:DigitOnlyInput.MaxValue="3106" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Name">
                                    <TextBox Text="{Binding SelectedTwoToneEncodeEntry.Name}"
                                             MaxLength="7"
                                             views:AsciiTextInput.Enabled="True" />
                                </HeaderedContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsTwoToneDecodeViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="TwoToneDecodeEntryListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding TwoToneDecodeCount, StringFormat='2Tone Decode ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddTwoToneDecodeEntryCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveTwoToneDecodeEntryCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="TwoToneDecodeEntryList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding TwoToneDecodeEntries}"
                                         SelectedItem="{Binding SelectedTwoToneDecodeEntry}"
                                         Tapped="TwoToneDecodeEntryList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TwoToneDecodeEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="TwoToneDecodeEntryEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedTwoToneDecodeEntry.Number}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="16"
                                                 Classes="PinDigits" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="1st Tone Frequency (Hz)">
                                        <TextBox Text="{Binding SelectedTwoToneDecodeEntry.FirstToneFrequencyHzText}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 views:DigitOnlyInput.MaxValue="3106" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="2nd Tone Frequency (Hz)">
                                        <TextBox Text="{Binding SelectedTwoToneDecodeEntry.SecondToneFrequencyHzText}"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 views:DigitOnlyInput.MaxValue="3106" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Decoding Response">
                                        <ComboBox ItemsSource="{Binding SelectedTwoToneDecodeEntry.DecodingResponseOptions}"
                                                  SelectedItem="{Binding SelectedTwoToneDecodeEntry.DecodingResponseText}"
                                                  HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Name">
                                        <TextBox Text="{Binding SelectedTwoToneDecodeEntry.Name}"
                                                 MaxLength="7"
                                                 views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsDtmfViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Spacing="10" Margin="4">
                                <TextBlock Classes="SectionTitle" Text="DTMF Settings" />
                                <HeaderedContentControl Header="DTMF Transmitting Time (ms)">
                                    <ComboBox ItemsSource="{Binding DtmfSettings.TransmittingTimeMsOptions}"
                                              SelectedItem="{Binding DtmfSettings.TransmittingTimeMsText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="DTMF Self ID">
                                    <TextBox Text="{Binding DtmfSettings.SelfId}"
                                             MaxLength="3"
                                             views:DigitOnlyInput.Enabled="True" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="DTMF Interval Character">
                                    <ComboBox ItemsSource="{Binding DtmfIntervalCharacterOptions}"
                                              SelectedItem="{Binding DtmfSettings.IntervalCharacter}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Group Code">
                                    <ComboBox ItemsSource="{Binding DtmfGroupCodeOptions}"
                                              SelectedItem="{Binding DtmfSettings.GroupCode}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Decoding Response">
                                    <ComboBox ItemsSource="{Binding DtmfDecodingResponseOptions}"
                                              SelectedItem="{Binding DtmfSettings.DecodingResponseText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="First Digit Time (ms)">
                                    <ComboBox ItemsSource="{Binding DtmfSettings.FirstDigitTimeMsOptions}"
                                              SelectedItem="{Binding DtmfSettings.FirstDigitTimeMsText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Pretime (ms)">
                                    <ComboBox ItemsSource="{Binding DtmfSettings.PretimeMsOptions}"
                                              SelectedItem="{Binding DtmfSettings.PretimeMsText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Auto Reset Time (s)">
                                    <ComboBox ItemsSource="{Binding DtmfSettings.AutoResetTimeSecondsOptions}"
                                              SelectedItem="{Binding DtmfSettings.AutoResetTimeSecondsText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Time-Lapse After Encode (ms)">
                                    <ComboBox ItemsSource="{Binding DtmfSettings.TimeLapseAfterEncodeMsOptions}"
                                              SelectedItem="{Binding DtmfSettings.TimeLapseAfterEncodeMsText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="PTT ID Pause Time (s)">
                                    <ComboBox ItemsSource="{Binding DtmfSettings.PttIdPauseTimeSecondsOptions}"
                                              SelectedItem="{Binding DtmfSettings.PttIdPauseTimeSecondsText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="D Code Pause (s)">
                                    <ComboBox ItemsSource="{Binding DtmfSettings.DCodePauseSecondsOptions}"
                                              SelectedItem="{Binding DtmfSettings.DCodePauseSecondsText}"
                                              HorizontalAlignment="Stretch" />
                                </HeaderedContentControl>
                                <CheckBox Content="Side Tone" IsChecked="{Binding DtmfSettings.SideTone}" />
                                <CheckBox Content="PTT ID" IsChecked="{Binding DtmfSettings.PttId}" />
                                <HeaderedContentControl Header="PTT ID Starting (BOT)" IsEnabled="{Binding DtmfSettings.PttId}">
                                    <TextBox Text="{Binding DtmfSettings.PttIdStartingBot}"
                                             MaxLength="16"
                                             views:DtmfCodeInput.Enabled="True" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="PTT ID Ending (EOT)" IsEnabled="{Binding DtmfSettings.PttId}">
                                    <TextBox Text="{Binding DtmfSettings.PttIdEndingEot}"
                                             MaxLength="16"
                                             views:DtmfCodeInput.Enabled="True" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Remotely Kill">
                                    <TextBox Text="{Binding DtmfSettings.RemotelyKill}"
                                             MaxLength="14"
                                             views:DtmfCodeInput.Enabled="True" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Remotely Stun">
                                    <TextBox Text="{Binding DtmfSettings.RemotelyStun}"
                                             MaxLength="14"
                                             views:DtmfCodeInput.Enabled="True" />
                                </HeaderedContentControl>

                                <TextBlock Classes="SectionTitle" Text="DTMF Encode" Margin="0,10,0,0" />
                                <ItemsControl ItemsSource="{Binding DtmfEncodeEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DtmfEncodeEntry">
                                            <StackPanel Margin="0,0,0,8" Spacing="4">
                                                <HeaderedContentControl Header="{Binding DisplayLabel}">
                                                    <TextBox Text="{Binding Code}"
                                                             MaxLength="16"
                                                             views:DtmfCodeInput.Enabled="True" />
                                                </HeaderedContentControl>
                                                <HeaderedContentControl Header="The Other Side ID (Special Call / ANI)">
                                                    <TextBox Text="{Binding OtherSideId}"
                                                             MaxLength="3"
                                                             views:DigitOnlyInput.Enabled="True" />
                                                </HeaderedContentControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsMasterIdViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Margin="8" Spacing="10">
                                <TextBlock Classes="Label"
                                           TextWrapping="Wrap"
                                           Text="There is only ever one Master ID on the radio - a designated primary DMR ID among the Radio ID list." />
                                <CheckBox Content="Used" IsChecked="{Binding MasterId.Used}" />
                                <HeaderedContentControl Header="DMR ID">
                                    <TextBox Text="{Binding MasterId.DmrIdText}"
                                             MaxLength="8"
                                             views:DigitOnlyInput.Enabled="True" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Name">
                                    <TextBox Text="{Binding MasterId.Name}"
                                             MaxLength="16"
                                             views:AsciiTextInput.Enabled="True" />
                                </HeaderedContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsTalkAliasSettingsViewSelected}">
                        <Border Classes="Panel">
                            <StackPanel Margin="8" Spacing="10">
                                <HeaderedContentControl Header="Display Priority">
                                    <ComboBox ItemsSource="{Binding TalkAliasSettings.DisplayPriorityOptions}"
                                              SelectedItem="{Binding TalkAliasSettings.DisplayPriorityText}" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Data Format">
                                    <ComboBox ItemsSource="{Binding TalkAliasSettings.DataFormatOptions}"
                                              SelectedItem="{Binding TalkAliasSettings.DataFormatText}" />
                                </HeaderedContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAlarmSettingsViewSelected}">
                        <Border Classes="Panel">
                            <!-- No inner ScrollViewer (removed 2026-07-28) - this
                                 whole page has no bounded ListBox of its own, it
                                 just relies on the outer MainScrollViewer like
                                 every other flat-field page; wrapping it in a
                                 second ScrollViewer nested inside that one was a
                                 real double-scroll conflict, not intentional. -->
                            <StackPanel Margin="8" Spacing="10">
                                    <GroupBox Header="Analog Alarm">
                                    <StackPanel Spacing="10">
                                    <HeaderedContentControl Header="Emergency Alarm">
                                        <ComboBox ItemsSource="{Binding AlarmSettings.AnalogEmergencyAlarmOptions}"
                                                  SelectedItem="{Binding AlarmSettings.AnalogEmergencyAlarmText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="ENI Type Select" IsEnabled="{Binding AlarmSettings.IsAnalogEniTypeEnabled}">
                                        <ComboBox ItemsSource="{Binding AlarmSettings.EniTypeOptions}"
                                                  SelectedItem="{Binding AlarmSettings.AnalogEniTypeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Emergency ID"
                                                             ToolTip.Tip="Not independently confirmed against real hardware - inferred from the reference project's own source."
                                                             IsEnabled="{Binding AlarmSettings.IsAnalogEmergencyIdEnabled}">
                                        <ComboBox ItemsSource="{Binding AlarmSettingsAnalogEmergencyIdOptions}"
                                                  SelectedItem="{Binding AlarmSettingsAnalogEmergencyIdSelection}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Alarm Time [s]" IsEnabled="{Binding AlarmSettings.IsAnalogAlarmTimeEnabled}">
                                        <ComboBox ItemsSource="{Binding AlarmSettings.DurationOptions}"
                                                  SelectedItem="{Binding AlarmSettings.AnalogAlarmTimeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Duration of TX [s]" IsEnabled="{Binding AlarmSettings.IsAnalogTxRxDurationEnabled}">
                                        <ComboBox ItemsSource="{Binding AlarmSettings.DurationOptions}"
                                                  SelectedItem="{Binding AlarmSettings.AnalogTxDurationText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Duration of RX [s]" IsEnabled="{Binding AlarmSettings.IsAnalogTxRxDurationEnabled}">
                                        <ComboBox ItemsSource="{Binding AlarmSettings.DurationOptions}"
                                                  SelectedItem="{Binding AlarmSettings.AnalogRxDurationText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Emergency ENI Send Select">
                                        <ComboBox ItemsSource="{Binding AlarmSettings.EniSendOptions}"
                                                  SelectedItem="{Binding AlarmSettings.AnalogEniSendText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Emergency Channel" IsEnabled="{Binding AlarmSettings.IsAnalogEniSendAssignedChannel}">
                                        <ComboBox ItemsSource="{Binding AlarmSettingsAnalogEmergencyChannelOptions}"
                                                  SelectedItem="{Binding AlarmSettingsAnalogEmergencyChannelSelection}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Emergency Cycle">
                                        <ComboBox ItemsSource="{Binding AlarmSettings.EmergencyCycleOptions}"
                                                  SelectedItem="{Binding AlarmSettings.AnalogEmergencyCycleText}" />
                                    </HeaderedContentControl>
                                    </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="Digital Alarm">
                                    <StackPanel Spacing="10">
                                        <HeaderedContentControl Header="Emergency Alarm">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.DigitalEmergencyAlarmOptions}"
                                                      SelectedItem="{Binding AlarmSettings.DigitalEmergencyAlarmText}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Alarm Time [s]">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.DurationOptions}"
                                                      SelectedItem="{Binding AlarmSettings.DigitalAlarmTimeText}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Duration of TX [s]">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.DurationOptions}"
                                                      SelectedItem="{Binding AlarmSettings.DigitalTxDurationText}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Duration of RX [s]">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.DurationOptions}"
                                                      SelectedItem="{Binding AlarmSettings.DigitalRxDurationText}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Emergency ENI Send Select">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.EniSendOptions}"
                                                      SelectedItem="{Binding AlarmSettings.DigitalEniSendText}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Emergency Channel" IsEnabled="{Binding AlarmSettings.IsDigitalEniSendAssignedChannel}">
                                            <ComboBox ItemsSource="{Binding AlarmSettingsDigitalEmergencyChannelOptions}"
                                                      SelectedItem="{Binding AlarmSettingsDigitalEmergencyChannelSelection}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Emergency Cycle">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.EmergencyCycleOptions}"
                                                      SelectedItem="{Binding AlarmSettings.DigitalEmergencyCycleText}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="TG/DMR ID">
                                            <TextBox Text="{Binding AlarmSettings.DigitalTgDmrIdText}"
                                                     MaxLength="8"
                                                     views:DigitOnlyInput.Enabled="True"
                                                     views:DigitOnlyInput.MaxValue="16776415" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Call Type">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.CallTypeOptions}"
                                                      SelectedItem="{Binding AlarmSettings.DigitalCallTypeText}" />
                                        </HeaderedContentControl>
                                        <CheckBox Content="Receive Alarm" IsChecked="{Binding AlarmSettings.ReceiveAlarm}" />
                                    </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="Work Alone">
                                    <StackPanel Spacing="10">
                                        <HeaderedContentControl Header="Response Time (minutes)">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.WorkAloneResponseTimeOptions}"
                                                      SelectedItem="{Binding AlarmSettings.WorkAloneResponseTimeText}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Warning Time [s]">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.WorkAloneWarningTimeOptions}"
                                                      SelectedItem="{Binding AlarmSettings.WorkAloneWarningTimeText}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Response">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.WorkAloneResponseOptions}"
                                                      SelectedItem="{Binding AlarmSettings.WorkAloneResponseText}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="Man Down">
                                    <StackPanel Spacing="10">
                                        <CheckBox Content="Man Down" IsChecked="{Binding AlarmSettings.ManDown}" />
                                        <HeaderedContentControl Header="Man Down Delay [s]">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.ManDownDelayOptions}"
                                                      SelectedItem="{Binding AlarmSettings.ManDownDelayText}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="QDC1200 Setting" IsEnabled="{Binding AlarmSettings.IsQdcSettingEnabled}">
                                    <StackPanel Spacing="10">
                                        <HeaderedContentControl Header="Kind" ToolTip.Tip="Byte address not confirmed - the reference project's own source never assigns this field for any radio model.">
                                            <ComboBox ItemsSource="{Binding AlarmSettings.CallTypeOptions}"
                                                      SelectedItem="{Binding AlarmSettings.QdcCallTypeText}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Group ID" IsEnabled="{Binding AlarmSettings.IsQdcGroupIdEnabled}">
                                            <TextBox Text="{Binding AlarmSettings.QdcGroupId}"
                                                     MaxLength="3"
                                                     views:HexDigitInput.Enabled="True" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Private ID" IsEnabled="{Binding AlarmSettings.IsQdcPrivateIdEnabled}">
                                            <TextBox Text="{Binding AlarmSettings.QdcPrivateId}"
                                                     MaxLength="4"
                                                     views:HexDigitInput.Enabled="True" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    </GroupBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAprsSettingsViewSelected}">
                        <Border Classes="Panel">
                            <!-- No inner ScrollViewer (removed 2026-07-28) - see the
                                 same note on the Alarm Settings page above. -->
                            <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="Label"
                                               TextWrapping="Wrap"
                                               Text="Callsign/path fields are narrow ASCII, not UTF-16LE. Most raw-byte fields' exact meaning is not confirmed - see Field_Reference.md §16." />

                                    <TextBlock Classes="SectionTitle" Text="TX Settings" />
                                    <HeaderedContentControl Header="TX Freq 1 (MHz)">
                                        <TextBox Text="{Binding AprsSettings.TxFreq1MhzText}" MaxLength="9" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="480" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TX Delay [ms]">
                                        <ComboBox ItemsSource="{Binding AprsSettings.TxDelayOptions}" SelectedItem="{Binding AprsSettings.TxDelayText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TX Power">
                                        <ComboBox ItemsSource="{Binding AprsSettings.TxPowerOptions}" SelectedItem="{Binding AprsSettings.TxPowerText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Send Subtone">
                                        <ComboBox ItemsSource="{Binding AprsSettings.SendSubtoneOptions}" SelectedItem="{Binding AprsSettings.SendSubtoneText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="CTCSS">
                                        <ComboBox ItemsSource="{Binding AprsSettings.CtcssOptions}" SelectedItem="{Binding AprsSettings.CtcssText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="DCS">
                                        <ComboBox ItemsSource="{Binding AprsSettings.DcsOptions}" SelectedItem="{Binding AprsSettings.DcsText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Manual TX Interval [s]">
                                        <TextBox Text="{Binding AprsSettings.ManualTxInterval}"
                                                 MaxLength="3"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.MaxValue="255" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Auto TX Interval [s]">
                                        <ComboBox ItemsSource="{Binding AprsSettings.AutoTxIntervalOptions}" SelectedItem="{Binding AprsSettings.AutoTxIntervalText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TX Tone">
                                        <ComboBox ItemsSource="{Binding AprsSettings.TxToneOptions}" SelectedItem="{Binding AprsSettings.TxToneText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Prewave Time [ms]">
                                        <ComboBox ItemsSource="{Binding AprsSettings.PrewaveTimeOptions}" SelectedItem="{Binding AprsSettings.PrewaveTimeText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Fixed Location Beacon">
                                        <ComboBox ItemsSource="{Binding AprsSettings.FixedLocationBeaconOptions}" SelectedItem="{Binding AprsSettings.FixedLocationBeaconText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>

                                    <TextBlock Classes="SectionTitle" Text="Fix 1 (Home Position)" />
                                    <HeaderedContentControl Header="Latitude / N-S">
                                        <StackPanel>
                                            <TextBox Text="{Binding AprsSettings.Fix1LatText}" MaxLength="8" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="90" />
                                            <ComboBox ItemsSource="{Binding AprsSettings.NsOptions}" SelectedItem="{Binding AprsSettings.Fix1NsText}" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Longitude / E-W">
                                        <StackPanel>
                                            <TextBox Text="{Binding AprsSettings.Fix1LngText}" MaxLength="9" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="180" />
                                            <ComboBox ItemsSource="{Binding AprsSettings.EwOptions}" SelectedItem="{Binding AprsSettings.Fix1EwText}" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <!-- "Sate Fix PointName 1" not yet modeled -
                                         no confirmed byte offset for it, unlike
                                         every other field on this page. -->

                                    <TextBlock Classes="SectionTitle" Text="Callsigns / Path" />
                                    <HeaderedContentControl Header="To Call / SSID">
                                        <StackPanel>
                                            <TextBox Text="{Binding AprsSettings.ToCall}" MaxLength="6" views:AsciiTextInput.Enabled="True" views:CallsignInput.Enabled="True" />
                                            <ComboBox ItemsSource="{Binding AprsSettings.SsidOptions}" SelectedItem="{Binding AprsSettings.ToCallSsidText}" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Your Call / SSID">
                                        <StackPanel>
                                            <TextBox Text="{Binding AprsSettings.YourCall}" MaxLength="6" views:AsciiTextInput.Enabled="True" views:CallsignInput.Enabled="True" />
                                            <ComboBox ItemsSource="{Binding AprsSettings.SsidOptions}" SelectedItem="{Binding AprsSettings.YourCallSsidText}" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Digipeater Path">
                                        <TextBox Text="{Binding AprsSettings.DigipeaterPath}" MaxLength="56" views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="APRS Symbol / Map Icon">
                                        <StackPanel>
                                            <TextBox Text="{Binding AprsSettings.AprsSymbol}" MaxLength="1" views:AsciiTextInput.Enabled="True" />
                                            <TextBox Text="{Binding AprsSettings.MapIcon}" MaxLength="1" views:AsciiTextInput.Enabled="True" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Sending Text">
                                        <TextBox Text="{Binding AprsSettings.SendingText}"
                                                 MaxLength="60"
                                                 views:AsciiTextInput.Enabled="True"
                                                 ToolTip.Tip="Vendor CPS UI limit is 60 characters, confirmed 2026-08-15 - doesn't neatly match the codec's own 0x60 (96-byte) UTF-16LE slice, worth rechecking during the live-capture pass." />
                                    </HeaderedContentControl>

                                    <TextBlock Classes="SectionTitle" Text="Misc" />
                                    <HeaderedContentControl Header="Roaming Support">
                                        <ComboBox ItemsSource="{Binding AprsSettings.RoamingSupportOptions}" SelectedItem="{Binding AprsSettings.RoamingSupportText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Repeater Activation Delay [ms]">
                                        <ComboBox ItemsSource="{Binding AprsSettings.RepeaterActivationDelayOptions}" SelectedItem="{Binding AprsSettings.RepeaterActivationDelayText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="APRSDisTime [s]">
                                        <ComboBox ItemsSource="{Binding AprsSettings.DisTimeOptions}" SelectedItem="{Binding AprsSettings.DisTimeText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Altitude (raw)" ToolTip.Tip="Vendor CPS shows a Meter/Feet unit selector alongside this value, not yet modeled - unconfirmed, do not trust this field's range yet.">
                                        <TextBox Text="{Binding AprsSettings.Altitude}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Ana APRSTx">
                                        <ComboBox ItemsSource="{Binding AprsSettings.AnalogTxModeOptions}" SelectedItem="{Binding AprsSettings.AnalogTxModeText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Pass All">
                                        <ComboBox ItemsSource="{Binding AprsSettings.PassAllOptions}" SelectedItem="{Binding AprsSettings.PassAllText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>

                                    <TextBlock Classes="SectionTitle" Text="TX Frequencies 2-8 (MHz)" />
                                    <TextBox Text="{Binding AprsSettings.TxFreq2MhzText}" MaxLength="9" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="480" />
                                    <TextBox Text="{Binding AprsSettings.TxFreq3MhzText}" MaxLength="9" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="480" />
                                    <TextBox Text="{Binding AprsSettings.TxFreq4MhzText}" MaxLength="9" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="480" />
                                    <TextBox Text="{Binding AprsSettings.TxFreq5MhzText}" MaxLength="9" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="480" />
                                    <TextBox Text="{Binding AprsSettings.TxFreq6MhzText}" MaxLength="9" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="480" />
                                    <TextBox Text="{Binding AprsSettings.TxFreq7MhzText}" MaxLength="9" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="480" />
                                    <TextBox Text="{Binding AprsSettings.TxFreq8MhzText}" MaxLength="9" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="480" />

                                    <!-- CONFIRMED 2026-08-15: user checked the
                                         real vendor CPS directly - there are
                                         no Filters checkboxes at all on this
                                         radio's APRS dialog. See the same
                                         note on Desktop's
                                         AprsSettingsDetailView.axaml. -->
                                    <TextBlock Classes="SectionTitle" Text="Filters" />
                                    <StackPanel IsEnabled="False" ToolTip.Tip="Confirmed 2026-08-15: this radio's vendor CPS has no Filters section at all - not a real D890UV feature, kept for other AnyTone models.">
                                        <CheckBox Content="Position" IsChecked="{Binding AprsSettings.FilterPosition}" />
                                        <CheckBox Content="Mic-E" IsChecked="{Binding AprsSettings.FilterMicE}" />
                                        <CheckBox Content="Object" IsChecked="{Binding AprsSettings.FilterObject}" />
                                        <CheckBox Content="Item" IsChecked="{Binding AprsSettings.FilterItem}" />
                                        <CheckBox Content="Message" IsChecked="{Binding AprsSettings.FilterMessage}" />
                                        <CheckBox Content="WX Report" IsChecked="{Binding AprsSettings.FilterWxReport}" />
                                        <CheckBox Content="NMEA Report" IsChecked="{Binding AprsSettings.FilterNmeaReport}" />
                                        <CheckBox Content="Status Report" IsChecked="{Binding AprsSettings.FilterStatusReport}" />
                                        <CheckBox Content="Other" IsChecked="{Binding AprsSettings.FilterOther}" />
                                    </StackPanel>

                                    <TextBlock Classes="SectionTitle" Text="Additional Fix Locations (2-8)" />
                                    <ListBox ItemsSource="{Binding AprsSettings.AdditionalFixLocations}"
                                             SelectedItem="{Binding SelectedFixLocation}"
                                             MaxHeight="260">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AprsFixLocationEntry">
                                                <Grid ColumnDefinitions="30,*" ColumnSpacing="8" Margin="4">
                                                    <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Lat}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <HeaderedContentControl Header="Latitude">
                                        <TextBox Text="{Binding SelectedFixLocation.LatText}" MaxLength="8" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="90" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="N/S">
                                        <ComboBox ItemsSource="{Binding AprsSettings.NsOptions}" SelectedItem="{Binding SelectedFixLocation.NsText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Longitude">
                                        <TextBox Text="{Binding SelectedFixLocation.LngText}" MaxLength="9" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.AllowDecimalPoint="True" views:DigitOnlyInput.MaxValue="180" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="E/W">
                                        <ComboBox ItemsSource="{Binding AprsSettings.EwOptions}" SelectedItem="{Binding SelectedFixLocation.EwText}" HorizontalAlignment="Stretch"
                                                  IsEnabled="{Binding SelectedFixLocation.CanEditEw}"
                                                  ToolTip.Tip="Confirmed 2026-08-15: the vendor CPS never writes E/W for Fix4-8, only Fix2/Fix3 - nothing to persist here for this slot." />
                                    </HeaderedContentControl>
                                    <!-- "Sate Fix PointName N" not yet modeled -
                                         see Fix 1's own comment above. -->

                                    <TextBlock Classes="SectionTitle" Text="Digital Report Channels (1-8)" />
                                    <ListBox ItemsSource="{Binding AprsSettings.DigitalReports}"
                                             SelectedItem="{Binding SelectedDigitalReport}"
                                             MaxHeight="260">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AprsDigitalReportEntry">
                                                <Grid ColumnDefinitions="30,*" ColumnSpacing="8" Margin="4">
                                                    <TextBlock Text="{Binding Number}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Channel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <HeaderedContentControl Header="Channel" ToolTip.Tip="Vendor CPS shows this as a dropdown with more options (Current Channel + all digital channels + VFO A/VFO B) - only VFO A/VFO B are confirmed so far, the rest of the option list and its byte encoding are still unconfirmed. A real channel number already stored here (from outside this app) still displays as a plain number below.">
                                        <ComboBox ItemsSource="{Binding SelectedDigitalReport.ChannelOptions}" SelectedItem="{Binding SelectedDigitalReport.ChannelText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="APRS TG">
                                        <TextBox Text="{Binding SelectedDigitalReport.TalkgroupIdText}"
                                                 MaxLength="8"
                                                 views:DigitOnlyInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Type">
                                        <ComboBox ItemsSource="{Binding SelectedDigitalReport.CallTypeOptions}" SelectedItem="{Binding SelectedDigitalReport.CallTypeText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Slot">
                                        <ComboBox ItemsSource="{Binding SelectedDigitalReport.SlotOptions}" SelectedItem="{Binding SelectedDigitalReport.SlotText}" HorizontalAlignment="Stretch" />
                                    </HeaderedContentControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel IsVisible="{Binding IsAprsFiltersViewSelected}">
                        <Border Background="{DynamicResource AppInfoBadgeBackgroundBrush}"
                                BorderBrush="{DynamicResource AppInfoBadgeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,0,8">
                            <TextBlock Text="Not yet writable to the radio - edits here are saved to the project file only." TextWrapping="Wrap" />
                        </Border>
                        <Border Classes="Panel">
                            <StackPanel Spacing="10">
                                <Grid x:Name="AprsReceiveFilterListHeader" ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="SectionTitle"
                                               TextWrapping="Wrap"
                                               Text="{Binding AprsReceiveFilterCount, StringFormat='APRS Filters ({0})'}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Command="{Binding AddAprsReceiveFilterCommand}" Content="+" />
                                        <Button Margin="8,0,0,0" Command="{Binding RemoveAprsReceiveFilterCommand}" Content="Del" />
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="AprsReceiveFilterList"
                                         MaxHeight="900"
                                         ItemsSource="{Binding AprsReceiveFilters}"
                                         SelectedItem="{Binding SelectedAprsReceiveFilter}"
                                         Tapped="AprsReceiveFilterList_OnTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:AprsReceiveFilterEntry">
                                            <Grid Margin="8,7" ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Callsign}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Number}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel x:Name="AprsReceiveFilterEditorPanel"
                                            IsVisible="False"
                                            Spacing="10">
                                    <HeaderedContentControl Header="No">
                                        <TextBox Text="{Binding SelectedAprsReceiveFilter.Number}" />
                                    </HeaderedContentControl>
                                    <CheckBox Content="Enabled" IsChecked="{Binding SelectedAprsReceiveFilter.Enabled}" />
                                    <HeaderedContentControl Header="Callsign">
                                        <TextBox Text="{Binding SelectedAprsReceiveFilter.Callsign}" views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="SSID">
                                        <TextBox Text="{Binding SelectedAprsReceiveFilter.Ssid}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- The 18 sections below replaced the old flat "Optional Settings"
                         page (2026-07-28) - moved under IsRadioViewSelected/
                         SelectedOptionalSettingsSubTabIndex to match Desktop's actual
                         structure (these ARE tabs inside Desktop's "Radio" TabControl,
                         not a separate top-level view - see SelectedOptionalSettingsSubTabIndex's
                         doc comment). Field content is unchanged from the old flat page
                         (same bindings, just regrouped into independently-navigable
                         sections instead of one long scroll); write-status banners now
                         accurately reflect each section's real state instead of one
                         blanket "not writable" that had gone stale for the 11 sections
                         write support was added to since this page was first written. -->
                    <StackPanel IsVisible="{Binding IsRadioViewSelected}" Spacing="12">
                        <StackPanel IsVisible="{Binding IsOptionalSettingsPowerOnSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Power-on" />
                                    <HeaderedContentControl Header="Power-on Interface">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.PowerOnInterfaceOptions}"
                                                  SelectedItem="{Binding OptionalSettings.PowerOnInterfaceText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Power-on Display (line 1)">
                                        <TextBox Text="{Binding OptionalSettings.PowerOnDisplayLine1}" MaxLength="14" views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Power-on Display (line 2)">
                                        <TextBox Text="{Binding OptionalSettings.PowerOnDisplayLine2}" MaxLength="14" views:AsciiTextInput.Enabled="True" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Power-on Password">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.PowerOnPasswordText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Power-on Password Char">
                                        <TextBox Name="PowerOnPasswordCharBox"
                                                 Classes="PinDigits"
                                                 Text="{Binding OptionalSettings.PowerOnPasswordChar}"
                                                 MaxLength="8" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Default Startup Channel">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.DefaultStartupChannelText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Startup Zone A">
                                        <ComboBox ItemsSource="{Binding OptionalSettingsZoneOptions}"
                                                  SelectedItem="{Binding OptionalSettingsStartupZoneAName}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Startup Channel A">
                                        <ComboBox ItemsSource="{Binding OptionalSettingsStartupChannelAOptions}"
                                                  SelectedItem="{Binding OptionalSettingsStartupChannelAName}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Startup Zone B">
                                        <ComboBox ItemsSource="{Binding OptionalSettingsZoneOptions}"
                                                  SelectedItem="{Binding OptionalSettingsStartupZoneBName}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Startup Channel B">
                                        <ComboBox ItemsSource="{Binding OptionalSettingsStartupChannelBOptions}"
                                                  SelectedItem="{Binding OptionalSettingsStartupChannelBName}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Startup GPS Test"
                                                             ToolTip.Tip="Not stored anywhere this app can currently read or write - confirmed 2026-07-20 via live differential tests. Disabled until that's found.">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.StartupGpsTestText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}"
                                                      IsEnabled="False" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Startup Reset" ToolTip.Tip="Set ON to allow MCU reboot">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.StartupResetText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsAlertToneSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Alert Tone" />
                                    <HeaderedContentControl Header="SMS Alert">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.NoneRingOptions}" SelectedItem="{Binding OptionalSettings.SmsAlertText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Alert">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.NoneRingOptions}" SelectedItem="{Binding OptionalSettings.CallAlertText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Digi Call Reset Tone">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.DigiCallResetToneText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Talk Permit">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.TalkPermitOptions}" SelectedItem="{Binding OptionalSettings.TalkPermitText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Key Tone">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.KeyToneText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Digi Idle Channel Tone">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.DigiIdleChannelToneOptions}" SelectedItem="{Binding OptionalSettings.DigiIdleChannelToneText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Startup Sound">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.StartupSoundText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Ana Idle Channel Tone">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.AnalogIdleChannelToneText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="6">
                                    <TextBlock Classes="SectionTitle" Text="Call Permit Tone" />
                                    <Grid ColumnDefinitions="70,*,*" ColumnSpacing="6">
                                        <TextBlock Grid.Column="1" Classes="Label" Text="Frequency[Hz]" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="Label" Text="Period[10ms]" HorizontalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding OptionalSettings.CallPermitTones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AlertToneEntry">
                                                <Grid ColumnDefinitions="70,*,*" ColumnSpacing="6" Margin="0,2">
                                                    <TextBlock Text="{Binding ToneNumber}" VerticalAlignment="Center" />
                                                    <DataValidationErrors Grid.Column="1">
                                                        <TextBox Text="{Binding FrequencyText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Freq[Hz]" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.MaxValue="3000" Classes="PinDigits" />
                                                    </DataValidationErrors>
                                                    <DataValidationErrors Grid.Column="2">
                                                        <TextBox Text="{Binding PeriodText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Period[10ms]" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.MaxValue="200" Classes="PinDigits" />
                                                    </DataValidationErrors>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="6">
                                    <TextBlock Classes="SectionTitle" Text="Match End Tone" />
                                    <Grid ColumnDefinitions="70,*,*" ColumnSpacing="6">
                                        <TextBlock Grid.Column="1" Classes="Label" Text="Frequency[Hz]" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="Label" Text="Period[10ms]" HorizontalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding OptionalSettings.MatchEndTones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AlertToneEntry">
                                                <Grid ColumnDefinitions="70,*,*" ColumnSpacing="6" Margin="0,2">
                                                    <TextBlock Text="{Binding ToneNumber}" VerticalAlignment="Center" />
                                                    <DataValidationErrors Grid.Column="1">
                                                        <TextBox Text="{Binding FrequencyText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Freq[Hz]" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.MaxValue="3000" Classes="PinDigits" />
                                                    </DataValidationErrors>
                                                    <DataValidationErrors Grid.Column="2">
                                                        <TextBox Text="{Binding PeriodText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Period[10ms]" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.MaxValue="200" Classes="PinDigits" />
                                                    </DataValidationErrors>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="6">
                                    <TextBlock Classes="SectionTitle" Text="Call Reset Tone" />
                                    <Grid ColumnDefinitions="70,*,*" ColumnSpacing="6">
                                        <TextBlock Grid.Column="1" Classes="Label" Text="Frequency[Hz]" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="Label" Text="Period[10ms]" HorizontalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding OptionalSettings.CallResetTones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AlertToneEntry">
                                                <Grid ColumnDefinitions="70,*,*" ColumnSpacing="6" Margin="0,2">
                                                    <TextBlock Text="{Binding ToneNumber}" VerticalAlignment="Center" />
                                                    <DataValidationErrors Grid.Column="1">
                                                        <TextBox Text="{Binding FrequencyText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Freq[Hz]" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.MaxValue="3000" Classes="PinDigits" />
                                                    </DataValidationErrors>
                                                    <DataValidationErrors Grid.Column="2">
                                                        <TextBox Text="{Binding PeriodText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Period[10ms]" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.MaxValue="200" Classes="PinDigits" />
                                                    </DataValidationErrors>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="6">
                                    <TextBlock Classes="SectionTitle" Text="UnMatch End Tone" />
                                    <Grid ColumnDefinitions="70,*,*" ColumnSpacing="6">
                                        <TextBlock Grid.Column="1" Classes="Label" Text="Frequency[Hz]" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="Label" Text="Period[10ms]" HorizontalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding OptionalSettings.UnMatchEndTones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AlertToneEntry">
                                                <Grid ColumnDefinitions="70,*,*" ColumnSpacing="6" Margin="0,2">
                                                    <TextBlock Text="{Binding ToneNumber}" VerticalAlignment="Center" />
                                                    <DataValidationErrors Grid.Column="1">
                                                        <TextBox Text="{Binding FrequencyText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Freq[Hz]" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.MaxValue="3000" Classes="PinDigits" />
                                                    </DataValidationErrors>
                                                    <DataValidationErrors Grid.Column="2">
                                                        <TextBox Text="{Binding PeriodText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Period[10ms]" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.MaxValue="200" Classes="PinDigits" />
                                                    </DataValidationErrors>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="6">
                                    <TextBlock Classes="SectionTitle" Text="All Call End Tone" />
                                    <Grid ColumnDefinitions="70,*,*" ColumnSpacing="6">
                                        <TextBlock Grid.Column="1" Classes="Label" Text="Frequency[Hz]" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="Label" Text="Period[10ms]" HorizontalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding OptionalSettings.CallAllTones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:AlertToneEntry">
                                                <Grid ColumnDefinitions="70,*,*" ColumnSpacing="6" Margin="0,2">
                                                    <TextBlock Text="{Binding ToneNumber}" VerticalAlignment="Center" />
                                                    <DataValidationErrors Grid.Column="1">
                                                        <TextBox Text="{Binding FrequencyText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Freq[Hz]" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.MaxValue="3000" Classes="PinDigits" />
                                                    </DataValidationErrors>
                                                    <DataValidationErrors Grid.Column="2">
                                                        <TextBox Text="{Binding PeriodText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Period[10ms]" views:DigitOnlyInput.Enabled="True" views:DigitOnlyInput.MaxValue="200" Classes="PinDigits" />
                                                    </DataValidationErrors>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsPowerSaveSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Power Save" />
                                    <HeaderedContentControl Header="Auto Shutdown (minutes)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.AutoShutdownOptions}" SelectedItem="{Binding OptionalSettings.AutoShutdownText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Power Save">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.PowerSaveOptions}" SelectedItem="{Binding OptionalSettings.PowerSaveText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Auto Shutdown Type">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.AutoShutdownTypeOptions}" SelectedItem="{Binding OptionalSettings.AutoShutdownTypeText}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsDisplaySubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Display" />
                                    <HeaderedContentControl Header="Brightness">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.BrightnessOptions}" SelectedItem="{Binding OptionalSettings.BrightnessText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Auto Backlight Duration">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.AutoBacklightDurationOptions}" SelectedItem="{Binding OptionalSettings.AutoBacklightDurationText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Backlight Delay Of TX[s]">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.BacklightTxDelayOptions}" SelectedItem="{Binding OptionalSettings.BacklightTxDelayText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Receive Backlight Delay[s]">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.BacklightRxDelayOptions}" SelectedItem="{Binding OptionalSettings.BacklightRxDelayText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Menu Exit Time[s]">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.MenuExitTimeOptions}" SelectedItem="{Binding OptionalSettings.MenuExitTimeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Time Display">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.TimeDisplayOptions}"
                                                  SelectedItem="{Binding OptionalSettings.TimeDisplayText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Last Caller">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.LastCallerOptions}" SelectedItem="{Binding OptionalSettings.LastCallerText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Display Mode">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.CallDisplayModeOptions}" SelectedItem="{Binding OptionalSettings.CallDisplayModeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Sign Display Color">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.Color1Options}" SelectedItem="{Binding OptionalSettings.CallsignDisplayColorText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call End Prompt Box">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.CallEndPromptBoxText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Display Channel Number">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.DisplayChannelNumberOptions}" SelectedItem="{Binding OptionalSettings.DisplayChannelNumberText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Display Current Contact">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.DisplayCurrentContactText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Standby Char Color">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.Color2Options}" SelectedItem="{Binding OptionalSettings.StandbyCharColorText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Standby BK Picture">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.DisplayStandbyPictureOptions}" SelectedItem="{Binding OptionalSettings.StandbyBkPictureText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Show Last Call On Launch">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.ShowLastCallOnLaunchText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Separate Display">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.SeparateDisplayText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="CH Switching Keeps Last Caller">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.ChSwitchingKeepsCallerText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="A Channel Name Color">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.Color1Options}" SelectedItem="{Binding OptionalSettings.ChannelNameColorAText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="B Channel Name Color">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.Color1Options}" SelectedItem="{Binding OptionalSettings.ChannelNameColorBText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Zone Name Color A">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.Color1Options}" SelectedItem="{Binding OptionalSettings.ZoneNameColorAText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Zone Name Color B">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.Color1Options}" SelectedItem="{Binding OptionalSettings.ZoneNameColorBText}" />
                                    </HeaderedContentControl>
                                    <CheckBox Content="Display Channel Type" IsChecked="{Binding OptionalSettings.DisplayChannelType}" />
                                    <CheckBox Content="Display Time Slot" IsChecked="{Binding OptionalSettings.DisplayTimeSlot}" />
                                    <CheckBox Content="Display Color Code" IsChecked="{Binding OptionalSettings.DisplayColorCode}" />
                                    <HeaderedContentControl Header="Date Display Format">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.DateDisplayFormatOptions}" SelectedItem="{Binding OptionalSettings.DateDisplayFormatText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Volume Bar">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.VolumeBarText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Night Mode">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.NightModeText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsWorkModeSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Work Mode" />
                                    <HeaderedContentControl Header="Display Mode">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.DisplayModeOptions}" SelectedItem="{Binding OptionalSettings.DisplayModeText}" />
                                    </HeaderedContentControl>
                                    <StackPanel IsEnabled="{Binding OptionalSettings.IsVfMrEditable}"
                                                ToolTip.Tip="Matches the real vendor CPS: VF/MR A/B can only be changed while Display Mode is Channel.">
                                        <HeaderedContentControl Header="VF/MR A">
                                            <ComboBox ItemsSource="{Binding OptionalSettings.VfoMemModeOptions}" SelectedItem="{Binding OptionalSettings.VfMrAText}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <HeaderedContentControl Header="MEM Zone A">
                                        <ComboBox ItemsSource="{Binding OptionalSettingsZoneOptions}" SelectedItem="{Binding OptionalSettingsMemZoneAName}" />
                                    </HeaderedContentControl>
                                    <StackPanel IsEnabled="{Binding OptionalSettings.IsVfMrEditable}"
                                                ToolTip.Tip="Matches the real vendor CPS: VF/MR A/B can only be changed while Display Mode is Channel.">
                                        <HeaderedContentControl Header="VF/MR B">
                                            <ComboBox ItemsSource="{Binding OptionalSettings.VfoMemModeOptions}" SelectedItem="{Binding OptionalSettings.VfMrBText}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <HeaderedContentControl Header="MEM Zone B">
                                        <ComboBox ItemsSource="{Binding OptionalSettingsZoneOptions}" SelectedItem="{Binding OptionalSettingsMemZoneBName}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Main Channel Set">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.MainChannelSetOptions}" SelectedItem="{Binding OptionalSettings.MainChannelSetText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Sub-Channel Mode">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.SubChannelModeText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Working Mode">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.WorkingModeOptions}" SelectedItem="{Binding OptionalSettings.WorkingModeText}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsVoxBtSubTabSelected}" Spacing="10">
                            <!-- Safety warning, added 2026-07-30 - see
                                 OptionalSettingsEntry.IsVoxOn's doc comment for the hazard.
                                 Persistent (unlike the startup popup, this doesn't
                                 auto-dismiss) - stays visible for as long as VOX is
                                 actually on. -->
                            <Border IsVisible="{Binding OptionalSettings.IsVoxOn}"
                                    Background="{DynamicResource AppInfoBadgeBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppErrorBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="12,10">
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppInfoBadgeTextBrush}"
                                           Text="VOX is on - the radio can start transmitting on its own while connected to this device for programming, which can damage the device. Turn VOX off before connecting the radio." />
                            </Border>
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="VOX" />
                                    <HeaderedContentControl Header="Vox On/Off">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.VoxLevelOptions}" SelectedItem="{Binding OptionalSettings.VoxLevelText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="VOX Delay (s)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.VoxDelayOptions}" SelectedItem="{Binding OptionalSettings.VoxDelayText}" />
                                    </HeaderedContentControl>
                                    <StackPanel IsEnabled="{Binding OptionalSettings.IsVoxDetectionEditable}"
                                                ToolTip.Tip="Matches the real vendor CPS: Vox Detection can only be changed while Vox On/Off is Off.">
                                        <HeaderedContentControl Header="VOX Detection">
                                            <ComboBox ItemsSource="{Binding OptionalSettings.VoxDetectionOptions}" SelectedItem="{Binding OptionalSettings.VoxDetectionText}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <TextBlock Classes="Label"
                                               TextWrapping="Wrap"
                                               FontSize="11"
                                               Text="No Bluetooth UI exists in the vendor CPS for this radio (confirmed 2026-07-25) - the real 'Vox/BT' screen only has these 3 VOX fields." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsSteSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="STE" />
                                    <HeaderedContentControl Header="STE CTCSS Type">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.SteCtcssTypeOptions}" SelectedItem="{Binding OptionalSettings.SteTypeOfCtcssText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="STE No Signal (Hz)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.SteNoSignalOptions}" SelectedItem="{Binding OptionalSettings.SteWhenNoSignalText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="STE Time (ms)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.SteTimeOptions}" SelectedItem="{Binding OptionalSettings.SteTimeText}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsAmFmSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="AM / FM" />
                                    <HeaderedContentControl Header="AM/FM Function">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.AmFmFunctionOptions}" SelectedItem="{Binding OptionalSettings.AmFmFunctionText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Frequency Step (kHz)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.FrequencyStepOptions}" SelectedItem="{Binding OptionalSettings.FrequencyStepText}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                            <Border Classes="Panel"
                                    IsEnabled="{Binding OptionalSettings.IsFmSectionEnabled}"
                                    ToolTip.Tip="Matches the real vendor CPS: only editable while AM/FM Function is FM.">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="FM" />
                                    <HeaderedContentControl Header="FM VFO/MEM">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.VfoMemModeOptions}" SelectedItem="{Binding OptionalSettings.FmVfoMemText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="FM Work Channel" ToolTip.Tip="Confirmed 2026-07-29 via a live differential write - the raw byte is a zero-based index into this list.">
                                        <ComboBox ItemsSource="{Binding OptionalSettingsFmChannelOptions}" SelectedItem="{Binding OptionalSettingsFmWorkChannelName}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="FM Monitor">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.FmMonitorText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                            <Border Classes="Panel"
                                    IsEnabled="{Binding OptionalSettings.IsAmSectionEnabled}"
                                    ToolTip.Tip="Matches the real vendor CPS: only editable while AM/FM Function is AM(A) or AM(B).">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="AM" />
                                    <HeaderedContentControl Header="AM VFO/MEM">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.VfoMemModeOptions}" SelectedItem="{Binding OptionalSettings.AmVfoMemText}" />
                                    </HeaderedContentControl>
                                    <StackPanel IsEnabled="False"
                                                Spacing="8"
                                                ToolTip.Tip="Confirmed 2026-07-29 via a live differential write: this doesn't persist as an independent D890UV setting - selecting a work zone in the vendor CPS only changes AM Offset's own byte. Kept here disabled rather than removed, since the control exists in the vendor CPS and may be real on other AnyTone models.">
                                        <HeaderedContentControl Header="AM Work Zone">
                                            <ComboBox ItemsSource="{Binding OptionalSettingsAmZoneOptions}" SelectedItem="{Binding OptionalSettingsAmWorkZoneName}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <HeaderedContentControl Header="AM Offset">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.AmOffsetOptions}" SelectedItem="{Binding OptionalSettings.AmOffsetText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="AM SQL Level">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.OffNumber5Options}" SelectedItem="{Binding OptionalSettings.AmSqlLevelText}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsKeyFunctionSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Key Function" />
                                    <HeaderedContentControl Header="Key Lock">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.KeyLockOptions}" SelectedItem="{Binding OptionalSettings.KeyLockText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="PF1 Short Key">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.KeyFunctionOptions}" SelectedItem="{Binding OptionalSettings.Pf1ShortKeyText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="PF2 Short Key">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.KeyFunctionOptions}" SelectedItem="{Binding OptionalSettings.Pf2ShortKeyText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="PF3 Short Key">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.KeyFunctionOptions}" SelectedItem="{Binding OptionalSettings.Pf3ShortKeyText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="P1 Short Key">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.KeyFunctionOptions}" SelectedItem="{Binding OptionalSettings.P1ShortKeyText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="P2 Short Key">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.KeyFunctionOptions}" SelectedItem="{Binding OptionalSettings.P2ShortKeyText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="PF1 Long Key">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.KeyFunctionOptions}" SelectedItem="{Binding OptionalSettings.Pf1LongKeyText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="PF2 Long Key">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.KeyFunctionOptions}" SelectedItem="{Binding OptionalSettings.Pf2LongKeyText}" />
                                    </HeaderedContentControl>
                                    <StackPanel IsEnabled="False"
                                                Spacing="8"
                                                ToolTip.Tip="Matches the real vendor CPS: PF3 Long Key is fixed at Off, not user-changeable.">
                                        <HeaderedContentControl Header="PF3 Long Key">
                                            <ComboBox ItemsSource="{Binding OptionalSettings.KeyFunctionOptions}" SelectedItem="{Binding OptionalSettings.Pf3LongKeyText}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <HeaderedContentControl Header="P1 Long Key">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.KeyFunctionOptions}" SelectedItem="{Binding OptionalSettings.P1LongKeyText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="P2 Long Key">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.KeyFunctionOptions}" SelectedItem="{Binding OptionalSettings.P2LongKeyText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Long Key Time (s)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.LongKeyTimeOptions}" SelectedItem="{Binding OptionalSettings.LongKeyTimeText}" />
                                    </HeaderedContentControl>
                                    <CheckBox Content="Knob Lock" IsChecked="{Binding OptionalSettings.KnobLock}" />
                                    <CheckBox Content="Keyboard Lock" IsChecked="{Binding OptionalSettings.KeyboardLock}" />
                                    <CheckBox Content="Side Key Lock" IsChecked="{Binding OptionalSettings.SideKeyLock}" />
                                    <CheckBox Content="Forced Key Lock" IsChecked="{Binding OptionalSettings.ForcedKeyLock}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsOtherSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Other" />
                                    <HeaderedContentControl Header="Address Book Is Sent With Its Own Code">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.AddressBookSentWithCodeText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TOT (seconds)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.TotOptions}" SelectedItem="{Binding OptionalSettings.TotText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Language">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.LanguageOptions}" SelectedItem="{Binding OptionalSettings.LanguageText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Frequency Step (kHz)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.FrequencyStepOptions}" SelectedItem="{Binding OptionalSettings.GeneralFrequencyStepText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="SQL Level A">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.SqlLevelOptions}" SelectedItem="{Binding OptionalSettings.SqlLevelAText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="SQL Level B">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.SqlLevelOptions}" SelectedItem="{Binding OptionalSettings.SqlLevelBText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TBST (Hz)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.TbstOptions}" SelectedItem="{Binding OptionalSettings.TbstText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Analog Call Hold Time (seconds)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.AnalogCallHoldTimeOptions}" SelectedItem="{Binding OptionalSettings.AnalogCallHoldTimeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Call Channel Is Maintained">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.CallChannelMaintainedText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Priority Zone A">
                                        <ComboBox ItemsSource="{Binding OptionalSettingsZoneOptions}" SelectedItem="{Binding OptionalSettingsPriorityZoneAName}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Priority Zone B">
                                        <ComboBox ItemsSource="{Binding OptionalSettingsZoneOptions}" SelectedItem="{Binding OptionalSettingsPriorityZoneBName}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Mute Timing (minutes)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.MuteTimingOptions}" SelectedItem="{Binding OptionalSettings.MuteTimingText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Encryption Type">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.EncryptionTypeOptions}" SelectedItem="{Binding OptionalSettings.EncryptionTypeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TOT Predict">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.TotPredictText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TxPow AGC">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.TxPowerAgcText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="NOAA Moni">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.NoaaMoniText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="NOAA Scan">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.NoaaScanText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="NOAA Alert">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.NoaaText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="NOAA Channel">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.NoaaChannelCountOptions}" SelectedItem="{Binding OptionalSettings.NoaaChannelText}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsDigitalFuncSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="Digital Func" />
                                    <HeaderedContentControl Header="Group Call Hold Time (s)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.TgHoldTimeOptions}" SelectedItem="{Binding OptionalSettings.GroupCallHoldTimeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Private Call Hold Time (s)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.TgHoldTimeOptions}" SelectedItem="{Binding OptionalSettings.PrivateCallHoldTimeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Manual Dial - Group TG Hold Time (s)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.TgHoldTimeOptions}" SelectedItem="{Binding OptionalSettings.ManualDialGroupCallHoldTimeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Manual Dial - Private TG Hold Time (s)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.TgHoldTimeOptions}" SelectedItem="{Binding OptionalSettings.ManualDialPrivateCallHoldTimeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Voice Header Repetitions">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.VoiceHeaderRepetitionsOptions}" SelectedItem="{Binding OptionalSettings.VoiceHeaderRepetitionsText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="TX Preamble Duration (ms)">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.TxPreambleDurationOptions}" SelectedItem="{Binding OptionalSettings.TxPreambleDurationText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Filter Own ID In Miss Call">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.FilterOwnIdText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Digital Remote Kill">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.DigitalRemoteKillText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Digital Monitor">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.DigitalMonitorOptions}" SelectedItem="{Binding OptionalSettings.DigitalMonitorText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Digital Monitor CC">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.DigitalMonitorCcOptions}" SelectedItem="{Binding OptionalSettings.DigitalMonitorCcText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Digital Monitor ID">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.DigitalMonitorCcOptions}" SelectedItem="{Binding OptionalSettings.DigitalMonitorIdText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Monitor Hold Slot">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.MonitorSlotHoldText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Remote Monitor">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.RemoteMonitorText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="SMS Format">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.SmsFormatOptions}" SelectedItem="{Binding OptionalSettings.SmsFormatText}" />
                                    </HeaderedContentControl>
                                    <StackPanel IsEnabled="False"
                                                ToolTip.Tip="Matches the real vendor CPS: locked to its single option. A 2nd option (NXDN) may appear with a future vendor CPS/firmware update.">
                                        <HeaderedContentControl Header="Digital Protocol">
                                            <ComboBox ItemsSource="{Binding OptionalSettings.DigitalProtocolOptions}" SelectedItem="DMR" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <HeaderedContentControl Header="Reset Digital Protocol">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.ResetDigitalProtocolOptions}" SelectedItem="{Binding OptionalSettings.ResetDigitalProtocolText}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsGpsRangingSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="GPS / Ranging" />
                                    <StackPanel IsEnabled="False" ToolTip.Tip="Not present in the vendor CPS for this radio model - kept disabled in case a future radio supports it.">
                                        <HeaderedContentControl Header="GPS">
                                            <ToggleSwitch IsChecked="{Binding OptionalSettings.GpsPowerText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <HeaderedContentControl Header="GPS Positioning">
                                        <ToggleSwitch IsChecked="{Binding OptionalSettings.GpsPositioningText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Time Zone">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.TimeZoneOptions}" SelectedItem="{Binding OptionalSettings.TimeZoneText}" />
                                    </HeaderedContentControl>
                                    <StackPanel IsEnabled="False" ToolTip.Tip="Not present in the vendor CPS for this radio model - kept disabled in case a future radio supports it.">
                                        <HeaderedContentControl Header="Ranging Interval[s]">
                                            <ComboBox ItemsSource="{Binding OptionalSettings.RangingIntervalOptions}" SelectedItem="{Binding OptionalSettings.RangingIntervalText}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <StackPanel IsEnabled="False" ToolTip.Tip="Not present in the vendor CPS for this radio model - kept disabled in case a future radio supports it.">
                                        <HeaderedContentControl Header="Distance Unit">
                                            <ComboBox ItemsSource="{Binding OptionalSettings.DistanceUnitOptions}" SelectedItem="{Binding OptionalSettings.DistanceUnitText}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <StackPanel IsEnabled="False" ToolTip.Tip="Not present in the vendor CPS for this radio model - kept disabled in case a future radio supports it.">
                                        <HeaderedContentControl Header="GPS Information Template">
                                            <ToggleSwitch IsChecked="{Binding OptionalSettings.GpsTemplateInformationText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <StackPanel IsEnabled="False" ToolTip.Tip="Not present in the vendor CPS for this radio model - kept disabled in case a future radio supports it.">
                                        <HeaderedContentControl Header="GPS Information Text">
                                            <TextBox Text="{Binding OptionalSettings.GpsInformationChar}" views:AsciiTextInput.Enabled="True" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <HeaderedContentControl Header="GPS Mode">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.GpsModeOptions}" SelectedItem="{Binding OptionalSettings.GpsModeText}" />
                                    </HeaderedContentControl>
                                    <StackPanel ToolTip.Tip="Stays disabled in the vendor CPS even with GPS Positioning On - appears gated by a setting on the Auto Roaming tab. Not yet written to the radio.">
                                        <HeaderedContentControl Header="GPS Roaming">
                                            <ToggleSwitch IsChecked="{Binding OptionalSettings.GpsRoamingText, Converter={x:Static converters:OnOffToBoolConverter.Instance}}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsVfoScanSubTabSelected}" Spacing="10">
                            <Border Classes="Panel">
                                <StackPanel Margin="8" Spacing="8">
                                    <TextBlock Classes="SectionTitle" Text="VFO Scan" />
                                    <HeaderedContentControl Header="VFO Scan Type">
                                        <ComboBox ItemsSource="{Binding OptionalSettings.VfoScanTypeOptions}" SelectedItem="{Binding OptionalSettings.VfoScanTypeText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="VFO Scan Start Freq (UHF) [MHz]" ToolTip.Tip="400.00000-480.00000, matching the real radio's UHF band limits.">
                                        <DataValidationErrors>
                                            <TextBox Text="{Binding OptionalSettings.VfoScanStartFreqUhfText, UpdateSourceTrigger=PropertyChanged}"
                                                 Classes="PinDigits"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 views:DigitOnlyInput.MaxValue="480" />
                                        </DataValidationErrors>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="VFO Scan End Freq (UHF) [MHz]" ToolTip.Tip="400.00000-480.00000, matching the real radio's UHF band limits.">
                                        <DataValidationErrors>
                                            <TextBox Text="{Binding OptionalSettings.VfoScanEndFreqUhfText, UpdateSourceTrigger=PropertyChanged}"
                                                 Classes="PinDigits"
                                                 views:DigitOnlyInput.Enabled="True"
                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 views:DigitOnlyInput.MaxValue="480" />
                                        </DataValidationErrors>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="VFO Scan Start Freq (VHF) [MHz]" ToolTip.Tip="136.00000-174.00000, matching the real radio's VHF band limits.">
