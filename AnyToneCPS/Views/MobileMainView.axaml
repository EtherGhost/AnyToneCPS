                                                 views:DigitOnlyInput.AllowDecimalPoint="True"
                                                 views:DigitOnlyInput.MaxValue="174" />
                                        </DataValidationErrors>
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel IsVisible="{Binding IsOptionalSettingsAutoRepeaterSubTabSelected}" Spacing="10">
