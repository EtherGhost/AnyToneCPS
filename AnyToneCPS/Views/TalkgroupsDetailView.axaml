<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AnyToneCPS.ViewModels"
             xmlns:views="using:AnyToneCPS.Views"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="AnyToneCPS.Views.TalkgroupsDetailView"
             x:DataType="vm:MainViewModel">
    <!-- Split out of MainView.axaml 2026-08-10 - see ChannelDetailView's own
         doc comment. Sidebar's own compact Talkgroups list stays in
         MainView.axaml, IsTalkgroupsViewSelected list section. -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Border Classes="Panel">
            <StackPanel Spacing="12">
                <TextBlock Classes="SectionTitle" Text="Talkgroup details" />
                <HeaderedContentControl Header="Number">
                    <TextBox Text="{Binding SelectedTalkgroup.Number}"
                             views:DigitOnlyInput.Enabled="True"
                             views:DigitOnlyInput.MaxValue="10000" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="TG/DMR ID">
                    <TextBox Text="{Binding SelectedTalkgroup.DmrIdText}"
                             MaxLength="8"
                             views:DigitOnlyInput.Enabled="True"
                             IsEnabled="{Binding SelectedTalkgroup.IsAllCallFieldsEditable}" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Name">
                    <TextBox Text="{Binding SelectedTalkgroup.Name}"
                             MaxLength="16"
                             views:AsciiTextInput.Enabled="True" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Call Type">
                    <ComboBox ItemsSource="{Binding ContactCallTypes}"
                              SelectedItem="{Binding SelectedTalkgroup.CallType}" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Call Alert">
                    <ComboBox ItemsSource="{Binding SelectedTalkgroup.CallAlertOptions}"
                              SelectedItem="{Binding SelectedTalkgroup.CallAlert}"
                              IsEnabled="{Binding SelectedTalkgroup.IsAllCallFieldsEditable}" />
                </HeaderedContentControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
