<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AnyToneCPS.ViewModels"
             xmlns:views="using:AnyToneCPS.Views"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="820"
             x:Class="AnyToneCPS.Views.RadioIdListDetailView"
             x:DataType="vm:MainViewModel">
    <!-- Split out of MainView.axaml 2026-08-10 - see ChannelDetailView's own
         doc comment. Sidebar's own compact Radio ID list stays in
         MainView.axaml, IsRadioIdListViewSelected list section. -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Border Classes="Panel">
            <StackPanel Spacing="12">
                <TextBlock Classes="SectionTitle" Text="Radio ID details" />
                <HeaderedContentControl Header="Number">
                    <TextBox Text="{Binding SelectedRadioId.Number}" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Radio ID">
                    <TextBox Text="{Binding SelectedRadioId.DmrIdText}"
                             MaxLength="8"
                             views:DigitOnlyInput.Enabled="True" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Name">
                    <TextBox Text="{Binding SelectedRadioId.Name}"
                             MaxLength="17"
                             views:AsciiTextInput.Enabled="True" />
                </HeaderedContentControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
